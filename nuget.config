<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Locally built package versions not (yet) on nuget.org, e.g. the RustPlusApi fork. -->
    <add key="packages-local" value="vendor/nuget" />
  </packageSources>
</configuration>
