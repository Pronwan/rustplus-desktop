<Project>
  <!--
    Repo-wide build settings. Applies to every project in the tree (app, tests, MapParser).
    Goal: fast local iteration without changing Release output.
  -->
  <PropertyGroup>
    <!-- Keep the Roslyn compiler server warm and let VS skip redundant work. -->
    <UseSharedCompilation>true</UseSharedCompilation>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!-- Reference assemblies: dependent projects (e.g. the test project) don't rebuild when only
         a method body changes in a referenced project. -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <!--
    Debug-only: skip work that only matters for shipped output. Release (what CI builds and
    publishes) is untouched. A WPF project compiles twice per build (the _wpftmp markup pass,
    then the real compile), so every second shaved off Csc is paid for twice.
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release' And '$(ContinuousIntegrationBuild)' != 'true'">
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
