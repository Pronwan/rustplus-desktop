<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:models="clr-namespace:RustPlusDesk.Core.Servers;assembly=RustPlusDesk.Core"
             xmlns:shared="using:RustPlusDesk.Avalonia.Shared.Controls"
             xmlns:connections="using:RustPlusDesk.Avalonia.Features.Connections"
             x:Class="RustPlusDesk.Avalonia.Features.Servers.ServersView"
             x:DataType="vm:ServersViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="SERVERS" FontSize="12" FontWeight="SemiBold" Classes="muted" />
      </StackPanel>
      <WrapPanel Grid.Row="1">
        <Button Content="_Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,4" />
        <Button Content="_Open profiles…" Command="{Binding OpenFileCommand}" Margin="0,0,6,4" />
        <Button Content="_Edit…" Command="{Binding EditCommand}" Margin="0,0,0,4" />
      </WrapPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding SourcePath}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="10" ToolTip.Tip="{Binding SourcePath}"
               AutomationProperties.Name="Profiles file location" />
    <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                 AutomationProperties.Name="Loading saved servers" />
    <Grid Grid.Row="4">
      <StackPanel Spacing="8">
        <TextBlock Text="CONNECTION SERVICES" Classes="muted" FontSize="11" FontWeight="SemiBold" />
        <Border IsVisible="{Binding HasServers}">
          <connections:ConnectionStatusView DataContext="{Binding Connection}" />
        </Border>
        <WrapPanel IsVisible="{Binding HasListener}">
          <Button Content="Start _listening" Command="{Binding Listener.StartCommand}" Margin="0,0,6,4" />
          <Button Content="_Stop listening" Command="{Binding Listener.StopCommand}" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
    </Grid>
    <shared:StatusPanel Grid.Row="3" Classes="compact" Title="{Binding StatusTitle}" Message="{Binding StatusMessage}"
                        IsVisible="{Binding ShowStatus}" VerticalAlignment="Center" />
    <ComboBox Grid.Row="3" x:Name="SavedServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" IsVisible="{Binding HasServers}"
              AutomationProperties.Name="Saved servers" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="models:ServerSummary">
          <StackPanel Spacing="3" ToolTip.Tip="{Binding Host}">
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Port, StringFormat='Port {0}'}" FontSize="11" Classes="muted" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>
