<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             x:Class="RustPlusDesk.Avalonia.Features.Servers.ServerEditorView" x:DataType="vm:ServerEditorViewModel">
  <UserControl.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" /></UserControl.KeyBindings>
  <Border Classes="card" Padding="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="12" KeyboardNavigation.TabNavigation="Cycle">
      <TextBlock Text="Edit Server Connection" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Update the server address or companion port. Existing devices and settings are preserved." TextWrapping="Wrap" Classes="muted" />
      <StackPanel Spacing="4">
        <TextBlock Text="Server name" />
        <TextBox x:Name="ServerName" Text="{Binding Name}" AutomationProperties.Name="Server name" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,100" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Host / IP address" />
          <TextBox Text="{Binding Host}" AutomationProperties.Name="Host or IP address" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Port" />
          <TextBox Text="{Binding Port}" AutomationProperties.Name="Companion port" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </Grid>
      <Button Content="_Test address &amp; devices" Command="{Binding TestCommand}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" AutomationProperties.Name="Working on server profile" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="_Cancel" Command="{Binding CancelCommand}" />
        <Button Content="_Save changes" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
