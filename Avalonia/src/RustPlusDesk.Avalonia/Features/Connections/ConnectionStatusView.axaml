<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Connections"
             x:Class="RustPlusDesk.Avalonia.Features.Connections.ConnectionStatusView" x:DataType="vm:ConnectionViewModel">
  <Border Classes="card" Background="{DynamicResource SurfaceAlt}" CornerRadius="10" Padding="10,7">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Ellipse Width="10" Height="10" Classes="connection-dot" Classes.connected="{Binding IsConnected}"
                   Classes.pending="{Binding IsPending}" Classes.repair="{Binding RequiresRePair}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding ServerName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="_Connect" Classes="accent" Padding="10,4" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsActive}" />
          <Button Content="_Disconnect" Padding="10,4" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsActive}" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding IsConnected}">
        <StackPanel Spacing="4"><TextBlock Text="Players" Classes="muted" /><TextBlock Text="{Binding Population}" FontSize="18" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Queue" Classes="muted" /><TextBlock Text="{Binding Queue}" FontSize="18" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Server time" Classes="muted" /><TextBlock Text="{Binding ServerTime}" FontSize="18" /><TextBlock Text="{Binding NextPhase}" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
