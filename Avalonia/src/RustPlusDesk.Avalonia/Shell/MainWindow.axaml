<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:servers="using:RustPlusDesk.Avalonia.Features.Servers"
        xmlns:devices="using:RustPlusDesk.Avalonia.Features.Devices"
        xmlns:accounts="using:RustPlusDesk.Avalonia.Features.Accounts"
        xmlns:recycling="using:RustPlusDesk.Avalonia.Features.Recycling"
        x:Class="RustPlusDesk.Avalonia.Shell.MainWindow"
        x:DataType="servers:ServersViewModel"
        Title="Rust+ Desktop — Cross-platform preview"
        Icon="/Assets/app.ico" Width="1750" Height="814" MinWidth="1000" MinHeight="700"
        WindowDecorations="Full">
  <Window.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CloseRecyclerCommand}" /></Window.KeyBindings>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="20">
    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !HasOverlay}">
      <StackPanel Spacing="4">
        <TextBlock Text="RUST+ DESKTOP" Classes="brand" />
        <TextBlock Text="Your Rust companion" Classes="muted" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Sign in for Rust+ pairing" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding RequiresSignIn}" />
        <TextBlock Text="Pairing active" Classes="muted" VerticalAlignment="Center"
                   IsVisible="{Binding Listener.IsRunning, FallbackValue=False}" />
        <Button Content="_Account" Command="{Binding OpenAccountCommand}" IsVisible="{Binding HasAccount}" />
        <Border Classes="badge"><TextBlock Text="Cross-platform preview" /></Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="350,Auto,*" ColumnSpacing="16">
      <servers:ServersView IsEnabled="{Binding !HasOverlay}" />
      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource CardBorder}" ResizeDirection="Columns" />
      <TabControl Grid.Column="2" SelectedIndex="{Binding WorkspaceIndex, Mode=TwoWay}" IsEnabled="{Binding !HasOverlay}">
        <TabItem Header="Devices"><devices:DevicesView DataContext="{Binding Connection.Devices}" /></TabItem>
        <TabItem Header="Recycler" IsVisible="{Binding HasRecyclerTool}">
          <Border Classes="card" Padding="16">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Recycling calculator" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="_Close" Command="{Binding CloseRecyclerCommand}" />
              </Grid>
              <recycling:RecyclerView Grid.Row="1" DataContext="{Binding Recycler}" />
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="{Binding ToolMessage}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Migration preview: additional workflows are still being migrated." />
    </StackPanel>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasEditor}">
      <servers:ServerEditorView DataContext="{Binding Editor}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding HasOrganizer}">
      <devices:DeviceOrganizerView DataContext="{Binding Organizer}" />
    </Border>
    <Border Grid.RowSpan="3" Background="#B0000000" IsVisible="{Binding IsAccountOpen}">
      <Border Classes="card" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16" KeyboardNavigation.TabNavigation="Cycle">
        <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
          <accounts:CompanionAccountView DataContext="{Binding Account}" IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).IsAccountOpen}" />
          <accounts:CompanionListenerView DataContext="{Binding Listener}"
              IsVisible="{Binding $parent[Window].((servers:ServersViewModel)DataContext).HasListener}"
              IsEnabled="{Binding !$parent[Window].((servers:ServersViewModel)DataContext).Account.IsBusy}" />
        </StackPanel>
        </ScrollViewer>
          <Button Grid.Row="1" Content="_Close" Command="{Binding CloseAccountCommand}" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
