<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:servers="using:RustPlusDesk.Avalonia.Features.Servers"
             xmlns:devices="using:RustPlusDesk.Avalonia.Features.Devices"
             x:Class="RustPlusDesk.Avalonia.Shell.ServerDevicePane" x:DataType="vm:ServersViewModel">
  <Border Background="{DynamicResource Surface}" Padding="12,16,12,10">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <ScrollViewer MaxHeight="330" HorizontalScrollBarVisibility="Disabled">
        <servers:ServersView />
      </ScrollViewer>
      <devices:DevicesView Grid.Row="1" DataContext="{Binding Connection.Devices}" />
      <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding Listener.Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="_Account" Command="{Binding OpenAccountCommand}" IsVisible="{Binding HasAccount}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
