<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RustPlusDesk.Avalonia.Features.Servers" xmlns:account="clr-namespace:RustPlusDesk.Core.Accounts;assembly=RustPlusDesk.Core"
             x:Class="RustPlusDesk.Avalonia.Shell.MapWorkspace" x:DataType="vm:ServersViewModel">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="190" />
      <RowDefinition Height="4" />
      <RowDefinition Height="180" MinHeight="90" MaxHeight="400" />
    </Grid.RowDefinitions>
    <Grid RowDefinitions="Auto,*">
      <Border Background="{DynamicResource SurfaceAlt}" Padding="16,10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="Map" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding Connection.IsConnected}">
            <TextBlock Text="{Binding Connection.Population, StringFormat='Players {0}'}" />
            <TextBlock Text="{Binding Connection.ServerTime}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="{DynamicResource MapBackground}" Padding="20">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" MaxWidth="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="Ready to explore the map?" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Connection.ServerName}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="_Connect" Classes="accent" Command="{Binding Connection.ConnectCommand}"
                    IsVisible="{Binding !Connection.IsActive}" HorizontalAlignment="Center" />
            <Button Content="_Disconnect" Command="{Binding Connection.DisconnectCommand}"
                    IsVisible="{Binding Connection.IsActive}" HorizontalAlignment="Center" />
            <TextBlock Text="Live map rendering is still being migrated. Server connections and device controls are available in this preview."
                       Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        </ScrollViewer>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource CardBorder}"
                  AutomationProperties.Name="Resize activity panel" />
    <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="12,8" x:Name="ActivityPanel">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Text="Pairing activity" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Listener.Status}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Listener.HealthMessage}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasListener}" />
            <ItemsControl ItemsSource="{Binding Listener.Notifications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="account:CompanionUpdate">
                  <TextBlock TextWrapping="Wrap" Margin="0,2">
                    <Run Text="{Binding OccurredAt.LocalDateTime, StringFormat='[{0:T}] '}" />
                    <Run Text="{Binding Title}" /><Run Text=" · " /><Run Text="{Binding Message}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
