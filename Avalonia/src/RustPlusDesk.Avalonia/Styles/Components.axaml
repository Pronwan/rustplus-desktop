<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Dark branding follows the reference; Light follows the system preference. -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg">#0F1013</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#181B1F</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#1F2229</SolidColorBrush>
          <SolidColorBrush x:Key="MapBackground">#0B3948</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#28FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#60CDFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentDark">#1A4D6B</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#F0F3F7</SolidColorBrush>
          <SolidColorBrush x:Key="TextSubtle">#A2ABBA</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionSuccess">#66BB6A</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionDanger">#EF5350</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionPending">#FFCA28</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionRePair">#FF7043</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#E9EDF2</SolidColorBrush>
          <SolidColorBrush x:Key="MapBackground">#DCEFF3</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorder">#26000000</SolidColorBrush>
          <SolidColorBrush x:Key="Accent">#006E99</SolidColorBrush>
          <SolidColorBrush x:Key="AccentDark">#CDEFFC</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#1A1A1A</SolidColorBrush>
          <SolidColorBrush x:Key="TextSubtle">#526071</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionSuccess">#237A27</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionDanger">#BB2323</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionPending">#875C00</SolidColorBrush>
          <SolidColorBrush x:Key="ConnectionRePair">#B33A16</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.rail.selected">
    <Setter Property="Background" Value="{DynamicResource AccentDark}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Ellipse.connection-dot"><Setter Property="Fill" Value="{DynamicResource ConnectionDanger}" /></Style>
  <Style Selector="Ellipse.connection-dot.connected"><Setter Property="Fill" Value="{DynamicResource ConnectionSuccess}" /></Style>
  <Style Selector="Ellipse.connection-dot.pending"><Setter Property="Fill" Value="{DynamicResource ConnectionPending}" /></Style>
  <Style Selector="Ellipse.connection-dot.repair"><Setter Property="Fill" Value="{DynamicResource ConnectionRePair}" /></Style>
</Styles>
