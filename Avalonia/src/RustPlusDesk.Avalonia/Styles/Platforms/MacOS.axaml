<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- shortcut: AppKit-style proportions; native macOS visual/menu acceptance remains required. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg">#1C1C1E</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#2C2C2E</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#3A3A3C</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg">#F5F5F7</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#E5E5EA</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,4" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="5" /><Setter Property="MinHeight" Value="30" /></Style>
</Styles>
