<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- shortcut: desktop-neutral styling; validate GTK/KDE-specific palette/font integration on native runners. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg">#242424</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#303030</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#383838</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceAlt">#EBEBEB</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="12,6" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /></Style>
</Styles>
