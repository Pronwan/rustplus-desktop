<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:menus="clr-namespace:RustPlusDesk.Controls.Menus"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============================================================
         MENU FLYOUT — the one definition of the app's context menus.

         This used to live twice, verbatim, in App.xaml and in
         Views/MainWindow/SharedResources.xaml. SharedResources is merged into
         MainWindow only, so code-behind in other windows that asked the
         application for "DarkContextMenu" found nothing and fell back to the
         stock WPF menu. Merging this dictionary into App.xaml gives every
         window the same menu.

         Keys are unchanged (DarkContextMenu / DarkMenuItem / DarkSeparator and
         the two templates) because ~90 call sites name them.

         The shape follows the WinUI 3 MenuFlyout: rounded container, hairline
         border, an inset hover pill that never touches the container edge, and
         a 20px icon rail the whole menu level shares so every label lands on
         one vertical line. The rail is reserved per level by menus:MenuFlyout —
         it appears only when something at that level actually has an icon or a
         checkmark, so icon-less menus keep their tight left edge.

         Acrylic: menus:MenuFlyout blurs the popup window on Windows 11 and
         swaps MenuFlyoutBackground for a translucent tint. Everything below is
         written for the opaque fallback, which is what Windows 10 keeps.

         The open animation also lives in menus:MenuFlyout — Windows slides the
         whole menu window up into place, and a template can only move content
         inside a window already sized to it.
         ============================================================ -->

    <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#F51E2026" />
    <SolidColorBrush x:Key="MenuFlyoutBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutIcon" Color="#D8FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutSeparator" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutText" Color="#F0F3F7" />

    <!-- Nulled out on the acrylic path: a blurred window already reads as
         lifted, and the shadow has no margin to render into anyway. -->
    <DropShadowEffect
        x:Key="MenuFlyoutShadow"
        BlurRadius="24"
        Direction="270"
        Opacity="0.5"
        ShadowDepth="6"
        Color="#000000" />

    <ControlTemplate x:Key="DarkMenuItem_Header" TargetType="MenuItem">
        <Grid>
            <Border
                x:Name="Bd"
                Margin="2,1"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="IconSlot"
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ui:SymbolIcon
                            x:Name="CheckIcon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{DynamicResource Accent}"
                            Symbol="Checkmark20"
                            Visibility="Collapsed" />
                        <ContentPresenter
                            x:Name="IconPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Icon"
                            TextElement.Foreground="{DynamicResource MenuFlyoutIcon}" />
                    </Grid>
                    <ContentPresenter
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        ContentSource="Header"
                        RecognizesAccessKey="True" />
                    <ui:SymbolIcon
                        Grid.Column="2"
                        Margin="12,0,2,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSubtle}"
                        Symbol="ChevronRight20" />
                </Grid>
            </Border>
            <Popup
                x:Name="PART_Popup"
                AllowsTransparency="True"
                Focusable="False"
                HorizontalOffset="-2"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Placement="Right"
                PopupAnimation="None"
                StaysOpen="False"
                VerticalOffset="-4">
                <Border
                    x:Name="SubmenuRoot"
                    Padding="4"
                    Background="{DynamicResource MenuFlyoutBackground}"
                    BorderBrush="{DynamicResource MenuFlyoutBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{DynamicResource MenuFlyoutShadow}"
                    SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(menus:MenuFlyout.ShowIconGutter), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="Tag" Value="Partial">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Opacity" Value="0.6" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuFlyoutHover}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                <Setter TargetName="IconSlot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="DarkMenuItem_Item" TargetType="MenuItem">
        <Border
            x:Name="Bd"
            Margin="2,1"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="4"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="IconSlot"
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ui:SymbolIcon
                        x:Name="CheckIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource Accent}"
                        Symbol="Checkmark20"
                        Visibility="Collapsed" />
                    <ContentPresenter
                        x:Name="IconPresenter"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Icon"
                        TextElement.Foreground="{DynamicResource MenuFlyoutIcon}" />
                </Grid>
                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ContentSource="Header"
                    RecognizesAccessKey="True" />
                <TextBlock
                    Grid.Column="2"
                    Margin="16,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextSubtle}"
                    Text="{TemplateBinding InputGestureText}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(menus:MenuFlyout.ShowIconGutter), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="Tag" Value="Partial">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Opacity" Value="0.6" />
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuFlyoutHover}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                <Setter TargetName="IconSlot" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource DarkMenuItem_Item}" />
        <Style.Triggers>
            <Trigger Property="HasItems" Value="True">
                <Setter Property="Template" Value="{StaticResource DarkMenuItem_Header}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource DarkMenuItem_Header}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource DarkMenuItem_Header}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource DarkMenuItem}" TargetType="MenuItem" />

    <Style x:Key="DarkSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border
                        Height="1"
                        Margin="8,4"
                        Background="{DynamicResource MenuFlyoutSeparator}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DarkSeparator}" TargetType="Separator" />

    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutText}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource MenuFlyoutBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{DynamicResource MenuFlyoutShadow}"
                        SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DarkContextMenu}" TargetType="ContextMenu" />

</ResourceDictionary>
