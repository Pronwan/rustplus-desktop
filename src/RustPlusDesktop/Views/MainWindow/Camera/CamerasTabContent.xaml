<UserControl
    x:Class="RustPlusDesk.Views.CamerasTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel LastChildFill="True">
        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button x:Name="BtnAddCam" Style="{StaticResource PrimaryButton}">
                <StackPanel Margin="6,1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="📷 " />
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource AddCamera}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="CamItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemHeight="180" ItemWidth="220" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel
                    MaxWidth="300"
                    Margin="0,50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=CamItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!--  Empty state, styled like the clan tab: a circle badge over title and hint  -->
                    <Border
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource WhiteA14}"
                        CornerRadius="36">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Symbol="Video24" />
                    </Border>
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{DynamicResource NoCamerasFound}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource PairCameraToSee}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
