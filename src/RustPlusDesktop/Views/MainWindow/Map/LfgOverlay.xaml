<UserControl x:Class="RustPlusDesk.Views.LfgOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RustPlusDesk.Converters"
             xmlns:chat="clr-namespace:RustPlusDesk.Controls.Chat"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="420"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:ChatDayDividerConverter x:Key="DayDivider" />

        <!--
            The panel's own names for the shared colours. Static because code-behind looks two of
            them up by key; the values match TextPrimary, TextSecondary, StrokeSubtle, Surface and
            Accent from DesignTokens.xaml and App.xaml.
        -->
        <SolidColorBrush x:Key="LfgText" Color="#FFF0F3F7" />
        <SolidColorBrush x:Key="LfgMuted" Color="#FFA3ADBD" />
        <SolidColorBrush x:Key="LfgLine" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="LfgCard" Color="#FF181B1F" />
        <SolidColorBrush x:Key="LfgAccent" Color="#FF60CDFF" />
        <!--  Text on an accent fill: dark, the way Fluent draws accent buttons in the dark theme.  -->
        <SolidColorBrush x:Key="LfgOnAccent" Color="#FF0B1620" />
        <SolidColorBrush x:Key="LfgGoldTint" Color="#1FF2C14E" />
        <SolidColorBrush x:Key="LfgDangerTint" Color="#24EF5350" />
        <SolidColorBrush x:Key="LfgDangerText" Color="#FFF28B87" />
        <SolidColorBrush x:Key="LfgSuccessTint" Color="#246CCB8A" />
        <SolidColorBrush x:Key="LfgAvatarFill" Color="#FF2A2F37" />

        <Style x:Key="LfgSectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <!--  Caption-sized helper text under a control or inside a state.  -->
        <Style x:Key="LfgCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <!--  Small tinted label: a role, a state, a server. Tinted fill, coloured text, no outline.  -->
        <Style x:Key="LfgPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
        </Style>
        <Style x:Key="LfgPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Count bubbles on the inbox tab and the friends button.  -->
        <Style x:Key="LfgCountBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="LfgCountBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LfgOnAccent}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!--  Cards that sit in the panel: a hairline and a faint fill, nothing more.  -->
        <Style x:Key="LfgCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FillControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!--  A question asked inline (rules, consent): raised one step above the panel.  -->
        <Style x:Key="LfgCallout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="LfgCalloutTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Icon in a soft circle, heading every empty, gated and closed state.  -->
        <Style x:Key="LfgStateIcon" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="LfgStateTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LfgStateBody" TargetType="TextBlock" BasedOn="{StaticResource LfgCaption}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!--  Rows that react to the pointer: chat lines, threads, friends.  -->
        <Style x:Key="LfgHoverRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LfgHoverCard" TargetType="Border" BasedOn="{StaticResource LfgCardStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Small borderless icon button for the composer tools (clear, colour, emoji).  -->
        <Style x:Key="LfgToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusControl}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControlHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControlPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The send button, inside the field it sends. Accent while there is something to send,
            quiet while the box is empty; while slow mode holds it, the countdown replaces the
            icon (the code writes it into Content).
        -->
        <Style x:Key="LfgSendButton" TargetType="Button">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource LfgOnAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusControl}">
                            <Grid>
                                <ui:SymbolIcon x:Name="Ico" Symbol="Send24" Filled="True" FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Countdown" Visibility="Collapsed" Margin="10,0"
                                                  TextElement.FontSize="{DynamicResource TypeCaption}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Countdown" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource FillControl}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            A text box drawn as nothing but text and placeholder, for use inside a composer shell
            that owns the background, outline and focus colour.
        -->
        <Style x:Key="LfgComposerTextBox" TargetType="ui:TextBox">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:TextBox">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Placeholder" Visibility="Collapsed" IsHitTestVisible="False"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The inset field around a composer: hairline at rest, accent while typing.  -->
        <Style x:Key="LfgComposerShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FillInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            A round box with a green dot, matching the online lights in the lists below it. The
            filter and the thing it filters on then look like the same idea, which is what a
            square tick next to round status lights was failing to do.
        -->
        <Style x:Key="SocialDotCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="6,0" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource StrokeStrong}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource StatusSuccess}" Opacity="0" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControl}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource StatusSuccess}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Tabs, drawn as one segmented control: the selected segment is raised out of the inset
            track. It reads as "one of these", which separate lit pills did not.
        -->
        <Style x:Key="SocialTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource FillControl}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource FillControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource FillControlHover}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
            The supporters tab. The same shape as the others so it does not shout, in gold so it
            is clearly not the same kind of room.
        -->
        <Style x:Key="SocialTabGold" TargetType="RadioButton" BasedOn="{StaticResource SocialTab}">
            <Setter Property="Foreground" Value="#FFC9A85C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SocialDotRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="ItemBd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusControl}"
                            Padding="10,7"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource StrokeStrong}" StrokeThickness="1.5" Fill="Transparent" />
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource FillControlHover}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A flag takes no room when there is no flag for the language, rather than leaving a gap before the name.  -->
        <Style x:Key="LfgFlag" TargetType="Image">
            <Style.Triggers>
                <Trigger Property="Source" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Online light on the corner of an avatar.  -->
        <Style x:Key="LfgStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Stroke" Value="{DynamicResource Surface}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Margin" Value="0,0,-1,-1" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusOverlay}"
            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header. The panel holds a room and a board, so it is named after neither.  -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center"
                        CornerRadius="{DynamicResource RadiusOverlay}" Background="{DynamicResource AccentTintBrush}">
                    <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="16" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!--  One line each. The subtitle trims rather than wraps; the tooltip has the rest.  -->
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SocialHubTitle}" Foreground="{DynamicResource TextPrimary}"
                               FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{DynamicResource SocialHubSubtitle}" ToolTip="{DynamicResource SocialHubSubtitle}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <ui:Button x:Name="BtnFriends" Click="BtnFriends_Click" Appearance="Transparent" BorderThickness="0"
                                   Width="32" Height="32" Padding="0"
                                   ToolTip="{DynamicResource FriendsTitle}"
                                   AutomationProperties.Name="{DynamicResource FriendsTitle}">
                            <ui:SymbolIcon Symbol="People24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                        </ui:Button>
                        <!--  Requests waiting on an answer, over the icon.  -->
                        <Border x:Name="FriendsBadge" Visibility="Collapsed" Style="{StaticResource LfgCountBadge}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                                BorderBrush="{DynamicResource Surface}" BorderThickness="2" Height="20" MinWidth="20" CornerRadius="10" Padding="4,0">
                            <TextBlock x:Name="FriendsBadgeText" Style="{StaticResource LfgCountBadgeText}" />
                        </Border>
                    </Grid>
                    <ui:Button x:Name="BtnBlocks" Click="BtnBlocks_Click" Appearance="Transparent" BorderThickness="0"
                               Width="32" Height="32" Padding="0" Margin="2,0,0,0"
                               ToolTip="{DynamicResource BlocksTitle}"
                               AutomationProperties.Name="{DynamicResource BlocksTitle}">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                    </ui:Button>
                    <ui:Button x:Name="BtnClose" Click="BtnClose_Click" Appearance="Transparent" BorderThickness="0"
                               Width="32" Height="32" Padding="0" Margin="2,0,0,0"
                               ToolTip="{DynamicResource Close}"
                               AutomationProperties.Name="{DynamicResource Close}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!--  Cloud gate: shown instead of everything else when there is no cloud account.  -->
            <Border x:Name="CloudGate" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="290" Margin="0,0,0,40">
                    <Border Style="{StaticResource LfgStateIcon}">
                        <ui:SymbolIcon Symbol="Cloud24" FontSize="24" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource LfgCloudRequired}" Style="{StaticResource LfgStateBody}" Margin="0" />
                    <ui:Button x:Name="BtnCloudSetup" Click="BtnCloudSetup_Click" Appearance="Primary" Margin="0,16,0,0"
                               HorizontalAlignment="Center" Content="{DynamicResource LfgCloudConnect}" />
                </StackPanel>
            </Border>

            <!--  Rolled out in stages, and this account is not in one yet.  -->
            <Border x:Name="ClosedGate" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="290" Margin="0,0,0,40">
                    <Border Style="{StaticResource LfgStateIcon}">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource SocialNotOpenTitle}" Style="{StaticResource LfgStateTitle}" />
                    <TextBlock Text="{DynamicResource SocialNotOpenBody}" Style="{StaticResource LfgStateBody}" />
                </StackPanel>
            </Border>

            <!--  Main body  -->
            <Grid x:Name="Body" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Which part of Community you are in. One segmented track; the three rooms and
                    boards by name, the inbox by its icon and unread count, so all four fit on one
                    line in the narrow column instead of wrapping or scrolling.
                -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="2"
                        Background="{DynamicResource FillInset}" BorderBrush="{DynamicResource StrokeSubtle}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusOverlay}" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="89*" />
                            <ColumnDefinition Width="108*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="SecChat" Grid.Column="0" GroupName="SocialSection" IsChecked="True"
                                     Style="{StaticResource SocialTab}"
                                     Content="{DynamicResource SocialSectionChatShort}" AutomationProperties.Name="{DynamicResource SocialSectionChat}"
                                     ToolTip="{DynamicResource SocialSectionChat}" Checked="Section_Checked" />
                        <!--
                            The supporters' room. Gold rather than the accent, because it is the
                            one tab that says something about the person reading it rather than
                            about what is behind it.
                        -->
                        <RadioButton x:Name="SecSupporter" Grid.Column="1" GroupName="SocialSection" Margin="2,0,0,0"
                                     Style="{StaticResource SocialTabGold}"
                                     Content="{DynamicResource SocialSectionSupporterShort}" AutomationProperties.Name="{DynamicResource SocialSectionSupporter}"
                                     ToolTip="{DynamicResource SocialSectionSupporter}" Checked="Section_Checked" />
                        <RadioButton x:Name="SecLfg" Grid.Column="2" GroupName="SocialSection" Margin="2,0,0,0"
                                     Style="{StaticResource SocialTab}"
                                     Content="{DynamicResource SocialSectionLfgShort}" AutomationProperties.Name="{DynamicResource SocialSectionLfg}"
                                     ToolTip="{DynamicResource SocialSectionLfg}" Checked="Section_Checked" />

                        <!--  Inbox, with the unread count on it when there is one.  -->
                        <RadioButton x:Name="SecInbox" Grid.Column="3" GroupName="SocialSection" Margin="2,0,0,0"
                                     Style="{StaticResource SocialTab}" MinWidth="34"
                                     ToolTip="{DynamicResource SocialSectionInbox}"
                                     AutomationProperties.Name="{DynamicResource SocialSectionInbox}"
                                     Checked="Section_Checked">
                            <!--  The count sits on the icon's corner, so it never takes width from the named tabs.  -->
                            <Grid Width="16" Height="16">
                                <ui:SymbolIcon Symbol="Mail24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Border x:Name="InboxTabBadge" Visibility="Collapsed" Style="{StaticResource LfgCountBadge}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,-8,-30,0"
                                        Height="18" BorderThickness="0">
                                    <TextBlock x:Name="InboxTabBadgeText" Style="{StaticResource LfgCountBadgeText}" />
                                </Border>
                            </Grid>
                        </RadioButton>
                    </Grid>
                </Border>

                <!--  The public room (3-row layout: header note, scrollable chat list, sticky compose footer)  -->
                <Grid x:Name="ChatSection" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Who can see what. Said once, quietly, above the room.  -->
                    <Border Grid.Row="0" Margin="0,0,0,4" Padding="10,7"
                            Background="{DynamicResource FillControl}" CornerRadius="{DynamicResource RadiusControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource ChatRules}" Style="{StaticResource LfgCaption}" />
                        </Grid>
                    </Border>

                    <!-- Scrollable Chat Messages & Floating Scroll To Bottom Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <!--
                            The list runs 6px past the panel edge on both sides so that a row's hover
                            fill has room around its text while the avatars and names still line up
                            with everything above.
                        -->
                        <ScrollViewer x:Name="ChatScrollViewer" Margin="-6,0,-6,0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="ChatScrollViewer_ScrollChanged">
                            <StackPanel>
                                <ItemsControl x:Name="ChatList" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!--  8px before a new speaker; consecutive lines from the same one sit tight.  -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Margin" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowHeader}" Value="True">
                                                                <Setter Property="Margin" Value="0,8,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!--
                                                    The flash layer for "jump to original". Kept first among the
                                                    borders on purpose: the code flashes the first Border it finds,
                                                    and painting this one leaves the row's own hover fill working.
                                                -->
                                                <Border Grid.Row="1" Background="Transparent" IsHitTestVisible="False"
                                                        CornerRadius="{DynamicResource RadiusControl}" />

                                                <!--  Where the day changes.  -->
                                                <Grid Grid.Row="0" Margin="6,4,6,8">
                                                    <Grid.Visibility>
                                                        <MultiBinding Converter="{StaticResource DayDivider}" ConverterParameter="visibility">
                                                            <Binding />
                                                            <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </Grid.Visibility>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Height="1" Background="{DynamicResource StrokeSubtle}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Margin="12,0" FontSize="{DynamicResource TypeCaption}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource DayDivider}">
                                                                <Binding />
                                                                <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <Border Grid.Column="2" Height="1" Background="{DynamicResource StrokeSubtle}" VerticalAlignment="Center" />
                                                </Grid>

                                                <!--
                                                    A Border rather than a bare Grid, because a panel with no Background is
                                                    invisible to hit testing: the context menu only opened where text or the
                                                    avatar happened to be, and the gap to the right of a short message did
                                                    nothing. Transparent still counts as a background, so the whole line is
                                                    clickable — and the hover tint is there to say so before you try.
                                                -->
                                                <Border x:Name="Row" Grid.Row="1" Padding="6,3"
                                                        Visibility="{Binding IsSystemSanction, Converter={StaticResource InverseBoolToVis}}"
                                                        Style="{StaticResource LfgHoverRow}">
                                                    <Border.ContextMenu>
                                                        <!--
                                                            Copying works on anyone's message, including your own.
                                                            Everything below it is about someone else — reporting,
                                                            blocking or befriending yourself are offers that make no
                                                            sense, so on your own lines the menu is just the one entry.
                                                        -->
                                                        <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                            <MenuItem Header="{DynamicResource ChatCopyText}" Click="ChatCopyText_Click" Tag="{Binding}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Mention @User" Click="ChatMention_Click" Tag="{Binding}"
                                                                      Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Mention24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource ChatReply}" Click="ChatReply_Click" Tag="{Binding}"
                                                                      Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowReply24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource ChatTranslateWithGoogle}" Click="ChatTranslate_Click" Tag="{Binding}"
                                                                      Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Translate24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Visibility="{Binding CanAddAsFriend, Converter={StaticResource BoolToVis}}" />
                                                            <MenuItem Header="{DynamicResource FriendsAddFriend}" Click="ChatAddFriend_Click" Tag="{Binding}"
                                                                      Visibility="{Binding CanAddAsFriend, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}" />
                                                            <MenuItem Header="{DynamicResource LfgBlockUser}" Click="ChatBlock_Click" Tag="{Binding}"
                                                                      Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="PersonProhibited24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource LfgReportUser}" Click="ChatReport_Click" Tag="{Binding}"
                                                                      Visibility="{Binding IsNotMine, Converter={StaticResource BoolToVis}}">
                                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Flag24" FontSize="16" /></MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  Avatar, on the first line of a run only.  -->
                                                        <Grid Grid.Column="0" Width="32" Height="32" Margin="0,2,0,0" VerticalAlignment="Top"
                                                              Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
                                                            <!--  Supporters: a thin gold ring, no glow.  -->
                                                            <Ellipse Margin="-3" Stroke="{DynamicResource StatusWarning}" StrokeThickness="1.5"
                                                                     Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}" />
                                                            <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                                            <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource TextSecondary}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Stroke="#14FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                                                        </Grid>

                                                        <!--  On the lines that follow, the time shows in the avatar's place on hover.  -->
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Margin="0,2,0,0"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                   FontSize="{DynamicResource TypeCaption}" Foreground="{DynamicResource TextSecondary}"
                                                                   Typography.NumeralAlignment="Tabular" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding ShowHeader}" Value="False" />
                                                                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <!--  Name, role and time on one baseline.  -->
                                                            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,0,1"
                                                                       Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVis}}">
                                                                <Run Text="{Binding SenderName, Mode=OneWay}" Foreground="{Binding SenderNameBrush, Mode=OneWay}"
                                                                     FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" /><InlineUIContainer BaselineAlignment="Center">
                                                                    <Border Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}"
                                                                            Background="{Binding RoleBadge.BackgroundBrush}"
                                                                            CornerRadius="{DynamicResource RadiusControl}" Padding="6,0" Margin="8,0,0,0" Height="18">
                                                                        <TextBlock Text="{Binding RoleBadge.DisplayText}" Foreground="{Binding RoleBadge.ForegroundBrush}"
                                                                                   FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </InlineUIContainer><Run Text="  " FontSize="{DynamicResource TypeCaption}" /><Run Text="{Binding TimeLabel, Mode=OneWay}" FontSize="{DynamicResource TypeCaption}"
                                                                     Foreground="{DynamicResource TextSecondary}" />
                                                            </TextBlock>

                                                            <!--
                                                                The quoted line this message answers. Clicking it jumps to
                                                                the original, so the reply is a way back rather than just a
                                                                label. A bar and one line: the answer is the message, not the quote.
                                                            -->
                                                            <Button Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}"
                                                                    Click="ChatJumpToOriginal_Click" Tag="{Binding ReplyTo.Id}"
                                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                                    Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,2,0,3"
                                                                    AutomationProperties.Name="{Binding ReplyTo.DisplayText}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Quote" Background="Transparent" Padding="0,2,6,2"
                                                                                CornerRadius="{DynamicResource RadiusControl}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Width="2" CornerRadius="1" Background="{DynamicResource Accent}"
                                                                                        VerticalAlignment="Stretch" Margin="0,0,8,0" />
                                                                                <TextBlock x:Name="QuoteText" Grid.Column="1" FontSize="{DynamicResource TypeCaption}"
                                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource TextSecondary}">
                                                                                    <Run Text="{Binding ReplyTo.DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                                                                         Foreground="{DynamicResource TextPrimary}" /><Run Text="  " /><Run Text="{Binding ReplyTo.DisplayText, Mode=OneWay}" />
                                                                                </TextBlock>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Quote" Property="Background" Value="{DynamicResource FillControl}" />
                                                                                <Setter TargetName="QuoteText" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="Quote" Property="Background" Value="{DynamicResource FillControlPressed}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Message Text & Emojis -->
                                                            <chat:RichChatTextBlock RawText="{Binding Body}" TextWrapping="Wrap" LineHeight="20"
                                                                                    Foreground="{DynamicResource TextPrimary}"
                                                                                    FontSize="{DynamicResource TypeBody}" EmojiSize="30" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- System Sanction Alert (Timeout / Ban / Lifted) -->
                                                <Border Grid.Row="1" Margin="6,4"
                                                        Visibility="{Binding IsSystemSanction, Converter={StaticResource BoolToVis}}"
                                                        Background="{Binding SanctionEvent.CardBackgroundBrush}"
                                                        BorderBrush="{Binding SanctionEvent.CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusOverlay}" Padding="12,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Style="{StaticResource LfgPill}" Background="{Binding SanctionEvent.HeaderBackgroundBrush}" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding SanctionEvent.HeaderTitle}" Style="{StaticResource LfgPillText}"
                                                                               Foreground="{Binding SanctionEvent.HeaderForegroundBrush}" />
                                                                </Border>
                                                                <Border Style="{StaticResource LfgPill}" Background="{StaticResource LfgGoldTint}"
                                                                        Visibility="{Binding SanctionEvent.DurationBadgeVisibility}">
                                                                    <TextBlock Text="{Binding SanctionEvent.DurationBadgeText}" Style="{StaticResource LfgPillText}"
                                                                               Foreground="{DynamicResource StatusWarning}" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding SanctionEvent.TimeLabel}" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}"
                                                                       Typography.NumeralAlignment="Tabular" />
                                                        </Grid>

                                                        <TextBlock Grid.Row="1" FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                                   Foreground="{DynamicResource TextSecondary}">
                                                            <Run Text="Target: " />
                                                            <Run Text="{Binding SanctionEvent.TargetDisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                                                 Foreground="{DynamicResource TextPrimary}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding SanctionEvent.TargetSteamIdFormatted, Mode=OneWay}" FontFamily="Consolas" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Row="2" Visibility="{Binding SanctionEvent.HasReason, Converter={StaticResource BoolToVis}}"
                                                                   Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap">
                                                            <Run Text="Reason: " Foreground="{DynamicResource TextSecondary}" />
                                                            <Run Text="{Binding SanctionEvent.Reason, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  An empty room: centred, like every other empty state in the panel.  -->
                        <StackPanel x:Name="ChatEmptyNotice" Visibility="Collapsed" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260" Margin="0,0,0,24">
                            <Border Style="{StaticResource LfgStateIcon}">
                                <ui:SymbolIcon Symbol="ChatMultiple24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource ChatEmpty}" Style="{StaticResource LfgStateTitle}" />
                        </StackPanel>

                        <!-- Floating Scroll to Bottom Button -->
                        <Button x:Name="BtnScrollToBottom"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,10"
                                Background="{DynamicResource SurfaceOverlay}"
                                BorderBrush="{DynamicResource StrokeDefault}"
                                BorderThickness="1"
                                Click="BtnScrollToBottom_Click"
                                Visibility="Collapsed"
                                Opacity="0"
                                Cursor="Hand"
                                AutomationProperties.Name="{DynamicResource ChatScrollToBottom}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="16" Height="32" Padding="12,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35" />
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource ChatScrollToBottom}" FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Sticky Bottom Send Message & Status Component -->
                    <StackPanel Grid.Row="2">
                        <!--  Why the box is gone, rather than a box that silently does nothing  -->
                        <Border x:Name="ChatSilencedBar" Visibility="Collapsed" Style="{StaticResource LfgComposerShell}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Prohibited24" FontSize="16" Foreground="{DynamicResource StatusWarning}"
                                               VerticalAlignment="Top" Margin="0,0,10,0" />
                                <TextBlock x:Name="ChatSilencedText" Grid.Column="1" TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}" />
                            </Grid>
                        </Border>

                        <!--
                            The rules of the room. Shown once, before the first line is ever
                            posted, because a rule somebody was never shown is not a rule they can
                            be held to afterwards - and this one can end in losing the room for
                            good.
                        -->
                        <Border x:Name="ChatRulesPanel" Visibility="Collapsed" Margin="0,0,0,8" Style="{StaticResource LfgCallout}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ChatRulesTitle}" Style="{StaticResource LfgCalloutTitle}" />
                                <TextBlock Text="{DynamicResource ChatRulesIntro}" Style="{StaticResource LfgCaption}" Margin="0,6,0,0" />
                                <TextBlock Text="{DynamicResource ChatRulesForbidden}" Style="{StaticResource LfgCaption}"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0" />
                                <TextBlock Text="{DynamicResource ChatRulesConsequence}" Style="{StaticResource LfgCaption}"
                                           Foreground="{StaticResource LfgDangerText}" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ui:Button x:Name="BtnChatRulesAccept" Click="BtnChatRulesAccept_Click" Appearance="Primary"
                                               Content="{DynamicResource ChatRulesAccept}" Margin="0,0,8,0" />
                                    <ui:Button x:Name="BtnChatRulesCancel" Click="BtnChatRulesCancel_Click" Appearance="Secondary"
                                               Content="{DynamicResource ChatRulesCancel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--
                            Asked before the first translation, because it sends the message text
                            to Google. In the panel rather than a system dialog: a modal box over
                            the map for a question this small is a jolt, and the app has its own
                            look for exactly this.
                        -->
                        <Border x:Name="ChatTranslateConsentPanel" Visibility="Collapsed" Margin="0,0,0,8" Style="{StaticResource LfgCallout}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ChatTranslateConsentTitle}" Style="{StaticResource LfgCalloutTitle}" />
                                <TextBlock Text="{DynamicResource ChatTranslateConsentBody}" Style="{StaticResource LfgCaption}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ui:Button x:Name="BtnTranslateConsentAccept" Click="BtnTranslateConsentAccept_Click" Appearance="Primary"
                                               Content="{DynamicResource ChatTranslateConsentAccept}" Margin="0,0,8,0" />
                                    <ui:Button x:Name="BtnTranslateConsentCancel" Click="BtnTranslateConsentCancel_Click" Appearance="Secondary"
                                               Content="{DynamicResource ChatRulesCancel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Why the last line did not go through. One sentence, above the box.  -->
                        <TextBlock x:Name="ChatRefusal" Visibility="Collapsed" Margin="2,0,0,6"
                                   Foreground="{StaticResource LfgDangerText}" FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap" />

                        <!-- Active Compose Component (includes Slow Mode indicator & Compose input) -->
                        <StackPanel x:Name="ChatComposeArea">
                            <Border x:Name="ChatSlowModeBar" Visibility="Collapsed" Margin="0,0,0,6"
                                    Style="{StaticResource LfgPill}" Background="{DynamicResource AccentTintBrush}"
                                    Padding="8,3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ChatSlowModeText" Text="Slow Mode: 10s" Foreground="{DynamicResource Accent}"
                                               FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!--  One field: who you are answering, the text, its tools and the send button.  -->
                            <Border x:Name="ChatComposerShell" Style="{StaticResource LfgComposerShell}">
                                <StackPanel>
                                    <!--
                                        Who you are answering, at the top of the box you type in. Backspace on an
                                        empty box clears it, the way it works everywhere else people have
                                        learned this — the × is for anyone who has not.
                                    -->
                                    <Border x:Name="ChatReplyBar" Visibility="Collapsed" Padding="10,4,4,4"
                                            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="ArrowReply24" FontSize="14" Foreground="{DynamicResource Accent}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock x:Name="ChatReplyBarName" Grid.Column="1" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="ChatReplyBarExcerpt" Grid.Column="2" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="3" Click="ChatCancelReply_Click" Style="{StaticResource LfgToolButton}"
                                                    Width="24" Height="24" Margin="6,0,0,0"
                                                    ToolTip="{DynamicResource ChatReplyCancel}"
                                                    AutomationProperties.Name="{DynamicResource ChatReplyCancel}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!--
                                        Text on its own full-width line, tools in a row under it: the box
                                        keeps its width in the narrowest sidebar, however many of the tools
                                        a supporter has showing.
                                    -->
                                    <Grid x:Name="ChatComposeRow" Margin="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBox x:Name="TxtChat" Grid.ColumnSpan="2" MaxLength="128"
                                                    Style="{StaticResource LfgComposerTextBox}"
                                                    MaxHeight="120"
                                                    AcceptsReturn="True"
                                                    TextWrapping="Wrap"
                                                    VerticalScrollBarVisibility="Auto"
                                                    ClearButtonEnabled="False"
                                                    PlaceholderText="{DynamicResource ChatPlaceholder}"
                                                    AutomationProperties.Name="{DynamicResource ChatPlaceholder}"
                                                    TextChanged="TxtChat_TextChanged"
                                                    KeyDown="TxtChat_KeyDown" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2,0,0,0">
                                            <Button x:Name="BtnChatEmoji" Style="{StaticResource LfgToolButton}"
                                                    ToolTip="Insert Emoji or Rust Item" AutomationProperties.Name="Insert Emoji or Rust Item">
                                                <ui:SymbolIcon Symbol="Emoji24" FontSize="18"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>

                                            <!--
                                                Sits beside the emoji button rather than in a settings page:
                                                it changes how your messages look in this room, and this is
                                                where you are while you care about that. Hidden entirely for
                                                non-supporters — the platform refuses the write anyway, and a
                                                control that only ever says no is worse than no control.
                                            -->
                                            <Button x:Name="BtnChatNameColor" Style="{StaticResource LfgToolButton}"
                                                    Visibility="Collapsed"
                                                    Click="BtnChatNameColor_Click"
                                                    ToolTip="{DynamicResource ChatNameColorTooltip}"
                                                    AutomationProperties.Name="{DynamicResource ChatNameColorTooltip}">
                                                <Ellipse Width="14" Height="14" Stroke="{DynamicResource StrokeStrong}" StrokeThickness="1"
                                                         Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <!-- Clear Text Button -->
                                            <Button x:Name="BtnChatClear" Style="{StaticResource LfgToolButton}" Width="28"
                                                    Visibility="Collapsed"
                                                    Click="BtnChatClear_Click"
                                                    ToolTip="Clear message" AutomationProperties.Name="Clear message">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>

                                            <!-- Character Counter -->
                                            <TextBlock x:Name="TxtChatCharCount"
                                                       Text="0/128"
                                                       FontSize="{DynamicResource TypeCaption}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />

                                            <Button x:Name="BtnChatSend" Click="BtnChatSend_Click"
                                                    ToolTip="{DynamicResource LfgSend}"
                                                    AutomationProperties.Name="{DynamicResource LfgSend}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LfgSendButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtChat}" Value="">
                                                                <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource FillControl}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <Popup x:Name="ChatNameColorPopup"
                                               PlacementTarget="{Binding ElementName=BtnChatNameColor}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource SurfaceOverlay}" BorderBrush="{DynamicResource StrokeDefault}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource RadiusOverlay}" Padding="10" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource ChatNameColorHeading}" Style="{StaticResource LfgSectionHeading}" />
                                                    <ItemsControl x:Name="ChatNameColorList">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" MaxWidth="160" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Width="32" Height="32" Margin="2"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Cursor="Hand" Tag="{Binding Key}"
                                                                        ToolTip="{Binding Label}"
                                                                        AutomationProperties.Name="{Binding Label}"
                                                                        Click="ChatNameColorSwatch_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Sw" CornerRadius="16" Padding="3"
                                                                                    Background="Transparent"
                                                                                    BorderBrush="{Binding Selection}" BorderThickness="2">
                                                                                <Ellipse Fill="{Binding Swatch}" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Sw" Property="Background" Value="{DynamicResource FillControlHover}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="{DynamicResource ChatNameColorReset}"
                                                            Click="ChatNameColorReset_Click"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}"
                                                            Cursor="Hand" HorizontalAlignment="Left" Margin="2,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <!-- Autocomplete Popup -->
                                        <Popup x:Name="GlobalChatAutocompletePopup"
                                               PlacementTarget="{Binding ElementName=TxtChat}"
                                               Placement="Top"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               VerticalOffset="-10">
                                            <chat:ChatEmojiAutocompletePopup x:Name="GlobalChatAutocompleteControl" />
                                        </Popup>

                                        <!-- Emoji & Item Picker Popup -->
                                        <Popup x:Name="GlobalChatPickerPopup"
                                               PlacementTarget="{Binding ElementName=BtnChatEmoji}"
                                               Placement="Top"
                                               HorizontalOffset="0"
                                               VerticalOffset="-10"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <chat:ChatEmojiPickerPopup x:Name="GlobalChatPickerControl" />
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--
                    What somebody outside the supporters' room sees in place of it. The tab is
                    drawn for everybody on purpose: hiding it would hide what supporting buys.
                -->
                <Border x:Name="SupporterGate" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="290" Margin="0,0,0,40">
                        <Border Style="{StaticResource LfgStateIcon}" Background="{StaticResource LfgGoldTint}">
                            <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="24" Foreground="{DynamicResource StatusWarning}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource SupporterGateTitle}" Style="{StaticResource LfgStateTitle}"
                                   FontSize="{DynamicResource TypeSubtitle}" />
                        <TextBlock Text="{DynamicResource SupporterGateBody}" Style="{StaticResource LfgStateBody}" />
                        <ui:Button x:Name="BtnSupporterOffer" Click="BtnSupporterOffer_Click" Appearance="Primary"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Content="{DynamicResource SupporterGateAction}" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="LfgSection" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">

                    <!--
                        Status as a short list of choices in one card, and who may write to you
                        under it. Side by side, both had to squeeze, and the options were cut off.
                    -->
                    <TextBlock Text="{DynamicResource LfgStatusHeading}" Style="{StaticResource LfgSectionHeading}" />
                    <Border Style="{StaticResource LfgCardStyle}" Padding="4" Margin="0,0,0,16">
                        <StackPanel>
                            <RadioButton x:Name="RbModeNone" GroupName="LfgMode" Content="{DynamicResource LfgModeNone}"
                                         Style="{StaticResource SocialDotRadio}" Checked="Mode_Checked" />
                            <RadioButton x:Name="RbModeLfg" GroupName="LfgMode" Content="{DynamicResource LfgModeLfg}"
                                         Style="{StaticResource SocialDotRadio}" Checked="Mode_Checked" />
                            <RadioButton x:Name="RbModeLfm" GroupName="LfgMode" Content="{DynamicResource LfgModeLfm}"
                                         Style="{StaticResource SocialDotRadio}" Margin="0" Checked="Mode_Checked" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource LfgMessagesHeading}" Style="{StaticResource LfgSectionHeading}" />
                        <!--
                            Height and centred content on purpose: left to size itself the
                            selected line sits against the top edge and reads as clipped.
                        -->
                        <ComboBox x:Name="CmbAcceptMode" FontSize="{DynamicResource TypeBody}" Height="34" Padding="10,0"
                                  VerticalContentAlignment="Center" MaxDropDownHeight="220"
                                  AutomationProperties.Name="{DynamicResource LfgMessagesHeading}"
                                  SelectionChanged="AcceptMode_Changed" />
                        <TextBlock x:Name="AcceptOffBlockedNote" Visibility="Collapsed" Margin="2,6,0,0"
                                   Text="{DynamicResource LfgAcceptOffBlocked}" Style="{StaticResource LfgCaption}" />
                    </StackPanel>

                    <!--  Note / Blurb for the active listing  -->
                    <StackPanel x:Name="LfgNotePanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource LfgNoteHeading}" Style="{StaticResource LfgSectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="TxtBlurb" MaxLength="280"
                                        PlaceholderText="{DynamicResource LfgNotePlaceholder}"
                                        AutomationProperties.Name="{DynamicResource LfgNoteHeading}"
                                        TextChanged="TxtBlurb_TextChanged" KeyDown="TxtBlurb_KeyDown" />
                            <ui:Button Grid.Column="1" x:Name="BtnSaveBlurb" Click="BtnSaveBlurb_Click"
                                       Appearance="Primary" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Content="{DynamicResource LfgNoteSave}" />
                        </Grid>
                    </StackPanel>

                    <!--
                        Consent, inline rather than as a modal. It appears the moment somebody
                        reaches for a mode and the status only commits once it is accepted, so the
                        disclosure sits where the decision is instead of interrupting it.
                    -->
                    <Border x:Name="ConsentPanel" Visibility="Collapsed" Margin="0,0,0,16" Style="{StaticResource LfgCallout}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LfgConsentTitle}" Style="{StaticResource LfgCalloutTitle}" />
                            <TextBlock Text="{DynamicResource LfgConsentBody}" Style="{StaticResource LfgCaption}" Margin="0,6,0,0" />
                            <TextBlock Text="{DynamicResource LfgConsentNote}" Style="{StaticResource LfgCaption}"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button x:Name="BtnConsentAccept" Click="BtnConsentAccept_Click" Appearance="Primary"
                                           Content="{DynamicResource LfgConsentAccept}" Margin="0,0,8,0" />
                                <ui:Button x:Name="BtnConsentCancel" Click="BtnConsentCancel_Click" Appearance="Secondary"
                                           Content="{DynamicResource LfgConsentCancel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Preview of user's own active listing  -->
                    <StackPanel x:Name="MyListingPreview" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource LfgMyListingHeading}" Style="{StaticResource LfgSectionHeading}" />
                        <Border Style="{StaticResource LfgCardStyle}" Padding="12,10"
                                Background="{DynamicResource AccentTintBrush}" BorderBrush="#3360CDFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Avatar  -->
                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top"
                                      Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonUp="Preview_ProfileClick"
                                      ToolTip="{DynamicResource ProfileOpenSteam}">
                                    <Ellipse x:Name="PreviewSupporterRing" Stroke="{DynamicResource StatusWarning}" StrokeThickness="1.5" Visibility="Collapsed" />
                                    <Ellipse Margin="3" Fill="{StaticResource LfgAvatarFill}" />
                                    <Ellipse Margin="3">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="PreviewAvatar" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Style="{StaticResource LfgStatusDot}" Fill="{DynamicResource StatusSuccess}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Cursor="Hand" Background="Transparent"
                                          MouseLeftButtonUp="Preview_ProfileClick"
                                          ToolTip="{DynamicResource ProfileOpenSteam}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="PreviewFlag" Width="16" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Style="{StaticResource LfgFlag}" />
                                        <TextBlock x:Name="PreviewDisplayName" Grid.Column="1" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock x:Name="PreviewBlurb" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource TypeCaption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource LfgPill}" Background="{StaticResource LfgSuccessTint}" Margin="0,6,6,0">
                                            <TextBlock x:Name="PreviewModeBadge" Style="{StaticResource LfgPillText}" Foreground="{DynamicResource StatusSuccess}" />
                                        </Border>
                                        <Border Style="{StaticResource LfgPill}" Margin="0,6,6,0">
                                            <TextBlock Text="{DynamicResource LfgPreviewActiveBadge}" Style="{StaticResource LfgPillText}" />
                                        </Border>
                                        <Border x:Name="PreviewServerBadge" Style="{StaticResource LfgPill}" Margin="0,6,0,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Server24" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock x:Name="PreviewServerName" Style="{StaticResource LfgPillText}" FontWeight="Normal" MaxWidth="170" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel x:Name="PreviewTeamSizePanel" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,2,0" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource LfgTeamSize}" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PreviewTeamSize" Text="—" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource StrokeSubtle}" Margin="0,0,0,16" />

                    <!--  Which list  -->
                    <Border Margin="0,0,0,10" Padding="2"
                            Background="{DynamicResource FillInset}" BorderBrush="{DynamicResource StrokeSubtle}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusOverlay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="153*" />
                                <ColumnDefinition Width="145*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TabTeams" GroupName="LfgTab" IsChecked="True" Padding="3,0"
                                         Style="{StaticResource SocialTab}"
                                         Content="{DynamicResource LfgTabTeamsShort}" AutomationProperties.Name="{DynamicResource LfgTabTeams}" ToolTip="{DynamicResource LfgTabTeams}" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabPlayers" Grid.Column="1" GroupName="LfgTab" Margin="2,0,0,0" Padding="3,0"
                                         Style="{StaticResource SocialTab}"
                                         Content="{DynamicResource LfgTabPlayersShort}" AutomationProperties.Name="{DynamicResource LfgTabPlayers}" ToolTip="{DynamicResource LfgTabPlayers}" Checked="Tab_Checked" />
                        </Grid>
                    </Border>

                    <!--  Filters. Without them a list stops being useful somewhere past a hundred rows.  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="0" FontSize="{DynamicResource TypeCaption}" Height="32" Padding="10,0"
                                  VerticalContentAlignment="Center" MaxDropDownHeight="220"
                                  SelectionChanged="Filter_Changed" />
                        <CheckBox x:Name="ChkOnlineOnly" Grid.Column="1" Margin="6,0,0,0"
                                  Style="{StaticResource SocialDotCheck}" VerticalAlignment="Center"
                                  Content="{DynamicResource LfgFilterOnline}"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <ui:Button x:Name="BtnRefresh" Grid.Column="2" Margin="2,0,0,0" Width="32" Height="32" Padding="0"
                                   Appearance="Transparent" BorderThickness="0" Click="BtnRefresh_Click"
                                   ToolTip="{DynamicResource LfgFilterRefresh}"
                                   AutomationProperties.Name="{DynamicResource LfgFilterRefresh}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                        </ui:Button>
                    </Grid>

                    <StackPanel x:Name="ListEmptyNotice" Visibility="Collapsed" Margin="0,24,0,24"
                                HorizontalAlignment="Center" MaxWidth="260">
                        <Border Style="{StaticResource LfgStateIcon}">
                            <ui:SymbolIcon Symbol="PeopleSearch24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource LfgEmpty}" Style="{StaticResource LfgStateBody}" Margin="0" />
                    </StackPanel>

                    <ItemsControl x:Name="ListingList" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LfgHoverCard}" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Avatar, ringed in gold for supporters. Opens the profile.  -->
                                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top"
                                              Background="Transparent" Cursor="Hand"
                                              Tag="{Binding}" MouseLeftButtonUp="Listing_ProfileClick"
                                              ToolTip="{DynamicResource ProfileOpenSteam}">
                                            <Ellipse Stroke="{DynamicResource StatusWarning}" StrokeThickness="1.5"
                                                     Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Margin="3" Fill="{StaticResource LfgAvatarFill}" />
                                            <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Margin="3">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!--  Online light, bottom right of the avatar  -->
                                            <Ellipse Style="{StaticResource LfgStatusDot}" Fill="{Binding StatusBrush}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!--  Name gets the full line and trims; role and server ride on the line under the note.  -->
                                            <Grid Cursor="Hand" Tag="{Binding}" Background="Transparent"
                                                  MouseLeftButtonUp="Listing_ProfileClick" ToolTip="{DynamicResource ProfileOpenSteam}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding FlagPath}" Width="16" Height="12" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" Style="{StaticResource LfgFlag}" />
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Text="{Binding Blurb}" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="{DynamicResource TypeCaption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource LfgPill}" Margin="0,6,6,0"
                                                        Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}"
                                                        Background="{Binding RoleBadge.BackgroundBrush}">
                                                    <TextBlock Text="{Binding RoleBadge.DisplayText}" Style="{StaticResource LfgPillText}"
                                                               Foreground="{Binding RoleBadge.ForegroundBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource LfgPill}" Margin="0,6,0,0"
                                                        Visibility="{Binding HasServer, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Server24" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding ServerName}" Style="{StaticResource LfgPillText}" FontWeight="Normal" MaxWidth="170" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                                            <TextBlock Text="{DynamicResource LfgTeamSize}" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding TeamSizeLabel}" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="3" VerticalAlignment="Center" Width="32" Height="32" Padding="0"
                                                   Appearance="Secondary" Tag="{Binding}" Click="BtnOpenChat_Click"
                                                   ToolTip="{DynamicResource LfgOpenChat}"
                                                   AutomationProperties.Name="{DynamicResource LfgOpenChat}">
                                            <ui:SymbolIcon Symbol="Chat24" FontSize="16" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
                <!--
                    The inbox. Same mechanism as before, one level up: requests and replies are
                    not a footnote to the board they came from, and burying them under a list
                    meant scrolling past forty strangers to reach the one who wrote to you.
                -->
                <!--
                    The inbox holds two views in the same place: the list of threads, and one
                    thread opened. Both scroll on the inside rather than as a whole, so the way
                    back and the reply box stay where they were put.
                -->
                <Grid x:Name="InboxSection" Grid.Row="1" Visibility="Collapsed">
                    <Grid x:Name="ThreadListView">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="{DynamicResource LfgInbox}" Style="{StaticResource LfgSectionHeading}" />

                                <ItemsControl x:Name="ThreadList" Margin="-6,0,-6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LfgHoverRow}" CornerRadius="{DynamicResource RadiusOverlay}"
                                                    Padding="6,8" Margin="0,0,0,2"
                                                    Cursor="Hand" MouseLeftButtonUp="Thread_Click" Tag="{Binding}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                                                        <MenuItem Header="{DynamicResource FriendsAddFriend}" Click="ThreadAddFriend_Click" Tag="{Binding}"
                                                                  Visibility="{Binding CanAddAsFriend, Converter={StaticResource BoolToVis}}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator Visibility="{Binding CanAddAsFriend, Converter={StaticResource BoolToVis}}" />
                                                        <MenuItem Header="{DynamicResource LfgBlockUser}" Click="MenuBlock_Click" Tag="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="PersonProhibited24" FontSize="16" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource LfgReportUser}" Click="MenuReport_Click" Tag="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Flag24" FontSize="16" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                                        <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource TextSecondary}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <Ellipse Style="{StaticResource LfgStatusDot}" Fill="{Binding StatusBrush}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CounterpartName}" FontSize="{DynamicResource TypeBody}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UnreadBadge}" Value="Visible">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource LfgPill}" Background="{DynamicResource AccentTintBrush}" Margin="0,4,6,0"
                                                                    Visibility="{Binding PendingBadge}">
                                                                <TextBlock Text="{DynamicResource LfgPendingBadge}" Style="{StaticResource LfgPillText}"
                                                                           Foreground="{DynamicResource Accent}" />
                                                            </Border>
                                                            <Border Style="{StaticResource LfgPill}" Background="{StaticResource LfgDangerTint}" Margin="0,4,6,0"
                                                                    Visibility="{Binding DeclinedBadge}">
                                                                <TextBlock Text="{DynamicResource LfgDeclinedBadge}" Style="{StaticResource LfgPillText}"
                                                                           Foreground="{StaticResource LfgDangerText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding WhenLabel}" Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="{DynamicResource TypeCaption}" HorizontalAlignment="Right"
                                                                   Typography.NumeralAlignment="Tabular" />
                                                        <Border Style="{StaticResource LfgCountBadge}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                Visibility="{Binding UnreadBadge}">
                                                            <TextBlock Text="{Binding UnreadLabel}" Style="{StaticResource LfgCountBadgeText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  Nothing to read yet: what the inbox is for, said once.  -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270" Margin="0,0,0,40"
                                    IsHitTestVisible="False">
                            <StackPanel x:Name="InboxEmptyNotice" Visibility="Collapsed">
                                <Border Style="{StaticResource LfgStateIcon}">
                                    <ui:SymbolIcon Symbol="Mail24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{DynamicResource LfgInboxEmpty}" Style="{StaticResource LfgStateTitle}" />
                            </StackPanel>
                            <TextBlock x:Name="InboxHint" Visibility="Collapsed"
                                       Text="{DynamicResource SocialInboxHint}" Style="{StaticResource LfgStateBody}" />
                        </StackPanel>
                    </Grid>

                    <!--  One open thread  -->
                    <Grid x:Name="ThreadView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10"
                                    BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" x:Name="BtnThreadBack" Click="BtnThreadBack_Click"
                                               Appearance="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="-4,0,6,0"
                                               ToolTip="{DynamicResource LfgBack}"
                                               AutomationProperties.Name="{DynamicResource LfgBack}">
                                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                                    </ui:Button>
                                    <TextBlock Grid.Column="1" x:Name="ThreadTitle" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1">

                            <!--  A request you have not answered: the decision comes before the reply box  -->
                            <Border x:Name="PendingBar" Visibility="Collapsed" Margin="0,0,0,12" Style="{StaticResource LfgCallout}">
                                <StackPanel>
                                    <TextBlock x:Name="PendingHint" Style="{StaticResource LfgCaption}" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel x:Name="PendingActionsRow" Orientation="Horizontal" Margin="0,12,0,0">
                                        <ui:Button x:Name="BtnAcceptRequest" Click="BtnAcceptRequest_Click" Appearance="Primary"
                                                   Content="{DynamicResource LfgAcceptRequest}" Margin="0,0,8,0" />
                                        <ui:Button x:Name="BtnDeclineRequest" Click="BtnDeclineRequest_Click" Appearance="Secondary"
                                                   Content="{DynamicResource LfgDeclineRequest}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  Writing to somebody for the first time: no history yet, and a shorter limit  -->
                            <TextBlock x:Name="ComposeHint" Visibility="Collapsed" Margin="2,0,0,12"
                                       Text="{DynamicResource LfgComposeHint}" Style="{StaticResource LfgCaption}" />

                            <TextBlock x:Name="DeclinedHint" Visibility="Collapsed" Margin="2,0,0,12"
                                       Text="{DynamicResource LfgDeclinedHint}" Style="{StaticResource LfgCaption}" />

                            </StackPanel>

                            <!--  The only part that scrolls.  -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
                            <ItemsControl x:Name="MessageList" Margin="0,0,4,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  Yours on the right in the accent tint, theirs on the left; the corner nearest the sender stays tight.  -->
                                        <Border Padding="10,6" Margin="0,0,0,6" MaxWidth="260" HorizontalAlignment="{Binding Side}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                                                    <Setter Property="CornerRadius" Value="8,8,8,2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                            <Setter Property="CornerRadius" Value="8,8,2,8" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="20"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}" />
                                                <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                            <Grid x:Name="ReplyRow" Grid.Row="3">
                                <Border Style="{StaticResource LfgComposerShell}">
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" x:Name="TxtReply" MaxLength="1000"
                                                    Style="{StaticResource LfgComposerTextBox}"
                                                    PlaceholderText="{DynamicResource LfgReplyPlaceholder}"
                                                    AutomationProperties.Name="{DynamicResource LfgReplyPlaceholder}"
                                                    KeyDown="TxtReply_KeyDown" />
                                        <Button Grid.Column="1" x:Name="BtnSend" Click="BtnSend_Click" VerticalAlignment="Bottom"
                                                ToolTip="{DynamicResource LfgSend}"
                                                AutomationProperties.Name="{DynamicResource LfgSend}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LfgSendButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtReply}" Value="">
                                                            <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!--
                Friends, blocks, add friend, profile and report.

                Five panes, one wrapper. Each is a full-width page that slides in over the hub with
                a back arrow, not a dialog: the hub lives in a sidebar a few hundred pixels wide, and
                a centred card cannot be both readable and inside it. Later children sit on top, so
                a pane opened from another (profile from a friend, add from the list) returns to the
                one beneath it on back, and "Esc" peels them off one at a time.

                A friendship is not a conversation: somebody can answer a stranger without wanting
                them on a list, so the request that arrives carries both decisions separately and
                the friends pane only ever shows the second one.
            -->
            <Grid x:Name="HubPanes" Grid.Row="0" Grid.RowSpan="2" Margin="-12" Panel.ZIndex="20">
                <Grid.Resources>
                    <Style x:Key="HubPane" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface}" />
                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>

                    <Style x:Key="HubPaneTitle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="FontSize" Value="{DynamicResource TypeSubtitle}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>

                    <Style x:Key="HubFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LfgSectionHeading}">
                        <Setter Property="Margin" Value="2,0,0,6" />
                    </Style>

                    <!--  A section title that folds its list: chevron, name, count.  -->
                    <Style x:Key="FriendsSectionHeader" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Padding" Value="4,6" />
                        <Setter Property="Margin" Value="0,10,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                            CornerRadius="{DynamicResource RadiusControl}">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControlHover}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControlHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!--  A friend or a blocked player: hairline-free until the pointer or the keyboard arrives.  -->
                    <Style x:Key="FriendRowBorder" TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Focusable" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Background" Value="{DynamicResource FillControl}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!--  A friend row while it is asking "are you sure?": raised onto a card so the question reads as one.  -->
                    <Style x:Key="FriendRowBorderAsking" TargetType="Border" BasedOn="{StaticResource FriendRowBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="ConfirmRemove">
                                <Setter Property="Background" Value="{DynamicResource FillControl}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Mode}" Value="ConfirmBlock">
                                <Setter Property="Background" Value="{DynamicResource FillControl}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!--  Quick actions: out of the way until the row is pointed at or focused.  -->
                    <Style x:Key="FriendRowActions" TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="FriendStatusText" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="Margin" Value="0,2,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="FriendPresenceDot" TargetType="Ellipse" BasedOn="{StaticResource LfgStatusDot}">
                        <Setter Property="Stroke" Value="{DynamicResource Surface}" />
                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
                        <Setter Property="Opacity" Value="0.5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource StatusSuccess}" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!--  "Remove Rook from your friends?" in the row it is about.  -->
                    <DataTemplate x:Key="FriendConfirmRemoveTemplate">
                        <StackPanel Margin="2,2,2,4">
                            <TextBlock Text="{Binding RemovePrompt}" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Danger"
                                           Tag="{Binding}" Click="BtnFriendRemoveConfirm_Click" IsEnabled="{Binding IsIdle}"
                                           Content="{DynamicResource FriendsRemoveAction}" Margin="0,0,6,0" />
                                <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Secondary"
                                           Tag="{Binding}" Click="BtnFriendConfirmCancel_Click"
                                           Content="{DynamicResource FriendsConfirmCancel}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!--  Blocking from a row also offers to end the friendship, which is what most people mean by it.  -->
                    <DataTemplate x:Key="FriendConfirmBlockTemplate">
                        <StackPanel Margin="2,2,2,4">
                            <TextBlock Text="{Binding BlockPrompt}" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource BlocksIntro}" Style="{StaticResource LfgCaption}" Margin="0,4,0,0" />
                            <CheckBox IsChecked="{Binding AlsoRemoveOnBlock, Mode=TwoWay}" Margin="0,8,0,0"
                                      Visibility="{Binding FriendVisibility}">
                                <TextBlock Text="{DynamicResource FriendsBlockAlsoRemove}" Foreground="{DynamicResource TextPrimary}"
                                           FontSize="{DynamicResource TypeCaption}" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Danger"
                                           Tag="{Binding}" Click="BtnFriendBlockConfirm_Click" IsEnabled="{Binding IsIdle}"
                                           Content="{DynamicResource FriendsBlockAction}" Margin="0,0,6,0" />
                                <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Secondary"
                                           Tag="{Binding}" Click="BtnFriendConfirmCancel_Click"
                                           Content="{DynamicResource FriendsConfirmCancel}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!--  The same actions twice: the ⋯ button opens this, and so does a right click.  -->
                    <ContextMenu x:Key="FriendRowMenu" x:Shared="False" Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="{DynamicResource FriendsMessage}" Click="MenuFriendMessage_Click" Tag="{Binding}"
                                  Visibility="{Binding FriendVisibility}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Chat24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource FriendsViewProfile}" Click="MenuFriendProfile_Click" Tag="{Binding}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Person24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{DynamicResource FriendsRemove}" Click="MenuFriendRemove_Click" Tag="{Binding}"
                                  Visibility="{Binding FriendVisibility}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PersonDelete24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource LfgBlockUser}" Click="MenuFriendBlock_Click" Tag="{Binding}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PersonProhibited24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{DynamicResource FriendsReport}" Click="MenuFriendReport_Click" Tag="{Binding}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Flag24" FontSize="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>

                    <!--  A friend: face, name, where they are; actions on hover and focus.  -->
                    <DataTemplate x:Key="FriendRowTemplate">
                        <Border Style="{StaticResource FriendRowBorderAsking}" Tag="{Binding}" Cursor="Hand"
                                ContextMenu="{StaticResource FriendRowMenu}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                MouseLeftButtonUp="Friend_Click" KeyDown="FriendRow_KeyDown">
                            <Grid>
                                <Grid Visibility="{Binding NormalVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                        <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Style="{StaticResource FriendPresenceDot}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource FriendStatusText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Style="{StaticResource FriendRowActions}" Margin="6,0,0,0">
                                        <ui:Button Width="30" Height="30" Padding="0" Appearance="Transparent" BorderThickness="0"
                                                   Tag="{Binding}" Click="BtnFriendMessage_Click"
                                                   ToolTip="{DynamicResource FriendsMessage}"
                                                   AutomationProperties.Name="{DynamicResource FriendsMessage}">
                                            <ui:SymbolIcon Symbol="Chat24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                                        </ui:Button>
                                        <ui:Button Width="30" Height="30" Padding="0" Appearance="Transparent" BorderThickness="0"
                                                   Tag="{Binding}" Click="BtnFriendMore_Click"
                                                   ToolTip="{DynamicResource FriendsMore}"
                                                   AutomationProperties.Name="{DynamicResource FriendsMore}">
                                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendConfirmRemoveTemplate}"
                                                Visibility="{Binding ConfirmRemoveVisibility}" IsTabStop="False" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendConfirmBlockTemplate}"
                                                Visibility="{Binding ConfirmBlockVisibility}" IsTabStop="False" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--  A request, in either direction: the decision sits on the card, not behind a menu.  -->
                    <DataTemplate x:Key="FriendRequestTemplate">
                        <Border Style="{StaticResource LfgCardStyle}" Padding="10,10" Margin="0,0,0,6" Tag="{Binding}"
                                ContextMenu="{StaticResource FriendRowMenu}" Focusable="True"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <Grid>
                                <Grid Visibility="{Binding NormalVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource TypeCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IncomingVisibility}">
                                            <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Primary"
                                                       Margin="0,0,6,0" Tag="{Binding}" Click="BtnFriendAccept_Click"
                                                       IsEnabled="{Binding IsIdle}" Content="{DynamicResource FriendsAccept}" />
                                            <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Secondary"
                                                       Margin="0,0,6,0" Tag="{Binding}" Click="BtnFriendDecline_Click"
                                                       IsEnabled="{Binding IsIdle}" Content="{DynamicResource FriendsDecline}" />
                                            <ui:Button Width="30" Height="30" Padding="0" Appearance="Transparent" BorderThickness="0"
                                                       Tag="{Binding}" Click="BtnFriendMore_Click"
                                                       ToolTip="{DynamicResource FriendsMore}"
                                                       AutomationProperties.Name="{DynamicResource FriendsMore}">
                                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                                            </ui:Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding OutgoingVisibility}">
                                            <ui:Button Height="30" Padding="14,0" FontSize="{DynamicResource TypeCaption}" Appearance="Secondary"
                                                       Margin="0,0,6,0" Tag="{Binding}" Click="BtnFriendWithdraw_Click"
                                                       IsEnabled="{Binding IsIdle}" Content="{DynamicResource FriendsWithdraw}" />
                                            <ui:Button Width="30" Height="30" Padding="0" Appearance="Transparent" BorderThickness="0"
                                                       Tag="{Binding}" Click="BtnFriendMore_Click"
                                                       ToolTip="{DynamicResource FriendsMore}"
                                                       AutomationProperties.Name="{DynamicResource FriendsMore}">
                                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FriendConfirmBlockTemplate}"
                                                Visibility="{Binding ConfirmBlockVisibility}" IsTabStop="False" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--  Somebody blocked: when, and the one thing to do about it.  -->
                    <DataTemplate x:Key="BlockedRowTemplate">
                        <Border Style="{StaticResource LfgCardStyle}" Padding="10,8" Margin="0,0,0,6"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0">
                                    <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{DynamicResource BlocksSince}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource TypeCaption}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding BlockedAtLabel}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource TypeCaption}" />
                                    </StackPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="2" VerticalAlignment="Center" Height="30" Padding="14,0" Margin="8,0,0,0"
                                           FontSize="{DynamicResource TypeCaption}" Appearance="Secondary"
                                           Tag="{Binding}" Click="BtnUnblock_Click"
                                           Content="{DynamicResource BlocksUnblock}" />
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!--  A person worth suggesting: somebody already talked to, not yet a friend.  -->
                    <DataTemplate x:Key="FriendSuggestionTemplate">
                        <Border Style="{StaticResource FriendRowBorder}" Tag="{Binding}" Cursor="Hand"
                                AutomationProperties.Name="{Binding Name}"
                                MouseLeftButtonUp="FriendSuggestion_Click" KeyDown="FriendSuggestion_KeyDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" Margin="0,0,10,0">
                                    <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{DynamicResource TypeCaption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="PersonAdd24" FontSize="16" Margin="8,0,2,0"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <!--  ═══ The friends list ═══  -->
                <Border x:Name="FriendsSheet" Style="{StaticResource HubPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnFriendsCloseTop" Click="BtnFriendsClose_Click" Appearance="Transparent" BorderThickness="0"
                                       Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                                       ToolTip="{DynamicResource FriendsBack}" AutomationProperties.Name="{DynamicResource FriendsBack}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FriendsTitle}" Style="{StaticResource HubPaneTitle}" />
                                <TextBlock x:Name="FriendsSummary" Visibility="Collapsed" Style="{StaticResource LfgCaption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" x:Name="BtnOpenAddFriend" Click="BtnOpenAddFriend_Click" Appearance="Primary"
                                       Height="32" Padding="12,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="{DynamicResource FriendsButtonAdd}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource FriendsButtonAdd}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>

                        <!--  Stays put while the list scrolls under it.  -->
                        <ui:TextBox Grid.Row="1" x:Name="TxtFriendSearch" Margin="0,0,0,4"
                                    PlaceholderText="{DynamicResource FriendsSearchPlaceholder}"
                                    AutomationProperties.Name="{DynamicResource FriendsSearchPlaceholder}"
                                    TextChanged="TxtFriendSearch_TextChanged">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,2,12">
                                <!--  A refresh failed but there is something to show: say so above it, offer a retry.  -->
                                <Border x:Name="FriendsErrorBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8"
                                        Background="{StaticResource LfgDangerTint}" CornerRadius="{DynamicResource RadiusOverlay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{StaticResource LfgDangerText}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource FriendsLoadErrorShort}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap" />
                                        <ui:Button Grid.Column="2" Height="28" Padding="10,0" Appearance="Transparent" Margin="8,0,0,0"
                                                   FontSize="{DynamicResource TypeCaption}" Click="BtnFriendsRetry_Click"
                                                   Content="{DynamicResource FriendsRetry}" />
                                    </Grid>
                                </Border>

                                <!--  Nothing to show yet, and a read in flight.  -->
                                <StackPanel x:Name="FriendsLoadingState" Visibility="Collapsed" Margin="0,48,0,0" HorizontalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource FriendsLoading}" Style="{StaticResource LfgStateBody}" Margin="0" />
                                </StackPanel>

                                <!--  Nothing to show, and the read failed: not the same thing as having no friends.  -->
                                <StackPanel x:Name="FriendsErrorState" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}" Background="{StaticResource LfgDangerTint}">
                                        <ui:SymbolIcon Symbol="CloudDismiss24" FontSize="24" Foreground="{StaticResource LfgDangerText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource FriendsLoadError}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource FriendsLoadErrorBody}" Style="{StaticResource LfgStateBody}" />
                                    <ui:Button Appearance="Primary" HorizontalAlignment="Center" Margin="0,16,0,0" Click="BtnFriendsRetry_Click"
                                               Content="{DynamicResource FriendsRetry}" />
                                </StackPanel>

                                <StackPanel x:Name="FriendsEmptyNotice" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}">
                                        <ui:SymbolIcon Symbol="People24" FontSize="24" Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource FriendsEmptyTitle}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource FriendsEmptyBody}" Style="{StaticResource LfgStateBody}" />
                                    <ui:Button Appearance="Primary" HorizontalAlignment="Center" Margin="0,16,0,0" Click="BtnOpenAddFriend_Click"
                                               Content="{DynamicResource FriendsButtonAdd}" />
                                </StackPanel>

                                <StackPanel x:Name="FriendsSearchEmptyNotice" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource FriendsNoSearchResults}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource FriendsNoSearchBody}" Style="{StaticResource LfgStateBody}" />
                                </StackPanel>

                                <!--  Requests: the only rows with a decision attached, so they go first.  -->
                                <StackPanel x:Name="FriendsRequestsSection" Visibility="Collapsed">
                                    <Grid Margin="4,12,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource FriendsSectionRequests}" Style="{StaticResource LfgSectionHeading}" Margin="0" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource LfgPill}" Background="{DynamicResource AccentTintBrush}">
                                            <TextBlock x:Name="FriendsRequestsCount" Style="{StaticResource LfgPillText}" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl x:Name="FriendRequestList" ItemTemplate="{StaticResource FriendRequestTemplate}"
                                                  KeyboardNavigation.TabNavigation="Continue" />
                                </StackPanel>

                                <StackPanel x:Name="FriendsOnlineSection" Visibility="Collapsed">
                                    <Button x:Name="BtnOnlineSection" Style="{StaticResource FriendsSectionHeader}" Tag="online"
                                            Click="BtnFriendsSection_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon x:Name="OnlineChevron" Symbol="ChevronDown24" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource FriendsSectionOnline}" Style="{StaticResource LfgSectionHeading}"
                                                       Margin="0" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource LfgPill}">
                                                <TextBlock x:Name="FriendsOnlineCount" Style="{StaticResource LfgPillText}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl x:Name="FriendList" ItemTemplate="{StaticResource FriendRowTemplate}" />
                                </StackPanel>

                                <StackPanel x:Name="FriendsOfflineSection" Visibility="Collapsed">
                                    <Button x:Name="BtnOfflineSection" Style="{StaticResource FriendsSectionHeader}" Tag="offline"
                                            Click="BtnFriendsSection_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon x:Name="OfflineChevron" Symbol="ChevronDown24" FontSize="12" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{DynamicResource FriendsOffline}" Style="{StaticResource LfgSectionHeading}"
                                                       Margin="0" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource LfgPill}">
                                                <TextBlock x:Name="FriendsOfflineCount" Style="{StaticResource LfgPillText}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <ItemsControl x:Name="FriendOfflineList" ItemTemplate="{StaticResource FriendRowTemplate}" />
                                </StackPanel>

                                <!--  The way into the block list from here, next to the people it is about.  -->
                                <Button x:Name="BtnFriendsOpenBlocks" Click="BtnBlocks_Click" Style="{StaticResource FriendsSectionHeader}"
                                        Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="16" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{DynamicResource BlocksTitle}" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--
                    The block list.

                    Blocking is the one thing here somebody can do about another person without
                    waiting for us, and it is deliberately private and immediate. That only works if
                    it can also be undone: a list you cannot see is a list you cannot leave, and a
                    block made in the middle of an argument is exactly what people want back.
                -->
                <Border x:Name="BlocksSheet" Style="{StaticResource HubPane}" Panel.ZIndex="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnBlocksClose" Click="BtnBlocksClose_Click" Appearance="Transparent" BorderThickness="0"
                                       Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                                       ToolTip="{DynamicResource FriendsBack}" AutomationProperties.Name="{DynamicResource FriendsBack}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource BlocksTitle}" Style="{StaticResource HubPaneTitle}" />
                                <TextBlock x:Name="BlocksSummary" Visibility="Collapsed" Style="{StaticResource LfgCaption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <ui:TextBox Grid.Row="1" x:Name="TxtBlockSearch" Margin="0,0,0,4" Visibility="Collapsed"
                                    PlaceholderText="{DynamicResource BlocksSearchPlaceholder}"
                                    AutomationProperties.Name="{DynamicResource BlocksSearchPlaceholder}"
                                    TextChanged="TxtBlockSearch_TextChanged">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,2,12">
                                <StackPanel x:Name="BlocksLoadingState" Visibility="Collapsed" Margin="0,48,0,0" HorizontalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" Margin="0,0,0,12" />
                                    <TextBlock Text="{DynamicResource BlocksLoading}" Style="{StaticResource LfgStateBody}" Margin="0" />
                                </StackPanel>

                                <StackPanel x:Name="BlocksErrorState" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}" Background="{StaticResource LfgDangerTint}">
                                        <ui:SymbolIcon Symbol="CloudDismiss24" FontSize="24" Foreground="{StaticResource LfgDangerText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource BlocksLoadError}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource FriendsLoadErrorBody}" Style="{StaticResource LfgStateBody}" />
                                    <ui:Button Appearance="Primary" HorizontalAlignment="Center" Margin="0,16,0,0" Click="BtnBlocksRetry_Click"
                                               Content="{DynamicResource FriendsRetry}" />
                                </StackPanel>

                                <!--  Empty is the moment to say what blocking does, before anybody needs it.  -->
                                <StackPanel x:Name="BlocksEmptyNotice" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}">
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="24" Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource BlocksEmptyTitle}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource BlocksIntro}" Style="{StaticResource LfgStateBody}" />
                                </StackPanel>

                                <StackPanel x:Name="BlocksSearchEmptyNotice" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="24" Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource BlocksNoMatch}" Style="{StaticResource LfgStateTitle}" />
                                </StackPanel>

                                <StackPanel x:Name="BlocksListSection" Visibility="Collapsed">
                                    <TextBlock Text="{DynamicResource BlocksIntro}" Style="{StaticResource LfgCaption}" Margin="2,0,2,12" />
                                    <ItemsControl x:Name="BlockList" ItemTemplate="{StaticResource BlockedRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--
                    Add a friend.

                    One box for the id or a profile link, checked as it is typed; the person it
                    resolves to is shown before anything is sent. Opened from a chat line or a thread
                    it arrives already aimed, with their card in place of the box.
                -->
                <Border x:Name="AddFriendSheet" Style="{StaticResource HubPane}" Panel.ZIndex="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnAddFriendCloseTop" Click="BtnAddFriendClose_Click" Appearance="Transparent" BorderThickness="0"
                                       Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                                       ToolTip="{DynamicResource FriendsBack}" AutomationProperties.Name="{DynamicResource FriendsBack}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource FriendsAddFriendTitle}" Style="{StaticResource HubPaneTitle}" />
                                <TextBlock Text="{DynamicResource FriendsAddFriendSubtitle}" Style="{StaticResource LfgCaption}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                           ToolTip="{DynamicResource FriendsAddFriendSubtitle}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,0,2,12">
                                <StackPanel x:Name="FriendAddForm">
                                    <!--  Target player card when adding from chat/thread/profile  -->
                                    <Border x:Name="FriendTargetCard" Visibility="Collapsed" Style="{StaticResource LfgCardStyle}"
                                            Padding="10" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush x:Name="FriendTargetAvatar" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource FriendsAddTarget}"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}" />
                                                <TextBlock x:Name="FriendTargetName" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <ui:Button Grid.Column="2" x:Name="BtnFriendTargetClear" Click="BtnFriendTargetClear_Click"
                                                       Appearance="Transparent" BorderThickness="0" Width="30" Height="30" Padding="0"
                                                       ToolTip="{DynamicResource FriendsAddChange}"
                                                       AutomationProperties.Name="{DynamicResource FriendsAddChange}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>

                                    <!--  Id or link  -->
                                    <StackPanel x:Name="FriendIdPanel">
                                        <TextBlock Text="{DynamicResource FriendsAddInputLabel}" Style="{StaticResource HubFieldLabel}" />
                                        <ui:TextBox x:Name="TxtFriendSteamId" MaxLength="120"
                                                    PlaceholderText="{DynamicResource FriendsAddInputPlaceholder}"
                                                    AutomationProperties.Name="{DynamicResource FriendsAddInputLabel}"
                                                    TextChanged="TxtFriendSteamId_TextChanged" PreviewKeyDown="TxtFriendSteamId_PreviewKeyDown">
                                            <ui:TextBox.Icon>
                                                <ui:SymbolIcon Symbol="Link24" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            </ui:TextBox.Icon>
                                        </ui:TextBox>
                                        <TextBlock x:Name="FriendInputHint" Style="{StaticResource LfgCaption}" Margin="2,6,0,0"
                                                   Text="{DynamicResource FriendsAddHint}" />

                                        <!--  The Steam profile the id resolves to, so a wrong paste is caught before it is sent.  -->
                                        <Border x:Name="FriendPreviewCard" Visibility="Collapsed" Style="{StaticResource LfgCardStyle}"
                                                Padding="10" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="40" Height="40" Margin="0,0,12,0">
                                                    <Ellipse Fill="{StaticResource LfgAvatarFill}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush x:Name="FriendPreviewAvatar" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="FriendPreviewName" Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{DynamicResource FriendsAddSteamProfile}" Style="{StaticResource LfgCaption}"
                                                               TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="CheckmarkCircle24" FontSize="16" Margin="8,0,2,0"
                                                               Foreground="{DynamicResource StatusSuccess}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!--  People you have already talked to, one tap from a request.  -->
                                        <StackPanel x:Name="FriendSuggestionsPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                            <TextBlock Text="{DynamicResource FriendsAddSuggestions}" Style="{StaticResource HubFieldLabel}" />
                                            <ItemsControl x:Name="FriendSuggestionList" ItemTemplate="{StaticResource FriendSuggestionTemplate}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  The one message  -->
                                    <Grid Margin="0,18,0,6">
                                        <TextBlock Text="{DynamicResource FriendsAddMessageLabel}" Style="{StaticResource HubFieldLabel}" Margin="2,0,0,0" />
                                        <TextBlock x:Name="FriendMessageCount" HorizontalAlignment="Right" Style="{StaticResource LfgCaption}"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <ui:TextBox x:Name="TxtFriendMessage" MaxLength="300" MinHeight="72"
                                                AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                PlaceholderText="{DynamicResource FriendsAddMessage}"
                                                AutomationProperties.Name="{DynamicResource FriendsAddMessageLabel}"
                                                TextChanged="TxtFriendMessage_TextChanged" PreviewKeyDown="TxtFriendMessage_PreviewKeyDown" />
                                    <TextBlock Text="{DynamicResource FriendsAddMessageHelp}" Style="{StaticResource LfgCaption}" Margin="2,6,0,0" />

                                    <!--  Inline result: refusals read as refusals, with the reason.  -->
                                    <Border x:Name="FriendsNoticeBox" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10"
                                            Background="{StaticResource LfgDangerTint}" CornerRadius="{DynamicResource RadiusOverlay}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{StaticResource LfgDangerText}"
                                                           VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Grid.Column="1" x:Name="FriendsNotice" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource TypeCaption}" LineHeight="17" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!--  The receipt. Same pane, so the answer arrives where the question was asked.  -->
                                <StackPanel x:Name="FriendAddDone" Visibility="Collapsed" Margin="0,40,0,0" MaxWidth="290">
                                    <Border Style="{StaticResource LfgStateIcon}" Background="{StaticResource LfgSuccessTint}">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource StatusSuccess}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource FriendsAddSentTitle}" Style="{StaticResource LfgStateTitle}" />
                                    <TextBlock Text="{DynamicResource FriendsSent}" Style="{StaticResource LfgStateBody}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <ui:Button Appearance="Secondary" Margin="0,0,8,0" Click="BtnFriendAddAnother_Click"
                                                   Content="{DynamicResource FriendsAddAnother}" />
                                        <ui:Button Appearance="Primary" Click="BtnAddFriendClose_Click"
                                                   Content="{DynamicResource FriendsAddDone}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <ui:Button Grid.Row="2" x:Name="BtnFriendAdd" Click="BtnFriendAdd_Click" Appearance="Primary"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                   Content="{DynamicResource FriendsAddAction}" />
                    </Grid>
                </Border>

                <!--
                    A Steam profile, read straight from the community page.

                    Only from a listing or a friend, never from a line in the public room. The room
                    shows a name and nothing else on purpose; a listing already discloses the Steam
                    account, and did so with consent. Making the room a lookup tool would quietly
                    undo that.
                -->
                <Border x:Name="ProfileSheet" Style="{StaticResource HubPane}" Panel.ZIndex="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnProfileClose" Click="BtnProfileClose_Click" Appearance="Transparent" BorderThickness="0"
                                       Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                                       ToolTip="{DynamicResource FriendsBack}" AutomationProperties.Name="{DynamicResource FriendsBack}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Profile}" Style="{StaticResource HubPaneTitle}" VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,2,12">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="56" Height="56" Margin="0,0,14,0">
                                        <Ellipse x:Name="ProfileSupporterRing" Visibility="Collapsed"
                                                 Stroke="{DynamicResource StatusWarning}" StrokeThickness="1.5" />
                                        <Ellipse Margin="3" Fill="{StaticResource LfgAvatarFill}" />
                                        <Ellipse Margin="3">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="ProfileAvatar" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfileName" Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ProfileSteamId" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{DynamicResource TypeCaption}" FontFamily="Consolas" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="ProfileBlurb" Style="{StaticResource LfgCaption}" Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,12,0,0" Visibility="Collapsed" />

                                <StackPanel x:Name="ProfileFacts" Margin="0,12,0,0" />

                                <TextBlock x:Name="ProfileNotice" Style="{StaticResource LfgCaption}"
                                           Margin="0,8,0,0" Visibility="Collapsed" />

                                <TextBlock x:Name="ProfileVacWarning" Text="{DynamicResource ProfileVac}"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold"
                                           Margin="0,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                            <ui:Button x:Name="BtnProfileSteam" Click="BtnProfileSteam_Click" Appearance="Primary"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                       Content="{DynamicResource ProfileOpenSteam}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="BtnProfileCopy" Click="BtnProfileCopy_Click" Appearance="Secondary"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                           Content="{DynamicResource ProfileCopyId}" />
                                <ui:Button Grid.Column="2" x:Name="BtnProfileReport" Click="BtnProfileReport_Click" Appearance="Secondary"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                           Content="{DynamicResource FriendsReport}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Reporting somebody, over the whole panel.

                    A pane rather than an inline block, because this is the one action here that
                    asks a moderator to spend time. Making it happen half-scrolled past the thing
                    being reported is how a queue fills up with reports nobody can act on.
                -->
                <Border x:Name="ReportSheet" Style="{StaticResource HubPane}" Panel.ZIndex="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnReportBack" Click="BtnReportCancel_Click" Appearance="Transparent" BorderThickness="0"
                                       Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                                       ToolTip="{DynamicResource FriendsBack}" AutomationProperties.Name="{DynamicResource FriendsBack}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <ui:SymbolIcon Grid.Column="1" Symbol="Flag24" FontSize="18" Foreground="{DynamicResource Accent}"
                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="ReportHeading" Style="{StaticResource HubPaneTitle}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,0,2,12">
                                <!--  The form  -->
                                <StackPanel x:Name="ReportForm">
                                    <TextBlock Text="{DynamicResource ReportIntro}" Margin="0,0,0,12" Style="{StaticResource LfgCaption}" />

                                    <StackPanel x:Name="ReportReasons" />

                                    <!--  What is being reported, when it is one line rather than a person  -->
                                    <StackPanel x:Name="ReportQuoted" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource ReportQuotedLabel}" Style="{StaticResource LfgSectionHeading}" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="2" CornerRadius="1" Background="{DynamicResource Accent}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" x:Name="ReportQuotedText" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap" MaxHeight="72" LineHeight="17" />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource ReportNoteLabel}" Style="{StaticResource LfgSectionHeading}" Margin="0,14,0,6" TextWrapping="Wrap" />
                                    <ui:TextBox x:Name="TxtReportNote" MaxLength="1000" MinHeight="66"
                                                AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                Padding="10,8" FontSize="{DynamicResource TypeCaption}"
                                                AutomationProperties.Name="{DynamicResource ReportNoteLabel}"
                                                PlaceholderText="{DynamicResource ReportNotePlaceholder}" />

                                    <TextBlock x:Name="ReportError" Visibility="Collapsed" Margin="2,8,0,0"
                                               Text="{DynamicResource ReportFailed}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="{DynamicResource TypeCaption}" TextWrapping="Wrap" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnReportCancel" Click="BtnReportCancel_Click" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                   Content="{DynamicResource ReportCancel}" />
                                        <ui:Button Grid.Column="2" x:Name="BtnReportSubmit" Click="BtnReportSubmit_Click" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                   Content="{DynamicResource ReportSubmit}" />
                                    </Grid>
                                </StackPanel>

                                <!--  The receipt. Same pane, so the answer arrives where the question was asked.  -->
                                <StackPanel x:Name="ReportDone" Visibility="Collapsed" Margin="0,24,0,0">
                                    <Border Style="{StaticResource LfgStateIcon}" Background="{StaticResource LfgSuccessTint}">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource StatusSuccess}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource ReportDoneBody}" Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}"
                                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnReportBlock" Click="BtnReportBlock_Click" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                   Content="{DynamicResource LfgBlockUser}" />
                                        <ui:Button Grid.Column="2" x:Name="BtnReportClose" Click="BtnReportCancel_Click" Appearance="Primary"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                                   Content="{DynamicResource ReportClose}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--
                    One line at the bottom for what just happened, with the way back where there is
                    one. Replaces the modal dialogs: nothing here needs a click before the next thing
                    can be done.
                -->
                <Border x:Name="HubToast" Visibility="Collapsed" Panel.ZIndex="10" VerticalAlignment="Bottom"
                        Margin="24,0,24,24" Padding="12,6,6,6"
                        Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource StrokeDefault}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusOverlay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="HubToastIcon" Symbol="CheckmarkCircle24" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StatusSuccess}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" x:Name="HubToastText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}" LineHeight="17" />
                        <ui:Button Grid.Column="2" x:Name="HubToastAction" Click="HubToastAction_Click" Appearance="Transparent"
                                   Height="30" Padding="10,0" Margin="6,0,0,0" FontSize="{DynamicResource TypeCaption}"
                                   Foreground="{DynamicResource Accent}" />
                        <ui:Button Grid.Column="3" Click="HubToastDismiss_Click" Appearance="Transparent" BorderThickness="0"
                                   Width="30" Height="30" Padding="0"
                                   ToolTip="{DynamicResource FriendsDismiss}" AutomationProperties.Name="{DynamicResource FriendsDismiss}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
