<UserControl
    x:Class="RustPlusDesk.Views.ShopSearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:RustPlusDesk.Helpers"
    mc:Ignorable="d"
    d:DesignHeight="540"
    d:DesignWidth="400"
    Background="Transparent"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Style 1: Glassy Pill/Capsule Button (Filters) -->
        <Style x:Key="GlassyPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FillControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FillControlHover}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FillControlPressed}"/>
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="1.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style 2: Cohesive Action Toolbar Button with Dynamic Hover Expansion -->
        <Style x:Key="ActionToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FillControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FillControlHover}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FillControlPressed}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style 3: Smooth Animated Label on Button Hover -->
        <Style x:Key="HoverTextOnlyOnParentHover" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="120">
                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth"
                                                 To="100"
                                                 Duration="0:0:0.167">
                                    <DoubleAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="0" Y1="0" X2="0" Y2="1"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.167">
                                    <DoubleAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="0" Y1="0" X2="0" Y2="1"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                    To="4,0,0,0"
                                                    Duration="0:0:0.167">
                                    <ThicknessAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="0" Y1="0" X2="0" Y2="1"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="120">
                                <DoubleAnimation Storyboard.TargetProperty="MaxWidth"
                                                 To="0"
                                                 Duration="0:0:0.083">
                                    <DoubleAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="1" Y1="0" X2="1" Y2="1"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.083">
                                    <DoubleAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="1" Y1="0" X2="1" Y2="1"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                    To="0"
                                                    Duration="0:0:0.083">
                                    <ThicknessAnimation.EasingFunction>
                                        <helpers:CubicBezierEase X1="1" Y1="0" X2="1" Y2="1"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style 4: Alert Row Action Button -->
        <Style x:Key="AlertActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FillControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="NativeShopSearch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Search & Integrated Action Toolbar -->
        <Grid Grid.Row="0" Margin="10,12,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Magnified Glassy Search Box inside capsule Border -->
            <Border Grid.Column="0"
                    Background="{DynamicResource FillInset}"
                    BorderBrush="{DynamicResource StrokeDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusControl}"
                    Height="36"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                <Grid>
                    <ui:TextBox
                        x:Name="TxtShopSearch"
                        PlaceholderText="{DynamicResource UiSearchItemsOrTypeFreely}"
                        TextChanged="TxtShopSearch_TextChanged"
                        PreviewKeyDown="TxtShopSearch_PreviewKeyDown"
                        GotFocus="TxtShopSearch_GotFocus"
                        LostFocus="TxtShopSearch_LostFocus"
                        Icon="Search24"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextPrimary}"
                        FontSize="{DynamicResource TypeBody}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Padding="6,0,6,0" />

                    <!-- Auto-complete Suggestions popup -->
                    <Popup
                        x:Name="PopupAutocomplete"
                        PlacementTarget="{Binding ElementName=TxtShopSearch}"
                        Placement="Bottom"
                        IsOpen="False"
                        StaysOpen="False"
                        MinWidth="240"
                        MaxHeight="300"
                        PopupAnimation="Fade">
                        <Border
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource StrokeDefault}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusOverlay}">
                            <ListBox
                                x:Name="LstAutocomplete"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxHeight="290"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="LstAutocomplete_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Margin="6,0,0,0" Padding="4,1" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource AccentTintBrush}" Visibility="{Binding CategoryBadgeVisibility}">
                                                    <TextBlock Text="Category" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Integrated Action Buttons with dynamic hover expansion -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    x:Name="BtnShopProfit"
                    Style="{StaticResource ActionToolbarButton}"
                    Click="BtnShopProfit_Click"
                    ToolTip="{DynamicResource UiFindProfitableShopTrades}"
                    AutomationProperties.Name="{DynamicResource UiFindProfitableShopTrades}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Money20" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource UiProfit}" Style="{StaticResource HoverTextOnlyOnParentHover}"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BtnShopBuyX"
                    Style="{StaticResource ActionToolbarButton}"
                    Click="BtnShopBuyX_Click"
                    ToolTip="{DynamicResource UiFindWhereToBuyAnItem}"
                    AutomationProperties.Name="{DynamicResource UiFindWhereToBuyAnItem}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShoppingBag20" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource UiBuyX}" Style="{StaticResource HoverTextOnlyOnParentHover}"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="BtnShopAddAlert"
                    Style="{StaticResource ActionToolbarButton}"
                    Margin="0"
                    Click="BtnShopAddAlert_Click"
                    ToolTip="{DynamicResource UiCreateAShopAlert}"
                    AutomationProperties.Name="{DynamicResource UiCreateAShopAlert}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert20" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource UiAlert}" Style="{StaticResource HoverTextOnlyOnParentHover}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Glassy Filter Pill Toggles flowing naturally -->
        <WrapPanel Grid.Row="1" Margin="10,2,10,4" Orientation="Horizontal">
            <Button
                x:Name="TglShopSells"
                Style="{StaticResource GlassyPillButton}"
                Click="TglShopSells_Click"
                Margin="0,0,6,6"
                ToolTip="{DynamicResource UiShowShopsThatSellItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Money20" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource AlertShopSells}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                x:Name="TglShopBuys"
                Style="{StaticResource GlassyPillButton}"
                Click="TglShopBuys_Click"
                Margin="0,0,6,6"
                ToolTip="{DynamicResource UiShowShopsThatBuyItem}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cart20" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource AlertShopBuys}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                x:Name="TglShopHideZero"
                Style="{StaticResource GlassyPillButton}"
                Click="TglShopHideZero_Click"
                Margin="0,0,6,6"
                ToolTip="{DynamicResource UiDonTShowOffersWithoutStock}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="EyeOff20" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource UiHide0Stock}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                x:Name="TglShopHideMonuments"
                Style="{StaticResource GlassyPillButton}"
                Click="TglShopHideMonuments_Click"
                Margin="0,0,0,6"
                ToolTip="Hide shops inside Outpost, Bandit Town, Fishing Villages &amp; Monuments">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BuildingBank20" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Hide Monuments" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Row 2: Sort By & Category Dropdowns (2 Equal Columns) -->
        <Grid Grid.Row="2" Margin="10,2,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="{DynamicResource UiSortBy}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}" Margin="2,0,0,4"/>
                <ComboBox x:Name="CmbSort" SelectionChanged="CmbSort_SelectionChanged" Height="34">
                    <ComboBoxItem Content="{DynamicResource UiDefault}" Tag="default" IsSelected="True"/>
                    <ComboBoxItem Content="{DynamicResource UiPriceLowToHigh}" Tag="price_asc"/>
                    <ComboBoxItem Content="{DynamicResource UiPriceHighToLow}" Tag="price_desc"/>
                    <ComboBoxItem Content="{DynamicResource Stock}" Tag="stock"/>
                    <ComboBoxItem Content="{DynamicResource UiCurrency}" Tag="currency"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock Text="Category" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}" Margin="2,0,0,4"/>
                <ComboBox x:Name="CmbCategory" SelectionChanged="CmbCategory_SelectionChanged" Height="34">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Row 3: Payment Resource Filter -->
        <Grid Grid.Row="3" Margin="10,0,10,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource UiPaymentResource}" Foreground="{DynamicResource TextSecondary}" FontSize="{DynamicResource TypeCaption}" Margin="2,0,0,4"/>
                <ComboBox x:Name="CmbResource" SelectionChanged="CmbResource_SelectionChanged" Height="34">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Row 4: Collapsible Active Item Alerts Widget Header -->
        <Border
            Grid.Row="4"
            Margin="10,2,10,2"
            Background="{DynamicResource FillInset}"
            BorderBrush="{DynamicResource StrokeDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusControl}"
            Cursor="Hand"
            Padding="0"
            MouseDown="AlertHdr_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Glowing Amber Left Accent Bar -->
                <Border
                    Grid.Column="0"
                    Width="4"
                    Background="{DynamicResource StatusWarning}"
                    CornerRadius="3,0,0,3"
                    Height="24"
                    VerticalAlignment="Stretch" />

                <Border Grid.Column="1" Padding="10,5">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AlertUrgent20" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource StatusWarning}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource UiActiveItemAlerts}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:SymbolIcon
                            x:Name="TxtAlertArrow"
                            Symbol="ChevronDown16"
                            FontSize="16"
                            Foreground="{DynamicResource TextSecondary}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Row 5: Collapsible Item Alerts List Panel -->
        <Border
            x:Name="BrdAlertListContainer"
            Grid.Row="5"
            Margin="10,0,10,4"
            Background="{DynamicResource FillInset}"
            BorderBrush="{DynamicResource StrokeDefault}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,4,4"
            Visibility="Collapsed">
            <ListBox
                x:Name="LstItemAlerts"
                MaxHeight="120"
                Background="Transparent"
                BorderThickness="0"
                Padding="6"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- Rebuilt dynamically in code-behind -->
            </ListBox>
        </Border>

        <!-- Row 6: Redesigned Scrollable Shop Results -->
        <ScrollViewer
            Grid.Row="6"
            Margin="10,4,10,6"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ShopSearchResultsContainer" />
        </ScrollViewer>
    </Grid>
</UserControl>
