<UserControl x:Class="RustPlusDesk.Views.AppSettingsOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:RustPlusDesk.Controls" xmlns:conv="clr-namespace:RustPlusDesk.Converters" xmlns:p="clr-namespace:RustPlusDesk.Properties" xmlns:views="clr-namespace:RustPlusDesk.Views" xmlns:windows="clr-namespace:RustPlusDesk.Views.Windows" xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials" mc:Ignorable="d" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" tutorials:Tutorial.TargetId="Settings.Panel">

    <Grid ClipToBounds="True">
        <Grid.Resources>
            <conv:NotNullToBoolConverter x:Key="LocalNotNull" />
            <!-- The rows here give dropdowns a fixed 30-32 px; WPF-UI's own vertical padding then
                 cuts off the bottom of the text, so it gets a little less of it. -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Padding" Value="10,4,10,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsMenuItem" TargetType="ui:ListViewItem">
                <Setter Property="Margin" Value="12,0,12,8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SettingsNativeCard" TargetType="ui:Card">
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="SettingsRowDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{DynamicResource CardBorder}" />
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>
            <Style x:Key="SettingsSubheader" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>

            <!-- Connected Services cards -->
            <Style x:Key="ServiceGroupHint" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,-4,0,10" />
            </Style>
            <Style x:Key="ServiceTitle" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ServiceDescription" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,8,0,2" />
            </Style>
            <Style x:Key="ServiceCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="ServiceExpander" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="ContentPadding" Value="12,10" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- Status chip; the colour and text come from SetServiceChip in code -->
            <Style x:Key="ServiceChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="8,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#2A2F37" />
                <Setter Property="TextElement.FontSize" Value="11" />
            </Style>
            <Style x:Key="SupporterLock" TargetType="Border">
                <Setter Property="Background" Value="#3A2E15" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="StepBadge" TargetType="Border">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="#16354A" />
                <Setter Property="TextElement.FontSize" Value="11" />
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                <Setter Property="TextElement.Foreground" Value="#60CDFF" />
                <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Style.Resources>
            </Style>
            <Style x:Key="UsageTile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Surface}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
            <Style x:Key="UsageBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="MinHeight" Value="3" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="Background" Value="{DynamicResource CardBorder}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceAlt}" Padding="12,12,8,4">
            <controls:PanelHeader IsCompact="True"
                                  Symbol="Settings24"
                                  Title="{DynamicResource Settings}"
                                  CloseClick="BtnCloseSettings_Click" />
        </Border>

        <Border Grid.Row="1" Padding="12,10,12,8" Background="{DynamicResource SurfaceAlt}">
            <ui:TextBox x:Name="SettingsSearchBox" Height="34" ClearButtonEnabled="True" PlaceholderText="{DynamicResource UiSearchSettings}" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource UiSearchSettings}" TextChanged="SettingsSearchBox_TextChanged">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="SettingsCategoryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,14,16,12">
                    <ui:TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource UiChooseACategory}" />
                    <ui:TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiSettingsAreGroupedByWhatTheyControl}" />
                </StackPanel>
                <ui:ListView x:Name="SettingsCategoryList" Grid.Row="1" Padding="0,2,0,8" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsMenuItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsCategoryList_SelectionChanged">
                    <ui:ListViewItem Tag="general">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource General}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiLanguageStartupAndAppBehavior}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="alerts">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Alert24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource Alerts}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiNotificationsSoundsAndOfflineDeath}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="chat-commands">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Chat24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource ChatCommandsSettings}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="Configure team chat commands and device bindings" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="alert-templates">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Edit24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource CustomAlertsHeader}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource CustomAlertsDesc}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="ai-companion">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Bot24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource AiCompanionTitle}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource AiCompanionCategoryDesc}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="map">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource UiMap}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiPerformanceMarkersAnd3DData}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="connected">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Cloud24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource UiConnectedServices}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiCloudDiscordAlexaChatAndSteam}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                    <ui:ListViewItem Tag="system">
                        <ui:Card MinHeight="58" Padding="12,9" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowReset24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"><ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource UiSystem}" /><ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="{DynamicResource UiMaintenanceBackupResetAndCredits}" TextWrapping="Wrap" /></StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                            </Grid>
                        </ui:Card>
                    </ui:ListViewItem>
                </ui:ListView>
            </Grid>

            <Grid x:Name="SettingsDetailPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Padding="10,9" Background="#FF15191E" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ui:Button Width="30" Height="30" Margin="0,0,10,0" Padding="0" Appearance="Transparent" ToolTip="{DynamicResource UiBackToSettingsCategories}" Click="SettingsBack_Click"><ui:SymbolIcon Symbol="ArrowLeft24" /></ui:Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="SettingsDetailTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <ui:TextBlock x:Name="SettingsDetailSubtitle" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Jump-to chips. A wrap of pills rather than a full-width list, so a category
                     with many sections does not push its settings below the fold. -->
                <ListBox x:Name="SettingsSectionList" Grid.Row="1" Margin="10,8,10,2" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="SettingsSectionList_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Pill" Padding="10,3" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <ScrollViewer x:Name="SettingsSearchResultsScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="SettingsSearchResults" Margin="12,12,12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button MinHeight="54" Margin="0,0,0,8" Padding="12,8" HorizontalContentAlignment="Stretch" Appearance="Secondary" Tag="{Binding}" Click="SettingsSearchResult_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding BeforeMatch}" /><Run Background="#FF60CDFF" Foreground="#FF071218" FontWeight="Bold" Text="{Binding Match}" /><Run Text="{Binding AfterMatch}" />
                                        </ui:TextBlock>
                                        <ui:TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}"><Run Text="{Binding CategoryTitle}" /><Run Text="  ›  " /><Run Text="{Binding SectionTitle}" /></ui:TextBlock>
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronRight24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" />
                                </Grid>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsSectionsPanel" Margin="12">
                <!-- General Section -->
                <StackPanel x:Name="SectionGeneral">
                <ui:TextBlock Text="{DynamicResource General}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Language -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource Language}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Select application display language" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" tutorials:Tutorial.TargetId="Settings.Language" Width="160" Height="32" SelectedValuePath="Code" SelectionChanged="CmbLanguage_SelectionChanged" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Settings24" Width="20" Height="15" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource TextSubtle}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <Image Source="{Binding ImagePath}" Width="20" Height="15" Margin="0,0,8,0" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <ui:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Automatic Updates -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource AutomaticUpdates}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource AutomaticUpdatesToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoUpdate" AutomationProperties.Name="{DynamicResource AutomaticUpdates}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource AutomaticUpdatesToolTip}" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Launch With Windows -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource LaunchWithWindows}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Automatically start Rust+ Desktop when Windows starts" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoStart" AutomationProperties.Name="{DynamicResource LaunchWithWindows}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Start Minimized -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource StartMinimizedAlways}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Launch the application hidden in the system tray" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkStartMinimized" AutomationProperties.Name="{DynamicResource StartMinimizedAlways}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Auto Connect -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource AutoConnectLastServer}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource AutoConnectToolTip}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAutoConnect" AutomationProperties.Name="{DynamicResource AutoConnectLastServer}" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged" ToolTip="{DynamicResource AutoConnectToolTip}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Behavior Section -->
                <StackPanel x:Name="SectionBehavior">
                <ui:TextBlock Text="{DynamicResource Behavior}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Group 1: Window & Interface -->
                        <ui:TextBlock Text="Window &amp; Interface" Style="{StaticResource SettingsSubheader}" />

                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
