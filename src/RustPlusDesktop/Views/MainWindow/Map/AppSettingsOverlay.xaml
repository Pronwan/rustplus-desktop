                        </Grid>
                        <ui:TextBlock x:Name="TxtCustomMapStatus" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                </StackPanel>


                <!-- Team Markers Section -->
                <StackPanel x:Name="SectionTeamMarkers">
                <ui:TextBlock Text="{DynamicResource TeamMarkersSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- Profile Markers -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <Ellipse Width="38" Height="38" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource Profile}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Show circular team member markers on the map" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowProfileMarkers" AutomationProperties.Name="{DynamicResource Profile}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Player Direction Arrows -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="18" Height="18" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <Path Data="M 20,4 L 32,32 L 8,32 Z" Fill="LimeGreen" Stroke="Black" StrokeThickness="2" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource PlayerDirectionArrow}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Show direction cone pointing where players are facing" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowPlayerArrows" AutomationProperties.Name="{DynamicResource PlayerDirectionArrow}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Death Markers -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Viewbox Width="16" Height="20" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center">
                                    <Grid Width="40" Height="56">
                                        <Path Data="M20,0 C31,0 40,9 40,20 C40,33 20,56 20,56 C20,56 0,33 0,20 C0,9 9,0 20,0 Z" Fill="IndianRed" Stroke="Black" StrokeThickness="2" Stretch="Fill" />
                                    </Grid>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{DynamicResource Death}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="Display tombstone markers at death locations" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkShowDeathMarkers" AutomationProperties.Name="{DynamicResource Death}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <!--  How many markers each player keeps. The same two numbers as the
                              dialog behind the map's own death-marker button; they were only
                              reachable from there, which is a long way from the map settings
                              somebody goes looking in.  -->
                        <Grid MinHeight="36" Margin="28,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="{DynamicResource DeathMarkerKeepPerPlayer}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="{DynamicResource DeathMarkerKeepHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock Text="{DynamicResource DeathMarkerKeepSelf}" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:NumberBox x:Name="NumMaxSelfDeathMarkers" Minimum="1" Maximum="50" SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" Width="88" ValueChanged="OnDeathMarkerCapChanged" />
                                <ui:TextBlock Text="{DynamicResource DeathMarkerKeepTeam}" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <ui:NumberBox x:Name="NumMaxTeamDeathMarkers" Minimum="1" Maximum="50" SpinButtonPlacementMode="Compact" ClearButtonEnabled="False" Width="88" ValueChanged="OnDeathMarkerCapChanged" />
                            </StackPanel>
                        </Grid>

                        <!--  The other half of the map's death-marker gear dialog.  -->
                        <Grid MinHeight="36" Margin="28,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Text="{DynamicResource WipeDeathMarkersHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                            <ui:Button Grid.Column="1" Content="{DynamicResource WipeDeathMarkers}" Appearance="Danger" VerticalAlignment="Center" Click="BtnWipeDeathMarkers_Click" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Streamer Mode -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource StreamerMode}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Hide player names on the map overlay" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkStreamerModeMarkers" AutomationProperties.Name="{DynamicResource StreamerMode}" VerticalAlignment="Center" Checked="OnMarkerSettingChanged" Unchecked="OnMarkerSettingChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!-- Player Icon Scale -->
                        <Grid MinHeight="36" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="65" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource ScaleLabel}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                <ui:TextBlock Text="Adjust size of marker icons on the map" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="SliderPlayerIconScaleOverlay" Minimum="0.5" Maximum="1.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnMarkerSettingChanged" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:TextBlock Text="{Binding Value, ElementName=SliderPlayerIconScaleOverlay, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Medium" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SettingsRowDivider}" />

                        <!--  Command Dock defaults. These are what a tile uses until its own
                              gear is touched — not a second switch for the same thing, which
                              would leave two places disagreeing about one value.  -->
                        <ui:CardExpander x:Name="CardCommandDock" Header="{DynamicResource CommandDockTitle}" tutorials:Tutorial.TargetId="Settings.CommandDock" Margin="0,6,0,0" Foreground="{DynamicResource TextPrimary}" ContentPadding="12,8">
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBlock Text="{DynamicResource CommandDockDefaultsHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Grid MinHeight="36" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{DynamicResource CommandDockDefaultOpacity}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Slider Grid.Column="1" x:Name="SliderDockOpacity" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnCommandDockDefaultChanged" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Value, ElementName=SliderDockOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </Grid>

                                <Grid MinHeight="36" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="65" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{DynamicResource CommandDockDefaultFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Slider Grid.Column="1" x:Name="SliderDockFontScale" Minimum="0.7" Maximum="2.0" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OnCommandDockDefaultChanged" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Value, ElementName=SliderDockFontScale, StringFormat={}{0:P0}}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </Grid>

                                <Grid MinHeight="36" Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="{DynamicResource CommandDockTileTextColor}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <WrapPanel Grid.Column="1" x:Name="DockColorSwatches" VerticalAlignment="Center" />
                                </Grid>

                                <ui:Button x:Name="BtnResetCommandDock"
                                           Content="{DynamicResource CommandDockReset}"
                                           Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                           Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Height="34"
                                           Click="BtnResetCommandDock_Click" />
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!--
                    Connected Services. Grouped by what the user is trying to do rather than by backend:
                    accounts first (the two are separate and the page says so), then cloud features,
                    alerts while the app is closed, Discord, smart home, and the wipe tracker.
                    Every integration is one card: what it does, a status chip, and its setup inside.
                    The chips and the Supporter locks are driven from AppSettingsOverlay.ConnectedServices.cs.
                -->

                <!-- Accounts: RustPlus Desktop's own cloud account -->
                <StackPanel x:Name="SectionCloud" tutorials:Tutorial.TargetId="Settings.Cloud">
                <ui:TextBlock x:Name="CloudSettingsAnchor" Text="{DynamicResource CsAccountsTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:TextBlock Style="{StaticResource ServiceGroupHint}" Text="{DynamicResource CsAccountsHint}" />

                <ui:Card Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="20" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Accent}" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsCloudAccountTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsCloudAccountDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipCloudAccount" Grid.Column="2" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>

                        <!-- Sign-in: Discord over Email, stacked so neither label is cut at panel width -->
                        <Grid Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:Button x:Name="BtnDiscordConnect" Grid.Row="0" HorizontalAlignment="Stretch" Height="34" Click="BtnDiscordConnect_Click">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="pack://application:,,,/Assets/icons/discord.png" />
                                </ui:Button.Icon>
                                <ui:TextBlock x:Name="TxtDiscordBtnLabel" Text="{DynamicResource CloudLoginPromptDiscordButton}" TextTrimming="CharacterEllipsis" />
                            </ui:Button>
                            <ui:Button x:Name="BtnEmailConnect" Grid.Row="2" Icon="{ui:SymbolIcon Symbol=Mail24}" Content="{DynamicResource CloudLoginPromptEmailButton}" HorizontalAlignment="Stretch" Height="34" Click="BtnEmailConnect_Click" />
                        </Grid>

                        <ui:TextBlock x:Name="TxtAuthStatus" FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,4,0,0" Text="{DynamicResource UiNotConnected}" />

                        <!-- Plan usage, one meter per limit -->
                        <Grid x:Name="PnlCloudUsage" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UsageTile}">
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{DynamicResource CsUsageOverlay}" />
                                    <ui:TextBlock x:Name="TxtUsageOverlay" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="BarUsageOverlay" Style="{StaticResource UsageBar}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource UsageTile}">
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{DynamicResource CsUsageDevices}" />
                                    <ui:TextBlock x:Name="TxtUsageDevices" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="BarUsageDevices" Style="{StaticResource UsageBar}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource UsageTile}">
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{DynamicResource CsUsageBases}" />
                                    <ui:TextBlock x:Name="TxtUsageBases" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="BarUsageBases" Style="{StaticResource UsageBar}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ui:Button
                            Content="{DynamicResource UiUpgradeToSupporter}"
                            Icon="{ui:SymbolIcon Symbol=Star24}"
                            Appearance="Primary"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="{DynamicResource UiUpgradeToSupporter}"
                            Click="BtnUpgradeSupporter_Click">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Accounts: Facepunch's Rust+ companion pairing, which RustPlus Desktop does not own -->
                <StackPanel x:Name="SectionSteamAccount">
                <ui:Card Style="{StaticResource ServiceCard}" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Phone24" FontSize="20" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSubtle}" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsRustPlusAccountTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsRustPlusAccountDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipRustPlusAccount" Grid.Column="2" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                        <ui:TextBlock x:Name="TxtRustPlusPairingStatus" Style="{StaticResource ServiceDescription}" Margin="30,8,0,0" />
                        <ui:TextBlock Margin="30,4,0,0" Text="{DynamicResource ManageSteamAccountInfo}" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Cloud features that ride on the RustPlus Desktop account -->
                <StackPanel x:Name="SectionCloudFeatures">
                <ui:TextBlock Text="{DynamicResource CsCloudFeaturesTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:TextBlock Style="{StaticResource ServiceGroupHint}" Text="{DynamicResource CsCloudFeaturesHint}" />

                <ui:Card Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="20" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSubtle}" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource Cloud247Title}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsCloud247Desc}" />
                            </StackPanel>
                            <Border x:Name="ChipCloud247" Grid.Column="2" Style="{StaticResource ServiceChip}" ToolTip="Cloud 24/7 is an experimental and time-limited feature that may be modified or removed at any time."><TextBlock /></Border>
                        </Grid>
                        <TextBlock x:Name="TxtCloud247StatusNote" FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="30,6,0,0" Visibility="Collapsed" />
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnCloud247" Content="{DynamicResource CsCloud247Action}" AutomationProperties.Name="{DynamicResource Cloud247Title}" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Cloud24}" HorizontalAlignment="Stretch" Click="BtnCloud247_Click" />
                            <ui:Button Grid.Column="2" Content="{DynamicResource CsCompareFeaturesShort}" AutomationProperties.Name="{DynamicResource CompareCloudFeatures}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Info24}" HorizontalAlignment="Stretch" Click="BtnCompareCloud_Click" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  Global chat. Lives with the cloud account because that is what the room runs on:
                      no account, no room — and this is where somebody who turned the strip off would
                      come looking for it.  -->
                <ui:CardExpander Style="{StaticResource ServiceExpander}" AutomationProperties.Name="{DynamicResource CsGlobalChatTitle}" Icon="{ui:SymbolIcon Symbol=Globe24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsGlobalChatTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsGlobalChatDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipGlobalChat" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <CheckBox x:Name="ChkGlobalChatTicker"
                                  Content="{DynamicResource GlobalChatTickerSetting}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Checked="OnGlobalChatTickerToggled"
                                  Unchecked="OnGlobalChatTickerToggled" />
                        <ui:TextBlock Text="{DynamicResource GlobalChatTickerSettingHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="26,2,0,4" />
                    </StackPanel>
                </ui:CardExpander>
                </StackPanel>

                <!-- Alerts while the app is closed (Supporter) -->
                <StackPanel x:Name="SectionOfflineAlerts">
                <ui:TextBlock Text="{DynamicResource CsOfflineGroupTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8" />
                <ui:TextBlock Style="{StaticResource ServiceGroupHint}" Text="{DynamicResource CsOfflineGroupHint}" />

                <ui:CardExpander x:Name="CardOfflineAlerts" Style="{StaticResource ServiceExpander}" tutorials:Tutorial.TargetId="Settings.OfflineAlerts" AutomationProperties.Name="{DynamicResource CsOfflineAlertsTitle}" Icon="{ui:SymbolIcon Symbol=AlertUrgent24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsOfflineAlertsTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsOfflineAlertsDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipOfflineAlerts" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Border x:Name="LockOfflineAlerts" Style="{StaticResource SupporterLock}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#F0B75E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource CsUpgradeShort}" Icon="{ui:SymbolIcon Symbol=Star24}" Appearance="Caution" Height="28" Padding="8,0" Margin="8,0,0,0" Click="BtnUpgradeSupporter_Click" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PnlOfflineAlertsBody">
                            <!-- Step 1: give the cloud the Rust+ push credentials -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" /></Border>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource CsOfflineStep1}" TextWrapping="Wrap" />
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Click="BtnFcmHelp_Click" Appearance="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" ToolTip="{DynamicResource UiWebhookInfo}" VerticalAlignment="Top" />
                                    </Grid>
                                    <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource UiSyncYourRustConnectionToTheCloudToReceiveSmartRaidEventAleFE6557D858}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <ui:Button x:Name="BtnSyncFcm" Content="{DynamicResource UiSyncCloudConnection}" Icon="{ui:SymbolIcon Symbol=CloudArrowUp24}" Appearance="Primary" Click="BtnSyncFcm_Click" Margin="0,0,8,4" />
                                        <ui:Button x:Name="BtnRevokeFcm" Content="{DynamicResource UiRevokeAccess}" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnRevokeFcm_Click" Appearance="Secondary" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Step 2: where the cloud should send them -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource CsOfflineStep2}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiDiscordWebhookURLOfflineAlerts}" />
                                    <ui:TextBox x:Name="TxtDiscordWebhookUrl" Height="28" Padding="6,4" VerticalAlignment="Center" TextChanged="TxtDiscordWebhookUrl_TextChanged" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <ui:TextBlock Text="{DynamicResource UiOptionalPings}" Foreground="{DynamicResource TextSubtle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <CheckBox x:Name="ChkFcmMentionEveryone" Content="{DynamicResource UiEveryone}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,0" Checked="ChkFcmMention_Changed" Unchecked="ChkFcmMention_Changed" />
                                        <CheckBox x:Name="ChkFcmMentionHere" Content="{DynamicResource UiHere}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Checked="ChkFcmMention_Changed" Unchecked="ChkFcmMention_Changed" />
                                    </WrapPanel>
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiSmartHomeWebhookURLEGIFTTTAlexaGoogle}" />
                                    <ui:TextBox x:Name="TxtSmartHomeWebhookUrl" Height="28" Padding="6,4" VerticalAlignment="Center" TextChanged="TxtSmartHomeWebhookUrl_TextChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander x:Name="CardTelegramCall" Style="{StaticResource ServiceExpander}" AutomationProperties.Name="{DynamicResource CsTelegramTitle}" Icon="{ui:SymbolIcon Symbol=Call24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsTelegramTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsTelegramDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipTelegram" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Border x:Name="LockTelegram" Style="{StaticResource SupporterLock}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#F0B75E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource CsUpgradeShort}" Icon="{ui:SymbolIcon Symbol=Star24}" Appearance="Caution" Height="28" Padding="8,0" Margin="8,0,0,0" Click="BtnUpgradeSupporter_Click" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PnlTelegramBody">
                            <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsTelegramHint}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiUsernameEGBrunhilde}" />
                                    <ui:TextBox x:Name="TxtTelegramUser" Height="28" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiTTSLanguage}" />
                                    <ComboBox x:Name="CmbTelegramLang" Height="28" SelectedIndex="0" VerticalContentAlignment="Center" Padding="8,4,0,0">
                                        <ComboBoxItem Content="{DynamicResource UiDeDEStandardA}" Tag="de-DE-Standard-A" />
                                        <ComboBoxItem Content="{DynamicResource UiEnUSStandardA}" Tag="en-US-Standard-A" />
                                        <ComboBoxItem Content="{DynamicResource UiEnGBStandardA}" Tag="en-GB-Standard-A" />
                                        <ComboBoxItem Content="{DynamicResource UiEsESStandardA}" Tag="es-ES-Standard-A" />
                                        <ComboBoxItem Content="{DynamicResource UiFrFRStandardA}" Tag="fr-FR-Standard-A" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource ChatMessagePlaceholder}" />
                            <ui:TextBox x:Name="TxtTelegramMsg" Height="28" Padding="6,4" Text="{DynamicResource UiAlarmAusgeloest}" />

                            <WrapPanel Margin="0,8,0,4">
                                <CheckBox x:Name="ChkTelegramIncTitle" Content="{DynamicResource UiIncludeNameTitle}" IsChecked="True" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,4" />
                                <CheckBox x:Name="ChkTelegramIncMsg" Content="{DynamicResource UiIncludeMessageMessage}" IsChecked="True" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,4" />
                                <CheckBox x:Name="ChkTelegramIncType" Content="{DynamicResource UiIncludeTypeType}" IsChecked="False" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,0,4" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,4">
                                <ui:Button x:Name="BtnGenerateTelegramUrl" Content="{DynamicResource UiGenerateSave}" Appearance="Primary" Click="BtnGenerateTelegramUrl_Click" Margin="0,0,8,4" Height="28" Padding="10,0" />
                                <ui:Button x:Name="BtnTestTelegramUrl" Content="{DynamicResource UiTestCall}" Click="BtnTestTelegramUrl_Click" Margin="0,0,8,4" Height="28" Padding="10,0" Appearance="Secondary" Visibility="Collapsed" />
                                <ui:Button x:Name="BtnRevokeTelegramUrl" Content="{DynamicResource UiRevoke}" Click="BtnRevokeTelegramUrl_Click" Margin="0,0,0,4" Height="28" Padding="10,0" Appearance="Danger" Visibility="Collapsed" />
                            </WrapPanel>

                            <ui:TextBox x:Name="TxtGeneratedTelegramUrl" Height="28" Foreground="{DynamicResource TextSubtle}" Padding="6,4" VerticalAlignment="Center" IsReadOnly="True" Opacity="0.7" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
                </StackPanel>

                <!-- Discord -->
                <StackPanel x:Name="SectionDiscord">
                <ui:TextBlock Text="{DynamicResource CsDiscordGroupTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8" />
                <ui:TextBlock Style="{StaticResource ServiceGroupHint}" Text="{DynamicResource CsDiscordGroupHint}" />

                <ui:CardExpander x:Name="CardDiscordWebhook" Style="{StaticResource ServiceExpander}" tutorials:Tutorial.TargetId="Settings.DiscordBasic" IsEnabled="{Binding IsCloudConnected}" AutomationProperties.Name="{DynamicResource CsDiscordWebhookTitle}" Icon="{ui:SymbolIcon Symbol=Chat24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsDiscordWebhookTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsDiscordWebhookDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipDiscordWebhook" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="{DynamicResource UiDiscordWebhookChatAlerts}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtSettingsDiscordWebhook" Height="28" Padding="6,4" IsEnabled="{Binding Selected, Converter={StaticResource LocalNotNull}}" Text="{Binding Selected.DiscordWebhookChatAlertsUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="TxtSettingsDiscordWebhook_TextChanged" />
                            <ui:Button x:Name="BtnClearSettingsWebhook" Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="BtnClearSettingsWebhook_Click" Appearance="Transparent" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" ToolTip="{DynamicResource UiClearWebhookURL}" IsEnabled="{Binding Selected, Converter={StaticResource LocalNotNull}}" />
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Click="BtnDiscordWebhookHelp_Click" Appearance="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0" Padding="4,0" Margin="2,0,0,0" ToolTip="{DynamicResource UiDiscordWebhooksGuide}" />
                        </Grid>
                        <ui:TextBlock x:Name="TxtDiscordWebhookNoServer" Style="{StaticResource ServiceDescription}" Margin="0,4,0,0" Text="{DynamicResource CsDiscordWebhookNoServer}" Visibility="Collapsed" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:ToggleSwitch Content="{DynamicResource UiTTS}" IsChecked="{Binding Selected.DiscordWebhookChatAlertsTts, Mode=TwoWay}" Margin="0,0,16,4" Foreground="{DynamicResource TextPrimary}" ToolTip="{DynamicResource UiTextToSpeechForWebhook}" IsEnabled="{Binding Selected, Converter={StaticResource LocalNotNull}}" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Content="{DynamicResource UiDiscordWebhookExclusive}" IsChecked="{Binding Selected.DiscordWebhookChatAlertsExclusive, Mode=TwoWay}" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}" IsEnabled="{Binding Selected, Converter={StaticResource LocalNotNull}}" VerticalAlignment="Center">
                                <ui:ToggleSwitch.ToolTip>
                                    <ToolTip Background="#1F232A" BorderBrush="#3A404D" BorderThickness="1" Padding="8,6">
                                        <TextBlock Text="{DynamicResource UiDiscordWebhookExclusiveTooltip}" MaxWidth="240" TextWrapping="Wrap" Foreground="#E1E4EA" FontSize="11" />
                                    </ToolTip>
                                </ui:ToggleSwitch.ToolTip>
                            </ui:ToggleSwitch>
                        </WrapPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander x:Name="CardDiscordBot" Style="{StaticResource ServiceExpander}" tutorials:Tutorial.TargetId="Settings.DiscordAdvanced" AutomationProperties.Name="{DynamicResource CsDiscordBotTitle}" Icon="{ui:SymbolIcon Symbol=Bot24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsDiscordBotTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsDiscordBotDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipDiscordBot" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Border x:Name="LockDiscordBot" Style="{StaticResource SupporterLock}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#F0B75E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource CsUpgradeShort}" Icon="{ui:SymbolIcon Symbol=Star24}" Appearance="Caution" Height="28" Padding="8,0" Margin="8,0,0,0" Click="BtnUpgradeSupporter_Click" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PnlDiscordBotBody">
                            <!-- Step 1: invite -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource CsBotStep1}" TextWrapping="Wrap" />
                                    <ui:Button x:Name="BtnInviteDiscordBot" tutorials:Tutorial.TargetId="Settings.Discord" Content="{DynamicResource UiInviteDiscordBotToServer}" Icon="{ui:SymbolIcon Symbol=Add24}" Appearance="Primary" Margin="0,6,0,0" PreviewMouseDown="PremiumFeature_PreviewMouseDown" Click="BtnInviteDiscordBot_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 2: which server -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource CsBotStep2}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiDiscordServerIDGuildID}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtDiscordGuildId" Height="28" Padding="6,4" VerticalAlignment="Center" />
                                        <ui:Button x:Name="BtnSaveDiscordGuild" Grid.Column="1" Content="{DynamicResource Save}" Margin="8,0,0,0" MinWidth="70" Height="28" Click="BtnSaveDiscordGuild_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Step 3: who may run commands -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource UiCommandPermissions}" TextWrapping="Wrap" />
                                    <CheckBox x:Name="ChkDiscordCommandsEnabled" Content="{DynamicResource UiAllowDiscordCommands}" IsChecked="True" Margin="0,4,0,2" />
                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiAllowedCommandRoleIDs}" />
                                    <ui:TextBox x:Name="TxtDiscordAllowedRoleIds" Height="28" Padding="6,3" PlaceholderText="{DynamicResource UiCommaSeparatedRoleIDs}" ToolTip="{DynamicResource UiLeaveEmptyToAllowEveryoneOnTheServer}" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 4: alert channels -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="4" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource UiChannelNotificationsConfig}" TextWrapping="Wrap" />

                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiRaidAlertsChannelID}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtChannelRaid" Height="28" Padding="6,3" ToolTip="{DynamicResource UiChannelID}" />
                                        <CheckBox x:Name="ChkRaidTTS" Grid.Column="1" Content="{DynamicResource UiTTS}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox x:Name="ChkChannelRaidEveryone" Content="{DynamicResource UiEveryone}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,0" />
                                        <CheckBox x:Name="ChkChannelRaidHere" Content="{DynamicResource UiHere}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                    </WrapPanel>

                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiEventsAlertsChannelID}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtChannelEvents" Height="28" Padding="6,3" ToolTip="{DynamicResource UiChannelID}" />
                                        <CheckBox x:Name="ChkEventsTTS" Grid.Column="1" Content="{DynamicResource UiTTS}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox x:Name="ChkChannelEventsEveryone" Content="{DynamicResource UiEveryone}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,0" />
                                        <CheckBox x:Name="ChkChannelEventsHere" Content="{DynamicResource UiHere}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                    </WrapPanel>

                                    <ui:TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource UiChatAlertsChannelID}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtChannelChat" Height="28" Padding="6,3" ToolTip="{DynamicResource UiChannelID}" />
                                        <CheckBox x:Name="ChkChatTTS" Grid.Column="1" Content="{DynamicResource UiTTS}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Margin="0,2,0,0">
                                        <CheckBox x:Name="ChkChannelChatEveryone" Content="{DynamicResource UiEveryone}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,0" />
                                        <CheckBox x:Name="ChkChannelChatHere" Content="{DynamicResource UiHere}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                    </WrapPanel>

                                    <!--  Shop Alerts Channel — disabled on servers that no longer deliver
                                          vending data, so it is visibly dead rather than silently unused.  -->
                                    <ui:TextBlock x:Name="ShopChannelLabel" Style="{StaticResource FieldLabel}" Text="{DynamicResource UiShopAlertsChannelID}" />
                                    <StackPanel x:Name="ShopChannelRow">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="TxtChannelShop" Height="28" Padding="6,3" ToolTip="{DynamicResource UiChannelID}" />
                                            <CheckBox x:Name="ChkShopTTS" Grid.Column="1" Content="{DynamicResource UiTTS}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <WrapPanel Margin="0,2,0,0">
                                            <CheckBox x:Name="ChkChannelShopEveryone" Content="{DynamicResource UiEveryone}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,12,0" />
                                            <CheckBox x:Name="ChkChannelShopHere" Content="{DynamicResource UiHere}" Foreground="{DynamicResource TextSubtle}" FontSize="11" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <ui:Button x:Name="BtnSaveChannels" Content="{DynamicResource UiSaveChannelsConfig}" Appearance="Primary" HorizontalAlignment="Stretch" Height="30" Margin="0,12,0,0" Click="BtnSaveChannels_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
                </StackPanel>

                <!-- Smart home (Supporter) -->
                <StackPanel x:Name="SectionSmartHome">
                <ui:TextBlock Text="{DynamicResource CsSmartHomeGroupTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8" />
                <ui:TextBlock Style="{StaticResource ServiceGroupHint}" Text="{DynamicResource CsSmartHomeGroupHint}" />

                <ui:CardExpander x:Name="CardAlexa" Style="{StaticResource ServiceExpander}" tutorials:Tutorial.TargetId="Settings.Alexa" AutomationProperties.Name="{DynamicResource CsAlexaTitle}" Icon="{ui:SymbolIcon Symbol=Mic24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsAlexaTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsAlexaDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipAlexa" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Border x:Name="LockAlexa" Style="{StaticResource SupporterLock}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#F0B75E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource CsUpgradeShort}" Icon="{ui:SymbolIcon Symbol=Star24}" Appearance="Caution" Height="28" Padding="8,0" Margin="8,0,0,0" Click="BtnUpgradeSupporter_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TxtAlexaStatusNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Padding="8,6" Margin="0,0,0,10" Background="#3A2A15" Foreground="#F0B75E" />
                        <StackPanel x:Name="PnlAlexaBody">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource UiControlYourRustSmartSwitchesWithAmazonAlexaVoiceCommandsAn5B51481980}" />
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Click="BtnAlexaHelp_Click" Appearance="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" ToolTip="{DynamicResource UiAlexaSetupInfo}" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Step 1: link the account in the Alexa app with a PIN -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource UiAmazonAlexaLogin}" TextWrapping="Wrap" />
                                    <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsAlexaStep1Hint}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnGenerateAlexaPIN" Content="{DynamicResource UiGenerateLoginPIN}" Icon="{ui:SymbolIcon Symbol=Key24}" HorizontalAlignment="Stretch" Height="32" Click="BtnGenerateAlexaPIN_Click" />
                                        <ui:TextBlock x:Name="TxtAlexaPIN" Grid.Column="1" Text="123456" Visibility="Collapsed" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" Foreground="{DynamicResource Accent}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Step 2: pick which server Alexa controls -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="{DynamicResource UiSelectServerToSyncWithAlexa}" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CmbAlexaServer" MinHeight="32" Padding="8,4" Margin="0,6,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnLinkAlexa" Grid.Column="0" Content="{DynamicResource UiLinkSelectedServer}" Icon="{ui:SymbolIcon Symbol=Link24}" Appearance="Primary" HorizontalAlignment="Stretch" Height="32" Click="BtnLinkAlexa_Click" />
                                        <ui:Button x:Name="BtnRevokeAlexa" Grid.Column="2" Content="{DynamicResource UiRevokeAccess}" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Secondary" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Stretch" Height="32" Click="BtnRevokeAlexa_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander x:Name="CardHomeAssistant" Style="{StaticResource ServiceExpander}" AutomationProperties.Name="{DynamicResource CsHomeAssistantTitle}" Icon="{ui:SymbolIcon Symbol=Home24}">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsHomeAssistantTitle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="{DynamicResource CsHomeAssistantDesc}" />
                            </StackPanel>
                            <Border x:Name="ChipHomeAssistant" Grid.Column="1" Style="{StaticResource ServiceChip}"><TextBlock /></Border>
                        </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <Border x:Name="LockHomeAssistant" Style="{StaticResource SupporterLock}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#F0B75E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource CsUpgradeShort}" Icon="{ui:SymbolIcon Symbol=Star24}" Appearance="Caution" Height="28" Padding="8,0" Margin="8,0,0,0" Click="BtnUpgradeSupporter_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TxtHaStatusNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Padding="8,6" Margin="0,0,0,10" Background="#3A2A15" Foreground="#F0B75E" />
                        <StackPanel x:Name="PnlHomeAssistantBody">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="Control your Rust smart switches from Home Assistant using a REST switch. Generate an API token, then add the generated snippet to your configuration.yaml." />
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" Click="BtnHomeAssistantHelp_Click" Appearance="Transparent" Foreground="{DynamicResource Accent}" BorderThickness="0" Padding="4,0" Margin="4,0,0,0" ToolTip="Home Assistant setup info" VerticalAlignment="Top" />
                            </Grid>

                            <!-- Step 1: token -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="API Token" />
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ui:Button x:Name="BtnGenerateHaToken" Content="Generate Token" Icon="{ui:SymbolIcon Symbol=Key24}" Appearance="Primary" HorizontalAlignment="Stretch" Height="32" Click="BtnGenerateHaToken_Click" />
                                        <ui:Button x:Name="BtnCopyHaToken" Grid.Column="1" Content="Copy" Icon="{ui:SymbolIcon Symbol=Copy24}" Height="32" Margin="8,0,0,0" IsEnabled="False" Click="BtnCopyHaToken_Click" />
                                    </Grid>
                                    <ui:TextBox x:Name="TxtHaToken" IsReadOnly="True" Height="28" Padding="6,4" FontFamily="Consolas" PlaceholderText="No token generated yet" />
                                </StackPanel>
                            </Grid>

                            <!-- Step 2: configuration.yaml -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" /></Border>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Style="{StaticResource ServiceTitle}" FontSize="12" Text="Example configuration.yaml" />
                                    <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="Replace SERVERKEY_ENTITYID with a device id from your device list (shown as {host}-{port}_{entityId})." Margin="0,0,0,4" />
                                    <ui:TextBox x:Name="TxtHaSnippet" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="180" Padding="6,4" Margin="0,0,0,8" FontFamily="Consolas" FontSize="11" />
                                    <ui:Button x:Name="BtnCopyHaSnippet" Content="Copy Snippet" Icon="{ui:SymbolIcon Symbol=Copy24}" HorizontalAlignment="Stretch" Height="32" Click="BtnCopyHaSnippet_Click" />
                                </StackPanel>
                            </Grid>

                            <ui:Button x:Name="BtnRevokeHa" Content="Revoke Token" Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Secondary" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Stretch" Height="32" Click="BtnRevokeHa_Click" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
                </StackPanel>

                <!--
                    Player Wipe Tracker. The same two flags as under General. The tracker is a connected
                    service in every practical sense, and someone reviewing what this app sends outward
                    looks here, not under Behaviour. Both copies write the one setting;
                    OnPlayerWipeTrackerToggled keeps them showing the same thing.
                -->
                <StackPanel x:Name="SectionWipeTracker">
                <ui:TextBlock Text="{DynamicResource CsWipeTrackerTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8" />
                <ui:Card Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="20" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSubtle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsWipeTrackerToggle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="Tracks only visible team snapshots while RustPlus Desktop is connected." />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ChkPlayerWipeTrackerConnected" Grid.Column="2" AutomationProperties.Name="Player Wipe Tracker" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Tracks only visible team snapshots while RustPlus Desktop is connected." />
                        </Grid>
                        <Border Style="{StaticResource SettingsRowDivider}" />
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="20" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource TextSubtle}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock Style="{StaticResource ServiceTitle}" Text="{DynamicResource CsWipeTrackerBackupToggle}" />
                                <ui:TextBlock Style="{StaticResource ServiceDescription}" Text="Uploads compact daily tracker documents only after you enable this setting." />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ChkPlayerWipeCloudConnected" Grid.Column="2" AutomationProperties.Name="Player Wipe Tracker cloud backup" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OnPlayerWipeTrackerToggled" Unchecked="OnPlayerWipeTrackerToggled" ToolTip="Uploads compact daily tracker documents only after you enable this setting." />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- AI Companion Section -->
                <StackPanel x:Name="SectionAiCompanion" tutorials:Tutorial.TargetId="Settings.AiCompanion">
                    <ui:TextBlock Text="{DynamicResource AiCompanionTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                    <ui:Card Style="{StaticResource SettingsNativeCard}">
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource AiCompanionIntro}" Foreground="{DynamicResource TextSubtle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!--  The way in for anyone who has never made an API key. Loud until a key
                                  exists, then a quiet row for running it again.  -->
                            <Border x:Name="AiSetupBanner" CornerRadius="8" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <ui:TextBlock x:Name="TxtAiSetupTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                        <ui:TextBlock x:Name="TxtAiSetupBody" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button x:Name="BtnAiSetupWizard" Grid.Column="2" Height="32" Padding="12,0" VerticalAlignment="Center" Click="BtnAiSetupWizard_Click" />
                                </Grid>
                            </Border>

                            <ui:TextBlock Text="{DynamicResource AiCompanionProvider}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbAiProvider" MinHeight="32" Padding="8,4" Margin="0,0,0,4" SelectionChanged="CmbAiProvider_SelectionChanged" />
                            <ui:TextBlock x:Name="TxtAiProviderNote" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource TextSubtle}" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionApiKey}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TxtAiKey" MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" />
                                <ui:Button Grid.Column="1" x:Name="BtnSaveAiKey" Content="{DynamicResource AiCompanionSaveKey}" Appearance="Primary" Height="32" Margin="6,0,0,0" Click="BtnSaveAiKey_Click" />
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <ui:TextBlock x:Name="TxtAiKeyState" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ui:Button x:Name="BtnRemoveAiKey" HorizontalAlignment="Right" Content="{DynamicResource AiCompanionRemoveKey}" Appearance="Transparent" Foreground="{DynamicResource DangerBrush}" Padding="6,2" FontSize="11" Click="BtnRemoveAiKey_Click" />
                            </Grid>

                            <!--  Providers retire model names faster than this app ships, and the failure that
                                  produces is a dead end from the outside. Typing one over the top is the way out.  -->
                            <ui:TextBlock Text="{DynamicResource AiCompanionModel}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtAiModel" MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" TextChanged="TxtAiModel_TextChanged" />
                                <ui:Button Grid.Column="1" x:Name="BtnAiModelReset" Content="{DynamicResource AiCompanionModelReset}" Height="32" Margin="6,0,0,0" Click="BtnAiModelReset_Click" />
                            </Grid>
                            <!--  One-click model choices. The text field above stays the source of
                                  truth — picking here just fills it in, so a model released after
                                  this app shipped can still be typed by hand.  -->
                            <ComboBox x:Name="CmbAiModel" MinHeight="32" Padding="8,4" Margin="0,0,0,4" SelectionChanged="CmbAiModel_SelectionChanged" />

                            <!-- OpenRouter Model Tools: Browse & Search, Live Refresh -->
                            <Grid x:Name="PanelOpenRouterTools" Margin="0,0,0,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="BtnBrowseOpenRouterModels"
                                           Icon="{ui:SymbolIcon Symbol=Search24}"
                                           Content="{DynamicResource AiCompanionOpenRouterBrowse}"
                                           Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Height="32"
                                           Click="BtnBrowseOpenRouterModels_Click" />
                                <ui:Button Grid.Column="1"
                                           x:Name="BtnRefreshOpenRouterModels"
                                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                           ToolTip="{DynamicResource AiCompanionOpenRouterRefreshTip}"
                                           Appearance="Secondary"
                                           Height="32"
                                           Margin="6,0,0,0"
                                           Padding="8,0"
                                           Click="BtnRefreshOpenRouterModels_Click" />
                            </Grid>

                            <ui:TextBlock x:Name="TxtAiModelNote" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSubtle}" />

                            <!-- OpenRouter Parameters & Reasoning Settings -->
                            <StackPanel x:Name="PanelOpenRouterOptions" Margin="0,0,0,14" Visibility="Collapsed">
                                <ui:TextBlock Text="OpenRouter Request Options" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,6" />
                                
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                    <StackPanel>
                                        <!-- Reasoning Effort Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock Text="Reasoning &amp; Thinking Effort" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Controls how deeply reasoning models (DeepSeek-R1, o1/o3, Claude 3.7) think before answering." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="CmbOpenRouterReasoning" MinWidth="150" MinHeight="30" Padding="8,2" VerticalContentAlignment="Center" SelectionChanged="OnOpenRouterOptionChanged" />
                                        </Grid>

                                        <!-- Thinking Tokens Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock Text="Max Thinking Tokens" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Upper limit for reasoning steps (0 = model default)." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="CmbOpenRouterThinkingTokens" MinWidth="150" MinHeight="30" Padding="8,2" VerticalContentAlignment="Center" SelectionChanged="OnOpenRouterOptionChanged" />
                                        </Grid>

                                        <!-- Temperature Slider Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock x:Name="LblOpenRouterTemperature" Text="Temperature — 0.70" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Lower is more factual and precise; higher is more creative." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="SliOpenRouterTemperature" Minimum="0.0" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnOpenRouterSliderChanged" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Max Output Tokens Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock x:Name="LblOpenRouterMaxTokens" Text="Max Output Length — 700 tokens" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Maximum response length generated per question." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="SliOpenRouterMaxTokens" Minimum="256" Maximum="4096" SmallChange="64" LargeChange="256" ValueChanged="OnOpenRouterSliderChanged" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Provider Fallbacks Switch -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock Text="Allow Provider Fallbacks" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Automatically try backup hosts on OpenRouter if the primary host is down." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkOpenRouterFallbacks" VerticalAlignment="Center" Checked="OnOpenRouterSwitchChanged" Unchecked="OnOpenRouterSwitchChanged" />
                                        </Grid>

                                        <!-- Data Privacy (Zero Retention) Switch -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:TextBlock Text="Strict Privacy (Zero Data Retention)" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                                <ui:TextBlock Text="Route exclusively to OpenRouter providers that enforce zero prompt logging. Off, your recordings and screenshots may be kept and trained on by whoever serves the model. On, most free models become unavailable — permitting that is generally why they are free." FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="ChkOpenRouterPrivacy" VerticalAlignment="Center" Checked="OnOpenRouterSwitchChanged" Unchecked="OnOpenRouterSwitchChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  The speech model goes stale on its own schedule, and its failure is quieter:
                                  the request fails and Windows reads the answer, so it sounds like nothing
                                  happened rather than like something broke.  -->
                            <StackPanel x:Name="PanelAiVoiceModel">
                                <ui:TextBlock Text="{DynamicResource AiCompanionVoiceModel}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtAiVoiceModel" MinHeight="32" Padding="8,4" VerticalContentAlignment="Center" TextChanged="TxtAiVoiceModel_TextChanged" />
                                    <ui:Button Grid.Column="1" x:Name="BtnAiVoiceModelReset" Content="{DynamicResource AiCompanionModelReset}" Height="32" Margin="6,0,0,0" Click="BtnAiVoiceModelReset_Click" />
                                </Grid>
                                <ui:TextBlock x:Name="TxtAiVoiceModelNote" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSubtle}" />
                            </StackPanel>

                            <Grid MinHeight="36" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionGameData}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock x:Name="TxtAiGameDataNote" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiGameData" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <ui:TextBlock Text="{DynamicResource AiCompanionCustomPromptRules}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,2" />
                            <ui:TextBlock Text="{DynamicResource AiCompanionCustomPromptRulesHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextSubtle}" />
                            <ui:TextBox x:Name="TxtAiCustomPrompt"
                                        MinHeight="68"
                                        MaxHeight="160"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        Padding="8,6"
                                        Margin="0,0,0,14"
                                        PlaceholderText="{DynamicResource AiCompanionCustomPromptRulesPlaceholder}"
                                        TextChanged="TxtAiCustomPrompt_TextChanged" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionAnswers}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,6" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionAnswerLanguage}" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                            <ComboBox x:Name="CmbAiAnswerLanguage" MinHeight="32" Padding="8,4" Margin="0,2,0,4" SelectionChanged="CmbAiAnswerLanguage_SelectionChanged" />
                            <ui:TextBlock x:Name="TxtAiAnswerLanguageNote" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextSubtle}" />

                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionTextAnswers}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="{DynamicResource AiCompanionTextAnswersHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiTextAnswers" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionAudioAnswers}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="{DynamicResource AiCompanionAudioAnswersHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiAudioAnswers" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <!--  Indented because it only means anything with the row above
                                  switched on, and greyed out with its reason on the switch
                                  itself — ShowOnDisabled, or a disabled control says nothing
                                  when you go looking for the why.  -->
                            <Grid MinHeight="36" Margin="16,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock x:Name="LblAiStreamingVoice" Text="{DynamicResource AiCompanionStreamingVoice}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock x:Name="TxtAiAnswerNote" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiStreamingVoice" VerticalAlignment="Center"
                                                 ToolTipService.ShowOnDisabled="True"
                                                 Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionRecording}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,10,0,6" />

                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionGameAudio}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="{DynamicResource AiCompanionGameAudioHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiGameAudio" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <Grid MinHeight="36" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionScreenshotDefault}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="{DynamicResource AiCompanionScreenshotDefaultHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiScreenshotDefault" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <!--  The one setting that really changes what a model can make out in a frame:
                                  providers scale an image down before reading it, so cropping to what the
                                  player is aiming at hands over the same object several times larger.  -->
                            <ui:TextBlock Text="{DynamicResource AiCompanionShotArea}" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,6,0,0" />
                            <ComboBox x:Name="CmbAiShotZoom" MinHeight="32" Padding="8,4" Margin="0,2,0,4" SelectionChanged="CmbAiShotZoom_SelectionChanged" />
                            <ui:TextBlock x:Name="TxtAiShotZoomNote" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextSubtle}" />

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <Grid MinHeight="36" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionAutoSend}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock Text="{DynamicResource AiCompanionAutoSendHint}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="ChkAiAutoSend" VerticalAlignment="Center" Checked="OnAiSettingChanged" Unchecked="OnAiSettingChanged" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <ui:TextBlock Text="{DynamicResource AiCompanionHotkey}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    <ui:TextBlock x:Name="TxtAiHotkey" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" x:Name="BtnAiHotkey" Content="{DynamicResource AiCompanionSetHotkey}" Height="32" Click="BtnAiHotkey_Click" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionAnswerWindow}" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,10,0,2" />
                            <ui:TextBlock Text="{DynamicResource AiCompanionAnswerWindowHint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,10" />

                            <ui:TextBlock x:Name="LblAiAnswerOpacity" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                            <Slider x:Name="SliAiAnswerOpacity" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="OnAiAnswerAppearanceChanged" />

                            <ui:TextBlock x:Name="LblAiAnswerWidth" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                            <Slider x:Name="SliAiAnswerWidth" Minimum="220" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="OnAiAnswerAppearanceChanged" />

                            <ui:TextBlock x:Name="LblAiAnswerHeight" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                            <Slider x:Name="SliAiAnswerHeight" Minimum="80" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="OnAiAnswerAppearanceChanged" />

                            <ui:TextBlock Text="{DynamicResource AiCompanionAnswerColor}" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                            <ComboBox x:Name="CmbAiAnswerColor" MinHeight="32" Padding="8,4" Margin="0,2,0,10" SelectionChanged="CmbAiAnswerColor_SelectionChanged" />

                            <ui:Button x:Name="BtnAiAnswerPreview" Content="{DynamicResource AiCompanionAnswerPreview}" Icon="{ui:SymbolIcon Symbol=Eye24}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,10" Click="BtnAiAnswerPreview_Click" />

                            <Border Style="{StaticResource SettingsRowDivider}" />

                            <ui:Button x:Name="BtnAiHistory" Content="{DynamicResource AiCompanionHistoryButton}" Icon="{ui:SymbolIcon Symbol=History24}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Margin="0,10,0,10" Click="BtnAiHistory_Click" />

                            <ui:Button x:Name="BtnAiPolicy" Content="{DynamicResource AiCompanionPolicyButton}" Icon="{ui:SymbolIcon Symbol=ShieldTask24}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Click="BtnAiPolicy_Click" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Chat Commands Section -->
                <StackPanel x:Name="SectionChatCommands" tutorials:Tutorial.TargetId="Settings.ChatCommands">
                <ui:TextBlock Text="{DynamicResource ChatCommandsSettings}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <views:ChatCommandsOverlay x:Name="ChatCommandsEditor" />
                </StackPanel>

                <!-- Chat Alert Templates Section -->
                <StackPanel x:Name="SectionChatAlertTemplates">
                <ui:TextBlock Text="{DynamicResource CustomAlertsHeader}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <windows:CustomAlertsEditor />
                </StackPanel>

                <!-- Maintenance Section -->
                <StackPanel x:Name="SectionMaintenance" tutorials:Tutorial.TargetId="Settings.Maintenance">
                <ui:TextBlock Text="{DynamicResource MaintenanceTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <ui:TextBlock Text="{DynamicResource MaintenanceDesc}" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />
                        
                        <ui:Button x:Name="BtnShowResetDialog" Content="{DynamicResource ResetAppData}" Appearance="Caution" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" HorizontalAlignment="Stretch" Height="36" Margin="0,0,0,8" Click="BtnShowResetDialog_Click" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BtnBackupData" Grid.Column="0" Content="{DynamicResource BackupData}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowUpload24}" HorizontalAlignment="Stretch" Height="36" Margin="0,0,4,0" Click="BtnBackupData_Click" />
                            <ui:Button x:Name="BtnRestoreData" Grid.Column="1" Content="{DynamicResource RestoreData}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" HorizontalAlignment="Stretch" Height="36" Margin="4,0,0,0" Click="BtnRestoreData_Click" />
                        </Grid>
                        
                        <!-- Purge Orphaned Cloud Data Button -->
                        <ui:Button x:Name="BtnPurgeOrphanedCloudData" Content="{DynamicResource PurgeOrphanedCloudData}" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Delete24}" HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Click="BtnPurgeOrphanedCloudData_Click" ToolTip="{DynamicResource PurgeOrphanedCloudDataTooltip}" />

                        <!-- Developer: Download & Pack Missing Icons (Debug only) -->
                        <Grid x:Name="RowDevDownloadIcons" Margin="0,8,0,0" Visibility="Collapsed">
                            <ui:Button x:Name="BtnDownloadItemIcons" Content="[DEV] Download &amp; Pack Missing Icons" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" HorizontalAlignment="Stretch" Height="36" Click="BtnDownloadItemIcons_Click" ToolTip="Downloads any missing item icons and updates the bundled icon pack in the application folder (Debug only)." />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- 3D Map Section -->
                <StackPanel x:Name="SectionThreeDMap">
                <ui:TextBlock Text="{DynamicResource ThreeDMapSectionTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <ui:TextBlock Text="Manage 3D heightmap cache and manual map package imports" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Delete 3D Map Data button -->
                            <ui:Button Appearance="Danger" HorizontalAlignment="Stretch" Height="34" Margin="0,0,4,0" Click="BtnDelete3DMapData_Click" Icon="{ui:SymbolIcon Symbol=Delete24}" Content="{DynamicResource Settings3dMapDeleteData}" ToolTip="{DynamicResource Delete3DMapDataTooltip}" />
                            
                            <!-- Manually Parse Map button -->
                            <ui:Button x:Name="BtnManuallyParseMap" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34" Margin="4,0,0,0" Grid.Column="1" Click="BtnManuallyParseMap_Click" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="{DynamicResource UiParse3DMapManually}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Credits Section -->
                <StackPanel x:Name="SectionCredits">
                <ui:TextBlock Text="{DynamicResource CreditsTitle}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- rustmaps.com credit -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="15" Margin="0,0,8,0" Foreground="#E05070" VerticalAlignment="Center" />
                            <ui:TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                <Run Text="{DynamicResource CreditsIconsPrefix}" Foreground="{DynamicResource TextSubtle}" />
                                <Hyperlink NavigateUri="https://rustmaps.com" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Accent}">
                                    <Run Text="{DynamicResource UiRustmapsCom}" />
                                </Hyperlink>
                                <Run Text="{DynamicResource CreditsIconsSuffix}" Foreground="{DynamicResource TextSubtle}" />
                            </ui:TextBlock>
                        </StackPanel>
                        <!-- legal note -->
                        <ui:TextBlock Text="{DynamicResource CreditsIconsNote}" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </ui:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
