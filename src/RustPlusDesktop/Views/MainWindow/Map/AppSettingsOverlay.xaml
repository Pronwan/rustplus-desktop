                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PnlMutedServers" />
                            </ScrollViewer>
                        </ui:Card>
                    </StackPanel>
                </ui:Card>
                </StackPanel>

                <!-- Map Performance Section -->
                <StackPanel x:Name="SectionMapPerformance" tutorials:Tutorial.TargetId="Settings.Map">
                <ui:TextBlock Text="{DynamicResource UiMapPerformanceQuality}" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource Accent}" />
                <ui:Card Style="{StaticResource SettingsNativeCard}">
                    <StackPanel>
                        <!-- HD map from the .map file: ask, use, or not -->
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{DynamicResource SettingsMapHdImage}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
