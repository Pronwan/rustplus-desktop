<UserControl x:Class="RustPlusDesk.Views.SupportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:RustPlusDesk.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="400"
             Background="Transparent">

    <!--
        Tickets: the user's support conversations, in the left sidebar (TicketsTab, ~340-460 wide).
        One pane at a time - list, conversation, new-ticket form - each with a way back; see
        SupportOverlay.ApplyLayout. Everything is laid out to read well in that narrow column.
        Colours, type, radii and strokes come from DesignTokens.xaml and the App.xaml palette.
    -->
    <UserControl.Resources>
        <!-- Tints not in the shared palette: the warning pill and the two message surfaces. -->
        <SolidColorBrush x:Key="TicketWarningTint" Color="#26F2C14E" />
        <SolidColorBrush x:Key="TicketStaffSurface" Color="#1260CDFF" />
        <SolidColorBrush x:Key="TicketStaffStroke" Color="#2A60CDFF" />
        <SolidColorBrush x:Key="TicketInternalSurface" Color="#14F2C14E" />
        <SolidColorBrush x:Key="TicketInternalStroke" Color="#33F2C14E" />
        <FontFamily x:Key="TicketMono">Cascadia Mono, Consolas</FontFamily>

        <!-- Field label above an input -->
        <Style x:Key="SupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Helper line under an input -->
        <Style x:Key="SupHelp" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="SupCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Centred state: icon tile, title, one line -->
        <Style x:Key="StateTile" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Setter Property="Background" Value="{DynamicResource FillControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="StateTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeSubtitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StateBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Status pill: a tint of the status colour with its label, keyed by TicketVm.Tone -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="6,2,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource TicketWarningTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                    <Setter Property="Background" Value="{DynamicResource FillControlHover}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="{Binding StatusLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ticket list row: quiet at rest, fill on hover, accent outline on keyboard focus -->
        <Style x:Key="TicketRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,10,12,11" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FillControl}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FillControlPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AttachmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Composer: one inset field; the stroke turns accent while it has focus -->
        <Style x:Key="ComposerBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FillInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusOverlay}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDefault}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Borderless text area inside the composer -->
        <Style x:Key="ComposerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="Padding" Value="14,12,14,4" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round "remove" button on a picked attachment -->
        <Style x:Key="RemoveChipButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-8,-8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A file picked but not yet sent: image thumbnail or file chip, removable -->
        <DataTemplate x:Key="PickedAttachmentTemplate">
            <Grid Margin="0,8,12,0">
                <Border Visibility="{Binding ImageVisibility}" Width="48" Height="48" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True"
                        BorderBrush="{DynamicResource StrokeDefault}" BorderThickness="1" Background="{DynamicResource FillControl}">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                </Border>
                <Border Visibility="{Binding ChipVisibility}" Height="48" Background="{DynamicResource FillControl}" BorderBrush="{DynamicResource StrokeDefault}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Document24" Foreground="{DynamicResource TextSecondary}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}"
                                   VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CategoryItemTemplate">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource RadiusOverlay}"
            BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <controls:PanelHeader Grid.Row="0" Margin="16,12,12,12"
                                  IsCompact="True"
                                  Symbol="ChatHelp24"
                                  Title="{DynamicResource SupportTitle}"
                                  CloseClick="Close_Click">
                <controls:PanelHeader.Actions>
                    <ui:Button x:Name="BtnNewTicket" Content="{DynamicResource SupportNewTicket}" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary" Height="32" Padding="10,0,12,0" FontSize="{DynamicResource TypeBody}"
                               AutomationProperties.Name="{DynamicResource SupportNewTicket}" Click="NewTicket_Click" />
                </controls:PanelHeader.Actions>
            </controls:PanelHeader>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource StrokeSubtle}" />

            <!-- Content: one pane at a time -->
            <Grid Grid.Row="2">

                <!-- 1. Ticket list -->
                <Grid x:Name="TicketsView">
                    <ScrollViewer x:Name="TicketsScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="TicketsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TicketRowButton}" Click="TicketRow_Click" Tag="{Binding Id}"
                                            ToolTip="{Binding WhenFull}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Unread: dot plus a heavier subject, so it never relies on colour alone -->
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Margin="0,1,0,0" Visibility="{Binding UnreadVisibility}" />
                                            <TextBlock x:Name="SubjectText" Grid.Column="1" Text="{Binding Subject}" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock x:Name="WhenText" Grid.Column="2" Text="{Binding When}" Style="{StaticResource SupCaption}" Margin="12,0,0,0" />

                                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource StatusPill}">
                                                    <TextBlock Style="{StaticResource StatusPillText}" />
                                                </Border>
                                                <!-- Category, then the reference that tells apart tickets sharing a subject -->
                                                <TextBlock Grid.Column="1" Style="{StaticResource SupCaption}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding CategoryLabel, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource TextSubtle}" /><Run
                                                         Text="{Binding Reference, Mode=OneWay}" Foreground="{DynamicResource TextSubtle}" FontFamily="{StaticResource TicketMono}" />
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                            <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="WhenText" Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading (first load only) -->
                    <StackPanel x:Name="TicketsLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Width="32" Height="32" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource SupportLoadingTickets}" Style="{StaticResource StateBody}" Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Empty State -->
                    <Grid x:Name="TicketsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="300">
                            <Border Style="{StaticResource StateTile}">
                                <ui:SymbolIcon Symbol="ChatHelp24" FontSize="24" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource SupportNoTickets}" Style="{StaticResource StateTitle}" />
                            <TextBlock Text="{DynamicResource SupportNoTicketsBody}" Style="{StaticResource StateBody}" />
                            <ui:Button Content="{DynamicResource SupportNewTicket}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                       HorizontalAlignment="Center" Height="32" Padding="10,0,12,0" Margin="0,20,0,0"
                                       FontSize="{DynamicResource TypeBody}" Click="NewTicket_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Opening a ticket -->
                <Grid x:Name="DetailLoading" Visibility="Collapsed">
                    <ui:ProgressRing IsIndeterminate="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Width="32" Height="32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- A ticket that would not load -->
                <Grid x:Name="DetailError" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="24">
                        <Border Style="{StaticResource StateTile}">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="24" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource SupportTicketLoadFailed}" Style="{StaticResource StateTitle}" />
                        <TextBlock Text="{DynamicResource SupportTicketLoadFailedBody}" Style="{StaticResource StateBody}" />
                        <ui:Button Content="{DynamicResource SupportRetry}" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Secondary"
                                   HorizontalAlignment="Center" Height="32" Padding="10,0,12,0" Margin="0,20,0,0"
                                   FontSize="{DynamicResource TypeBody}" Click="ThreadRetry_Click" />
                        <ui:Button x:Name="ErrorBackButton" Content="{DynamicResource SupportBackToTickets}" Appearance="Transparent"
                                   HorizontalAlignment="Center" Height="32" Padding="12,0" Margin="0,8,0,0"
                                   FontSize="{DynamicResource TypeBody}" Click="ThreadBack_Click" />
                    </StackPanel>
                </Grid>

                <!-- 2. New ticket -->
                <Grid x:Name="ComposeView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Pane header: back, title -->
                    <Grid Grid.Row="0" Margin="8,12,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Appearance="Transparent" Width="32" Height="32" Padding="0" Click="ComposeCancel_Click"
                                   ToolTip="{DynamicResource SupportBackToTickets}" AutomationProperties.Name="{DynamicResource SupportBackToTickets}">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                        </ui:Button>
                        <TextBlock Grid.Column="1" Text="{DynamicResource SupportNewTicket}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,8">
                        <StackPanel x:Name="ComposeForm">
                            <TextBlock Text="{DynamicResource SupportNewTicketHint}" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{DynamicResource TypeBody}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

                            <!-- Category -->
                            <TextBlock Text="{DynamicResource SupportCategory}" Style="{StaticResource SupLabel}" />
                            <ComboBox x:Name="ComposeCategory" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Stretch"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}"
                                      AutomationProperties.Name="{DynamicResource SupportCategory}"
                                      SelectionChanged="ComposeCategory_SelectionChanged" Margin="0,0,0,16" />

                            <!-- Subject -->
                            <TextBlock Text="{DynamicResource SupportSubject}" Style="{StaticResource SupLabel}" />
                            <ui:TextBox x:Name="ComposeSubject" MaxLength="160" FontSize="{DynamicResource TypeBody}"
                                        AutomationProperties.Name="{DynamicResource SupportSubject}" TextChanged="ComposeSubject_TextChanged" />
                            <TextBlock x:Name="ComposeSubjectHelp" Text="{DynamicResource SupportSubjectHelp}" Style="{StaticResource SupHelp}" />
                            <StackPanel x:Name="ComposeSubjectInvalid" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource SupportSubjectRequired}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Details -->
                            <TextBlock Text="{DynamicResource SupportDetails}" Style="{StaticResource SupLabel}" Margin="0,16,0,8" />
                            <ui:TextBox x:Name="ComposeBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="280"
                                        VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource TypeBody}"
                                        AutomationProperties.Name="{DynamicResource SupportDetails}" TextChanged="ComposeBody_TextChanged" />
                            <TextBlock x:Name="ComposeBodyHelp" Text="{DynamicResource SupportDetailsHelp}" Style="{StaticResource SupHelp}" />
                            <StackPanel x:Name="ComposeBodyInvalid" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource SupportDetailsRequired}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Attachments -->
                            <TextBlock Text="{DynamicResource SupportAttachments}" Style="{StaticResource SupLabel}" Margin="0,16,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnComposeAttach" Content="{DynamicResource SupportAttachFiles}" Icon="{ui:SymbolIcon Attach24}"
                                           Appearance="Secondary" Height="32" Padding="10,0,12,0" FontSize="{DynamicResource TypeBody}" Click="ComposeAttach_Click" />
                                <TextBlock x:Name="ComposeAttachCount" Text="" Style="{StaticResource SupCaption}" Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource SupportAttachHint}" Style="{StaticResource SupHelp}" />

                            <!-- Attachments Preview List -->
                            <ItemsControl x:Name="ComposeAttachments" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PickedAttachmentTemplate}" />
                                            <Button Style="{StaticResource RemoveChipButton}" Tag="{Binding}" Click="RemoveComposeAttachment_Click" Margin="0,0,4,0"
                                                    ToolTip="{DynamicResource SupportRemove}" AutomationProperties.Name="{DynamicResource SupportRemove}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Appeal Checkbox -->
                            <CheckBox x:Name="ComposeAppeal" Content="{DynamicResource SupportAppeal}" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed" Margin="0,16,0,0" />

                            <!-- Error Message Banner -->
                            <Border x:Name="ComposeErrorBorder" Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=ComposeError}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{DynamicResource DangerBrush}" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" x:Name="ComposeError" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeBody}"
                                               TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,1,0,0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="{DynamicResource SupportCancel}" Appearance="Secondary" Height="32" Padding="16,0"
                                       FontSize="{DynamicResource TypeBody}" Click="ComposeCancel_Click" />
                            <ui:Button x:Name="BtnComposeSubmit" Content="{DynamicResource SupportSubmit}" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                       Height="32" Padding="12,0,16,0" Margin="8,0,0,0" FontSize="{DynamicResource TypeBody}" Click="ComposeSubmit_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Conversation -->
                <Grid x:Name="ThreadView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thread Header: back, subject (two lines at most), status line -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="0,0,0,1" Padding="8,10,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:Button x:Name="ThreadBackButton" Appearance="Transparent" Width="32" Height="32" Padding="0" VerticalAlignment="Top" Click="ThreadBack_Click"
                                       ToolTip="{DynamicResource SupportBackToTickets}" AutomationProperties.Name="{DynamicResource SupportBackToTickets}">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                            </ui:Button>
                            <TextBlock x:Name="ThreadSubject" Grid.Column="1" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeSubtitle}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44"
                                       Margin="4,5,0,0" />
                            <StackPanel x:Name="ThreadHeader" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4,8,0,0">
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Style="{StaticResource StatusPillText}" />
                                </Border>
                                <TextBlock x:Name="ThreadStatus" Style="{StaticResource SupCaption}" Margin="10,0,0,0" />
                                <TextBlock Text="·" Style="{StaticResource SupCaption}" Foreground="{DynamicResource TextSubtle}" Margin="6,0" />
                                <TextBlock Text="{Binding Reference}" Style="{StaticResource SupCaption}" Foreground="{DynamicResource TextSubtle}"
                                           FontFamily="{StaticResource TicketMono}" ToolTip="{Binding Id}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Messages List -->
                    <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Padding="16,16,16,4">
                        <ItemsControl x:Name="ThreadMessages" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Staff on the left, you on the right; each inset from the other side so the sides read -->
                                    <StackPanel x:Name="Item" Margin="0,0,32,16" HorizontalAlignment="Left">
                                        <!-- Author, badge, time -->
                                        <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,6" HorizontalAlignment="Left">
                                            <Border x:Name="Avatar" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource FillControlHover}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon x:Name="AvatarIcon" Symbol="{Binding BadgeSymbol}" FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Visibility="{Binding StaffTagVisibility}" Background="{DynamicResource AccentTintBrush}"
                                                    CornerRadius="{DynamicResource RadiusControl}" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource SupportStaffBadge}" Foreground="{DynamicResource Accent}" FontSize="{DynamicResource TypeCaption}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding When}" ToolTip="{Binding WhenFull}" Style="{StaticResource SupCaption}" Margin="8,0,0,0" />
                                        </StackPanel>

                                        <Border x:Name="Bubble" Background="{DynamicResource FillControl}" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RadiusOverlay}" Padding="14,10" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <!-- Message Text Body -->
                                                <TextBlock Text="{Binding Body}" Visibility="{Binding BodyVisibility}" Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="{DynamicResource TypeBody}" TextWrapping="Wrap" LineHeight="21" />

                                                <!-- Attachments in Message -->
                                                <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding AttachmentsVisibility}" Margin="0,10,0,-8" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource AttachmentButtonStyle}"
                                                                    Tag="{Binding}"
                                                                    Click="MessageAttachment_Click"
                                                                    ToolTip="{Binding Name}"
                                                                    AutomationProperties.Name="{Binding Name}">
                                                                <Grid>
                                                                    <!-- Image Thumbnail -->
                                                                    <Border Visibility="{Binding ImageVisibility}" MaxWidth="240" MaxHeight="160" MinWidth="72" MinHeight="48"
                                                                            CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True"
                                                                            BorderBrush="{DynamicResource StrokeDefault}" BorderThickness="1" Background="{DynamicResource FillInset}">
                                                                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <!-- File Chip -->
                                                                    <Border Visibility="{Binding ChipVisibility}" Height="36" Background="{DynamicResource FillControl}"
                                                                            BorderBrush="{DynamicResource StrokeDefault}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10,0,12,0">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:SymbolIcon Symbol="Document24" Foreground="{DynamicResource TextSecondary}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TypeCaption}"
                                                                                       VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource SupCaption}" Margin="8,0,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- The user's own messages sit on the right, without an avatar -->
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter TargetName="Item" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Item" Property="Margin" Value="32,0,0,16" />
                                            <Setter TargetName="Header" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- Support replies: accent-tinted surface, accent avatar, "Support" badge -->
                                        <DataTrigger Binding="{Binding Role}" Value="staff">
                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource TicketStaffSurface}" />
                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource TicketStaffStroke}" />
                                            <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                            <Setter TargetName="AvatarIcon" Property="Foreground" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="internal">
                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource TicketInternalSurface}" />
                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource TicketInternalStroke}" />
                                            <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource TicketWarningTint}" />
                                            <Setter TargetName="AvatarIcon" Property="Foreground" Value="{DynamicResource StatusWarning}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Reply composer, or the closed notice -->
                    <Grid Grid.Row="2" Margin="12,4,12,12">
                        <Border x:Name="ReplyBar" Style="{StaticResource ComposerBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Reply Attachments Preview -->
                                <ItemsControl x:Name="ReplyAttachments" Margin="12,4,12,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PickedAttachmentTemplate}" />
                                                <Button Style="{StaticResource RemoveChipButton}" Tag="{Binding}" Click="RemoveReplyAttachment_Click" Margin="0,0,4,0"
                                                        ToolTip="{DynamicResource SupportRemove}" AutomationProperties.Name="{DynamicResource SupportRemove}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox x:Name="ReplyBox" Grid.Row="1" Style="{StaticResource ComposerTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="40" MaxHeight="160"
                                         AutomationProperties.Name="{DynamicResource SupportReplyPlaceholder}"
                                         TextChanged="ReplyBox_TextChanged" PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                                <TextBlock x:Name="ReplyPlaceholder" Grid.Row="1" Text="{DynamicResource SupportReplyPlaceholder}" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSubtle}" FontSize="{DynamicResource TypeBody}" Margin="14,10,14,0" />

                                <!-- Toolbar: attach, hint or error, send -->
                                <Grid Grid.Row="2" Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" x:Name="BtnReplyAttach" Appearance="Transparent" Width="32" Height="32" Padding="0"
                                               Click="ReplyAttach_Click" ToolTip="{DynamicResource SupportAttachFiles}"
                                               AutomationProperties.Name="{DynamicResource SupportAttachFiles}">
                                        <ui:SymbolIcon Symbol="Attach24" Foreground="{DynamicResource TextSecondary}" FontSize="16" />
                                    </ui:Button>
                                    <TextBlock x:Name="ReplyHint" Grid.Column="1" Text="{DynamicResource SupportSendHint}" Style="{StaticResource SupCaption}"
                                               Foreground="{DynamicResource TextSubtle}" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ReplyError" Grid.Column="1" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource TypeCaption}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0" Visibility="Collapsed" />
                                    <ui:Button Grid.Column="2" x:Name="BtnReplySend" Content="{DynamicResource SupportSend}" Icon="{ui:SymbolIcon Send24}"
                                               Appearance="Primary" Height="32" Padding="10,0,12,0" FontSize="{DynamicResource TypeBody}" Click="ReplySend_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Closed Ticket Message -->
                        <Border x:Name="ThreadClosedBorder" Background="{DynamicResource FillControl}" BorderBrush="{DynamicResource StrokeSubtle}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusOverlay}" Padding="14,12" Visibility="{Binding Visibility, ElementName=ThreadClosed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource TextSecondary}" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" x:Name="ThreadClosed" Text="{DynamicResource SupportTicketClosed}" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{DynamicResource TypeBody}" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed" />
                                <ui:Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource SupportNewTicket}" Icon="{ui:SymbolIcon Add24}" Appearance="Secondary"
                                           Height="32" Padding="10,0,12,0" Margin="0,10,0,0" HorizontalAlignment="Left"
                                           FontSize="{DynamicResource TypeBody}" Click="NewTicket_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
