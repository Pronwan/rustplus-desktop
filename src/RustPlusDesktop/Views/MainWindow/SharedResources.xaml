<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters">

    <conv:UpkeepBackgroundConverter x:Key="UpkeepBackgroundConverter" />
    <conv:StorageChipConverter x:Key="StorageChipConverter" />
    <conv:StorageUpkeepConverter x:Key="StorageUpkeepConverter" />
    <conv:KindToStorageVisibilityConverter x:Key="KindToStorageVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityInv" Invert="True" />
    <conv:LessThanConverter x:Key="LessThanConverter" />
    <conv:DeviceTreeItemWidthConverter x:Key="DeviceTreeItemWidthConverter" />
    <conv:SwitchCommandDisplayConverter x:Key="SwitchCommandDisplayConverter" />
    <conv:DeviceHotkeyDisplayConverter x:Key="DeviceHotkeyDisplayConverter" />
    <conv:DeviceFilterVisibilityConverter x:Key="DeviceFilterVisibilityConverter" />
    <conv:NotNullToBoolConverter x:Key="NotNull" />

    <BitmapImage x:Key="IconStorageMonitor" UriSource="pack://application:,,,/Assets/icons/storagemonitor.png" />
    <BitmapImage x:Key="IconSmartSwitch" UriSource="pack://application:,,,/Assets/icons/smartswitch.png" />
    <BitmapImage x:Key="IconSmartAlarm" UriSource="pack://application:,,,/Assets/icons/smartalarm.png" />
    <BitmapImage x:Key="IconGroup" UriSource="pack://application:,,,/Assets/icons/cabins.png" />

    <!--
        Palette, semantic brushes, and shared control styles live in App.xaml and
        Views/Themes/DesignTokens.xaml so MainWindow and secondary views share one theme.
        Only MainWindow-specific shell styles stay here.
    -->

    <!--  Main sidebar navigation lives in the permanent rail; only render the selected workspace here.  -->
    <Style x:Key="SidebarTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <ContentPresenter
                        x:Name="PART_SelectedContentHost"
                        ContentSource="SelectedContent"
                        KeyboardNavigation.TabNavigation="Local"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillToggleButton" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
        <Setter Property="Background" Value="{DynamicResource FillControl}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource StrokeDefault}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="First">
                            <Setter TargetName="Bd" Property="CornerRadius" Value="6,0,0,6" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Middle">
                            <Setter Property="Margin" Value="-1,0,0,0" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Last">
                            <Setter Property="Margin" Value="-1,0,0,0" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="0,6,6,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FillControlHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarnTintBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StatusWarning}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusWarning}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter Margin="4,2" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#264FC3F7" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
