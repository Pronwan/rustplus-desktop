<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.TransferDevicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Transfer Devices &amp; Settings" Width="520" SizeToContent="Height"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowBackdropType="Mica"
        Background="#141820"
        Foreground="{DynamicResource TextPrimary}">

    <Border BorderBrush="#252F3D" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Height="40" Title="Transfer Devices &amp; Settings"
                         ShowMinimize="False" ShowMaximize="False"
                         Background="Transparent" Foreground="{DynamicResource TextPrimary}">
                <ui:TitleBar.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <StackPanel Grid.Row="1" Margin="24,10,24,24">
                <TextBlock Text="Transfer Devices &amp; Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Margin="0,4,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" FontSize="12.5"
                           Text="Move or copy all smart devices, cameras, and automations from this server to another server profile (for example, after a server port change or wipe)."/>

                <!-- Source Server Card -->
                <Border Background="#1C222D" BorderBrush="#2E3848" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Server24" FontSize="24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtSourceName" Text="Source Server" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtSourceDetails" Text="Host:Port • 0 devices, 0 cameras" FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Target Server Selection -->
                <TextBlock Text="Target Server" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTargetServers" Margin="0,0,0,16" MinHeight="38"
                          Background="#1C222D" Foreground="{DynamicResource TextPrimary}" BorderBrush="#2E3848">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                <TextBlock Foreground="#9AA0A6" FontSize="11">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding Host, Mode=OneWay}"/>
                                        <Run Text=":"/>
                                        <Run Text="{Binding Port, Mode=OneWay}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding Devices.Count, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"/>
                                        <Run Text=" devices"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Transfer Items Selection -->
                <TextBlock Text="Items to Transfer" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="ChkDevices" Grid.Row="0" Grid.Column="0" Content="Smart Devices" IsChecked="True" Foreground="White" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkCameras" Grid.Row="0" Grid.Column="1" Content="Cameras" IsChecked="True" Foreground="White" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkRules" Grid.Row="1" Grid.Column="0" Content="Logic &amp; Automations" IsChecked="True" Foreground="White"/>
                    <CheckBox x:Name="ChkCommands" Grid.Row="1" Grid.Column="1" Content="Commands &amp; Codes" IsChecked="True" Foreground="White"/>
                </Grid>

                <!-- Options -->
                <Border Background="#161B23" BorderBrush="#252F3D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkVerify" Content="Verify devices on target server before transferring" IsChecked="True" Foreground="White" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkDeleteSource" Content="Delete source server after successful transfer" IsChecked="False" Foreground="#EF9A9A"/>
                    </StackPanel>
                </Border>

                <!-- Progress & Info -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" x:Name="PnlProgress" Visibility="Collapsed">
                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtProgressMessage" Text="Verifying devices on target server..." VerticalAlignment="Center" Foreground="{DynamicResource TextSubtle}" FontSize="12"/>
                </StackPanel>

                <ui:InfoBar x:Name="InfoResult" Margin="0,4,0,0" IsClosable="True" IsOpen="False"/>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <ui:Button Content="Cancel" Appearance="Secondary" MinWidth="92" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <ui:Button x:Name="BtnTransfer" Content="Transfer Now" Appearance="Primary" MinWidth="130"
                               Icon="{ui:SymbolIcon Symbol=ArrowRight24}" Click="Transfer_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
