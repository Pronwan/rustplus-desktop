<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.BaseNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource BaseNoteWindowTitle}"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource BaseNoteWindowTitle}" ShowMaximize="False" ShowMinimize="False"/>

        <DockPanel Grid.Row="1" Margin="20,4,20,20">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="TxtTitle"
                           Text="{DynamicResource BaseNoteTitle}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Separator Background="{DynamicResource CardBorder}" Margin="0,8,0,0"/>
            </StackPanel>
 
            <!-- Bottom Buttons -->
            <Grid DockPanel.Dock="Bottom" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BtnSave" Grid.Column="1" Content="{DynamicResource Save}" Appearance="Primary" Width="100" Height="32" Margin="0,0,8,0" Click="BtnSave_Click" IsDefault="True"/>
                <ui:Button x:Name="BtnCancel" Grid.Column="2" Content="{DynamicResource Cancel}" Appearance="Secondary" Width="100" Height="32" Click="BtnCancel_Click" IsCancel="True"/>
            </Grid>
 
            <!-- Main Content -->
            <Grid>
                <TextBox x:Name="TxtNote" 
                         Background="{DynamicResource Surface}" 
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource CardBorder}"
                         BorderThickness="1"
                         Padding="8,6"
                         AcceptsReturn="False" 
                         TextWrapping="NoWrap" 
                         MaxLength="100"
                         FontSize="13"
                         Height="36"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
