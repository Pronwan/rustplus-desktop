<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding DialogTitle}"
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding DialogTitle}" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="TxtInput" Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" PlaceholderText="..." FontSize="14" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="{DynamicResource Cancel}" Appearance="Secondary" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <ui:Button Content="{DynamicResource Save}" Appearance="Primary" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
