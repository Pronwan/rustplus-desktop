<UserControl x:Class="RustPlusDesk.Views.CommandDockSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}">

    <!--
        The dock's own settings, which used to be the map's.

        The gear in the title bar opened the mini-map panel — shape, size, layers — on a window
        that may not have a map on it at all, and whose tiles those settings never touched. The
        map keeps that panel, reached from its own gear; this is what the dock itself has.
    -->
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <StackPanel Width="210">
            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Board24" Margin="0,0,6,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontSize="16"/>
                    <TextBlock Text="{DynamicResource CommandDockTitle}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:Button x:Name="BtnClose"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="4"
                           Appearance="Transparent"
                           Click="BtnClose_Click"
                           Icon="{ui:SymbolIcon Symbol=Dismiss24}"/>
            </Grid>

            <TextBlock Text="{DynamicResource CommandDockDisplay}" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,4" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbMonitor" SelectionChanged="CmbMonitor_SelectionChanged" Margin="0,0,0,12"/>

            <!--
                Global appearance.

                Each of these is a switch and a value. While the switch is off, every tile keeps
                whatever it was given through its own gear; while it is on, the value here wins
                for all of them. Nothing is overwritten either way — the tiles keep their own
                settings and get them back the moment the switch goes off again.
            -->
            <Separator Background="{DynamicResource CardBorder}" Margin="0,4,0,8"/>
            <TextBlock Text="{DynamicResource CommandDockGlobalLook}" FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,2" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource CommandDockGlobalLookHint}" FontSize="10" Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkGlobalOpacity" Content="{DynamicResource CommandDockGlobalOpacity}" Style="{StaticResource DotCheckBox}"
                      Checked="Override_Changed" Unchecked="Override_Changed" Margin="0,0,0,2"/>
            <TextBlock x:Name="LblOpacity" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,2"/>
            <Slider x:Name="SliOpacity" Minimum="0" Maximum="1" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="Value_Changed" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkGlobalFont" Content="{DynamicResource CommandDockGlobalFontSize}" Style="{StaticResource DotCheckBox}"
                      Checked="Override_Changed" Unchecked="Override_Changed" Margin="0,0,0,2"/>
            <TextBlock x:Name="LblFont" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,2"/>
            <Slider x:Name="SliFont" Minimum="0.7" Maximum="2.0" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="Value_Changed" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkGlobalColor" Content="{DynamicResource CommandDockGlobalTextColor}" Style="{StaticResource DotCheckBox}"
                      Checked="Override_Changed" Unchecked="Override_Changed" Margin="0,0,0,4"/>
            <WrapPanel x:Name="ColorSwatches" Margin="0,0,0,10"/>

            <Separator Background="{DynamicResource CardBorder}" Margin="0,4,0,8"/>
            <ui:Button x:Name="BtnReset" HorizontalAlignment="Stretch" FontSize="11"
                       Appearance="Secondary" Click="BtnReset_Click"
                       Content="{DynamicResource CommandDockResetLook}"/>
        </StackPanel>
    </Border>
</UserControl>
