# Web deployment settings. Copy this file to .env for Docker Compose.
# Use unique, strong values. Never commit the real .env file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
WEB_INVITE_CODE=

# Persistent SQLite database path inside the container.
DATABASE_PATH=/data/rustplus-web.db
DATA_PROTECTION_KEYS_PATH=/data/keys
ASPNETCORE_ENVIRONMENT=Production
