      "command": "input.sensitivity {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "float", "label": "Sensitivity", "default": "0.2", "min": 0, "max": 5 }
      ]
    },
    {
