{
  "version": 1,
  "note": "Console commands for the Console Helper. 'command' is a template; {name} placeholders are filled from 'params'. Descriptions are written for this app, not copied from the wiki.",
  "commands": [

    {
      "id": "auto-attack-crouch",
      "category": "client",
      "group": "Combat",
      "featured": true,
      "title": "Auto-Attack + Crouch",
      "description": "Fires continuously on full-auto weapons and crouches at the same time, without holding your mouse button or Ctrl.",
      "command": "attack;duck",
      "bindable": true,
      "defaultBind": "kp1",
      "params": []
    },
    {
      "id": "auto-run",
      "category": "client",
      "group": "Movement",
      "featured": true,
      "title": "Auto-Run",
      "description": "Move forward and sprint continuously without holding W or Shift. Tap the key again to stop.",
      "command": "forward;sprint",
      "bindable": true,
      "defaultBind": "kp2",
      "params": []
    },
    {
      "id": "toggle-crouch",
      "category": "client",
      "group": "Movement",
      "featured": false,
      "title": "Toggle Crouch",
      "description": "Stays crouched until you press the key again, instead of holding Ctrl down.",
      "command": "duck",
      "bindable": true,
      "defaultBind": "z",
      "params": []
    },
    {
      "id": "duck-volume",
      "category": "client",
      "group": "Audio",
      "featured": true,
      "title": "Lower Master Volume (Toggle)",
      "description": "Temporarily ducks the game's own volume without touching Windows or Discord. Built for exactly the moment a jackhammer or chainsaw is drowning out voice comms. Tap again to restore full volume.",
      "command": "~audio.master {low};audio.master {full}",
      "bindable": true,
      "defaultBind": "kp3",
      "params": [
        { "name": "low",  "type": "float", "label": "Ducked", "default": "0.2", "min": 0, "max": 1 },
        { "name": "full", "type": "float", "label": "Normal", "default": "1",   "min": 0, "max": 1 }
      ]
    },
    {
      "id": "craft-item",
      "category": "client",
      "group": "Crafting",
      "featured": true,
      "title": "Instant Craft",
      "description": "Crafts the chosen item straight from a key, skipping the crafting menu. Defaults to a single bandage.",
      "command": "craft.add {item} {amount}",
      "bindable": true,
      "defaultBind": "kp4",
      "params": [
        { "name": "item",   "type": "item", "label": "Item",   "default": "-2072273936" },
        { "name": "amount", "type": "int",  "label": "Amount", "default": "1", "min": 1, "max": 100 }
      ]
    },
    {
      "id": "craft-cancel",
      "category": "client",
      "group": "Crafting",
      "featured": false,
      "title": "Cancel Craft",
      "description": "Removes queued crafts of the chosen item from your crafting queue.",
      "command": "craft.cancel {item} {amount}",
      "bindable": true,
      "defaultBind": null,
      "params": [
        { "name": "item",   "type": "item", "label": "Item",   "default": "-2072273936" },
        { "name": "amount", "type": "int",  "label": "Amount", "default": "1", "min": 1, "max": 100 }
      ]
    },
    {
      "id": "fov-zoom",
      "category": "client",
      "group": "Graphics",
      "featured": true,
      "title": "Quick FOV Zoom",
      "description": "Punches the field of view in for better target identification at range, then snaps back when you tap again.",
      "command": "~graphics.fov {zoomed};graphics.fov {normal}",
      "bindable": true,
      "defaultBind": "mouse3",
      "params": [
        { "name": "zoomed", "type": "int", "label": "Zoomed", "default": "70", "min": 50, "max": 90 },
        { "name": "normal", "type": "int", "label": "Normal", "default": "90", "min": 50, "max": 90 }
      ]
    },
    {
      "id": "fov-set",
      "category": "client",
      "group": "Graphics",
      "featured": false,
      "title": "Field of View",
      "description": "Sets the field of view once. 90 is the maximum the game accepts.",
      "command": "graphics.fov {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "int", "label": "FOV", "default": "90", "min": 50, "max": 90 }
      ]
    },
    {
      "id": "disable-gibs",
      "category": "client",
      "group": "Performance",
      "featured": true,
      "title": "Disable Gibs",
      "description": "Turns off the debris objects that spawn when a wall, vehicle or player is destroyed. Fewer objects during a raid means a steadier frame rate.",
      "command": "effects.maxgibs {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "int", "label": "Max gibs", "default": "-1", "min": -1, "max": 500 }
      ]
    },
    {
      "id": "lookat-radius",
      "category": "client",
      "group": "Quality of life",
      "featured": true,
      "title": "Precise Look-At Radius",
      "description": "Tightens the invisible interaction cone, so you don't accidentally grab, open or loot the wrong item when several are packed close together. 0.2 is the game default.",
      "command": "client.lookatradius {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "float", "label": "Radius", "default": "0.01", "min": 0, "max": 1 }
      ]
    },
    {
      "id": "head-inertia",
      "category": "client",
      "group": "Quality of life",
      "featured": true,
      "title": "Disable Head-Look Inertia",
      "description": "Makes your view snap straight back to centre the instant you release alt-look, instead of drifting back with momentum.",
      "command": "headlerp_inertia {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "bool", "label": "Inertia", "default": "false" }
      ]
    },
    {
      "id": "hitnotify-level",
      "category": "client",
      "group": "Combat",
      "featured": true,
      "title": "Hit Marker Detail",
      "description": "Controls how much detail hit notifications carry. Higher values show more information about registered hits.",
      "command": "hitnotify.notification_level {value}",
      "bindable": false,
      "defaultBind": null,
      "params": [
        { "name": "value", "type": "int", "label": "Level", "default": "2", "min": 0, "max": 2 }
      ]
    },
    {
      "id": "ads-sensitivity",
      "category": "client",
      "group": "Combat",
      "featured": false,
      "title": "Lower Sensitivity While Aiming",
