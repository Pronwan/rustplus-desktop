      "bindable": true,
      "defaultBind": "mouse1",
      "params": [
        { "name": "ads", "type": "float", "label": "Aiming", "default": "0.45", "min": 0, "max": 5 },
        { "name": "hip", "type": "float", "label": "Hip",    "default": "0.2",  "min": 0, "max": 5 }
      ]
    },
    {
      "id": "light-on-ads",
