  <PropertyGroup>
    <MapParserProjectPath>$(MSBuildProjectDirectory)\..\MapParser\MapParser.csproj</MapParserProjectPath>
    <MapParserPublishDir>$(MSBuildProjectDirectory)\..\MapParser\bin\$(Configuration)\net8.0\win-x64\publish\</MapParserPublishDir>
    <MapParserPublishedExe>$(MapParserPublishDir)MapParser.exe</MapParserPublishedExe>
  </PropertyGroup>
  <Target Name="BuildMapParserRuntime" Condition="Exists('$(MapParserProjectPath)') And !$([System.String]::Copy('$(MSBuildProjectName)').Contains('_wpftmp'))">
    <RemoveDir Directories="$(MapParserPublishDir)" Condition="Exists('$(MapParserPublishDir)')" />
    <MSBuild Projects="$(MapParserProjectPath)" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;TargetFramework=net8.0;PublishDir=$(MapParserPublishDir);NoBuild=false" />
    <Error Condition="!Exists('$(MapParserPublishedExe)')" Text="MapParser publish did not produce $(MapParserPublishedExe)." />
    <ItemGroup>
      <MapParserForbiddenPublishedFile Include="$(MapParserPublishDir)**\*.cs;$(MapParserPublishDir)**\*.csproj;$(MapParserPublishDir)modules\**\*.js" />
      <MapParserForbiddenPublishedFile Include="$(MapParserPublishDir)app.js" Condition="Exists('$(MapParserPublishDir)app.js')" />
      <MapParserForbiddenPublishedFile Include="$(MapParserPublishDir)build-client.mjs" Condition="Exists('$(MapParserPublishDir)build-client.mjs')" />
      <MapParserForbiddenPublishedFile Include="$(MapParserPublishDir)package.json" Condition="Exists('$(MapParserPublishDir)package.json')" />
      <MapParserForbiddenPublishedFile Include="$(MapParserPublishDir)package-lock.json" Condition="Exists('$(MapParserPublishDir)package-lock.json')" />
    </ItemGroup>
    <Error Condition="'@(MapParserForbiddenPublishedFile)' != ''" Text="MapParser publish contains source files: @(MapParserForbiddenPublishedFile)" />
  </Target>
  <Target Name="IncludeMapParserRuntime" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildMapParserRuntime" Condition="Exists('$(MapParserProjectPath)') And !$([System.String]::Copy('$(MSBuildProjectName)').Contains('_wpftmp'))">
    <ItemGroup>
      <MapParserPublishedContent Include="$(MapParserPublishDir)**\*" Exclude="$(MapParserPublishedExe)" />
      <Content Include="$(MapParserPublishedExe)">
        <Link>MapParser\MapParser.exe</Link>
        <TargetPath>MapParser\MapParser.exe</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
      <Content Include="@(MapParserPublishedContent)">
        <Link>MapParser\%(MapParserPublishedContent.RecursiveDir)%(MapParserPublishedContent.Filename)%(MapParserPublishedContent.Extension)</Link>
        <TargetPath>MapParser\%(MapParserPublishedContent.RecursiveDir)%(MapParserPublishedContent.Filename)%(MapParserPublishedContent.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <GeneticsLabDir>$(MSBuildProjectDirectory)\Features\GeneticsLab\</GeneticsLabDir>
