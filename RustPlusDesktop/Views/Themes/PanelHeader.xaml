<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:RustPlusDesk.Controls">
    <!--
        One header for every panel: drawers beside the map, full-screen tools and flyouts.
        Icon tile, optional eyebrow, title, optional subtitle, a slot for the panel's own
        buttons, then the close button, always last and always the same size. Sizes and which
        parts show are set by PanelHeader.UpdateLayoutState from IsCompact and the content.
        A templated control rather than a UserControl, so hosts can name the buttons they put
        in Actions.
    -->
    <Style TargetType="controls:PanelHeader">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PanelHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="PART_IconTile" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border CornerRadius="8" Background="{TemplateBinding AccentBrush}" Opacity="0.14" />
                            <Border CornerRadius="8" BorderBrush="{TemplateBinding AccentBrush}" BorderThickness="1" Opacity="0.32" />
                            <ui:SymbolIcon x:Name="PART_Symbol"
                                           Symbol="{TemplateBinding Symbol}"
                                           Foreground="{TemplateBinding AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PART_Image"
                                   Source="{TemplateBinding ImageSource}"
                                   Stretch="Uniform" Margin="3"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PART_Eyebrow"
                                       Text="{TemplateBinding Eyebrow}"
                                       Foreground="{TemplateBinding AccentBrush}"
                                       FontSize="10.5" FontWeight="Bold" Margin="0,0,0,1" />
                            <TextBlock x:Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PART_Subtitle"
                                       Text="{TemplateBinding Subtitle}"
                                       Foreground="{DynamicResource TextSubtle}"
                                       TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ContentPresenter Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                            <ui:Button x:Name="PART_CloseButton"
                                       Appearance="Transparent"
                                       Width="32" Height="32" Padding="0" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip="{DynamicResource Close}"
                                       AutomationProperties.Name="{DynamicResource Close}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSubtle}" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
