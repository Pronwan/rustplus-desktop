<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource UpdateWhatsNewTitle}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="White"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource UpdateWhatsNewTitle}" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="25,0,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" CornerRadius="12,12,0,0" Padding="20,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrandOrangeBrush}" CornerRadius="5" Padding="6,3" Margin="0,0,10,0">
                        <TextBlock Text="v9.2" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{DynamicResource UpdateWhatsNewTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="22,18,22,10">

                <TextBlock Text="{DynamicResource UpdateWhatsNewSummary}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrandOrangeBrush}" Margin="0,0,0,10"/>

                <!-- Feature list -->
                <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="#2A3040" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- Bullet 1 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="People24" Foreground="{DynamicResource BrandOrangeBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{DynamicResource UpdateWhatsNewTitle1}" Foreground="White"/><LineBreak/>
                                <Run Text="{DynamicResource UpdateWhatsNewDesc1}"/>
                            </TextBlock>
                        </Grid>

                        <!-- Bullet 2 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Map24" Foreground="{DynamicResource BrandOrangeBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{DynamicResource UpdateWhatsNewTitle2}" Foreground="White"/><LineBreak/>
                                <Run Text="{DynamicResource UpdateWhatsNewDesc2}"/>
                            </TextBlock>
                        </Grid>

                        <!-- Bullet 3 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Comment24" Foreground="{DynamicResource BrandOrangeBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{DynamicResource UpdateWhatsNewTitle3}" Foreground="White"/><LineBreak/>
                                <Run Text="{DynamicResource UpdateWhatsNewDesc3}"/>
                            </TextBlock>
                        </Grid>

                        <!-- Bullet 4 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Home24" Foreground="{DynamicResource BrandOrangeBrush}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{DynamicResource UpdateWhatsNewTitle4}" Foreground="White"/><LineBreak/>
                                <Run Text="{DynamicResource UpdateWhatsNewDesc4}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Margin="22,0,22,10">
                <CheckBox x:Name="ChkDontShowAgain" Content="{DynamicResource UpdateWhatsNewDontShowAgain}" IsChecked="False" Margin="0,0,0,15" Foreground="#A0A0A0" Style="{StaticResource DotCheckBox}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!--
                        MinWidth, not Width: "Vollständige Patch Notes" and its Russian and Korean
                        equivalents are all longer than the English label, and a fixed 150 cut them
                        off. The buttons keep their old size whenever the text fits.
                    -->
                    <ui:Button Content="{DynamicResource UpdateWhatsNewPatchNotesBtn}" MinWidth="150" Padding="14,0" Margin="0,0,10,0" Click="BtnPatchNotes_Click" Appearance="Secondary" Height="36" Cursor="Hand"/>
                    <ui:Button Content="{DynamicResource GenericClose}" MinWidth="150" Padding="14,0" Click="BtnClose_Click" Appearance="Primary" Height="36" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
