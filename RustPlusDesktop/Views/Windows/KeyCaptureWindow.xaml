<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.KeyCaptureWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource ConsoleHelperKeyTitle}"
                 Width="420" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource ConsoleHelperKeyTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,10,20,20">
            <TextBlock Text="{DynamicResource ConsoleHelperKeyPrompt}"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                <TextBlock x:Name="TxtCaptured" Text="—" HorizontalAlignment="Center"
                           FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
            </Border>

            <TextBlock x:Name="TxtWarning" Text="" Foreground="#FFFFB86C" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

            <TextBlock Text="{DynamicResource ConsoleHelperMouseHint}"
                       Foreground="{DynamicResource TextSubtle}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,6" />

            <ComboBox x:Name="CmbMouse" Margin="0,0,0,14"
                      SelectionChanged="CmbMouse_SelectionChanged" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnClear" Content="{DynamicResource ConsoleHelperClearKey}"
                           Click="BtnClear_Click" Margin="0,0,8,0" Padding="12,6" />
                <ui:Button x:Name="BtnCancel" Content="{DynamicResource Cancel}"
                           Click="BtnCancel_Click" Margin="0,0,8,0" Padding="12,6" />
                <ui:Button x:Name="BtnOk" Content="{DynamicResource Save}" Appearance="Primary"
                           Click="BtnOk_Click" Padding="12,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
