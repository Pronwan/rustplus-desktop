<ui:FluentWindow x:Class="RustPlusDesk.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        Title="{DynamicResource Camera}" Width="760" Height="580"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent title bar -->
        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Height="42"
                     Title="{DynamicResource Camera}"
                     ShowMinimize="False" ShowMaximize="True"
                     Background="Transparent" Foreground="{DynamicResource TextPrimary}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CameraDome24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <Border x:Name="KindBadge"
                        Margin="12,0,8,0" Padding="10,3"
                        CornerRadius="10"
                        Background="#332F81F7" BorderBrush="#552F81F7" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="KindIcon" Symbol="CameraDome24" FontSize="13" Foreground="#8AB4F8" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtKind" FontSize="11" FontWeight="SemiBold" Foreground="#8AB4F8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Toolbar: stream info + FPS -->
        <Grid Grid.Row="1" Margin="16,2,16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:SymbolIcon Symbol="VideoClip24" FontSize="16" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextSubtle}" FontSize="12" Opacity="0.85"/>
                <TextBlock Text="{DynamicResource FPS}" VerticalAlignment="Center" Foreground="{DynamicResource TextSubtle}"/>
                <ComboBox x:Name="CmbFps" Width="64" Margin="8,0,0,0" SelectedIndex="1">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="15"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Video surface + overlays -->
        <Border Grid.Row="2" Margin="16,0,16,16" CornerRadius="10" ClipToBounds="True"
                Background="#0A0A0C" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <Grid ClipToBounds="True">
                <Image x:Name="Img" Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Crosshair -->
                <Grid x:Name="CrosshairGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Width="16" Height="16" Stroke="#FF4A4A" StrokeThickness="1.5" />
                    <Line X1="-12" Y1="0" X2="-2" Y2="0" Stroke="#FF4A4A" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Line X1="2" Y1="0" X2="12" Y2="0" Stroke="#FF4A4A" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Line X1="0" Y1="-12" X2="0" Y2="-2" Stroke="#FF4A4A" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Line X1="0" Y1="2" X2="0" Y2="12" Stroke="#FF4A4A" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Center banner -->
                <ui:InfoBar x:Name="Banner" Severity="Informational" IsClosable="False" IsOpen="False"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" MaxWidth="420"/>

                <!-- Control HUD -->
                <ui:Card x:Name="ControlBorder" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <!-- Analog joystick: drag the ball; look/move speed scales with distance -->
                        <Grid x:Name="MovementPad" Width="118" Height="118" Cursor="SizeAll" Background="Transparent">
                            <Ellipse Width="118" Height="118" Fill="#16FFFFFF" Stroke="#3AFFFFFF" StrokeThickness="1.5"/>
                            <Ellipse Width="72" Height="72" Stroke="#22FFFFFF" StrokeThickness="1"/>
                            <Ellipse Width="6" Height="6" Fill="#3AFFFFFF"/>
                            <Canvas x:Name="JoyCanvas" Width="118" Height="118">
                                <Border x:Name="JoyThumb" Width="48" Height="48" CornerRadius="24"
                                        Canvas.Left="35" Canvas.Top="35"
                                        Background="#70FFFFFF" BorderBrush="#C0FFFFFF" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- Drone vertical -->
                        <StackPanel x:Name="VerticalPad" Margin="14,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnCamJump" Content="{DynamicResource UiJump}" Icon="{ui:SymbolIcon Symbol=ArrowCircleUp24}"
                                       Margin="0,0,0,8" Padding="10,6" Appearance="Secondary" Focusable="False"/>
                            <ui:Button x:Name="BtnCamDuck" Content="{DynamicResource UiDuck}" Icon="{ui:SymbolIcon Symbol=ArrowCircleDown24}"
                                       Padding="10,6" Appearance="Secondary" Focusable="False"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel x:Name="ActionPad" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:Button x:Name="BtnCamZoom" Content="Zoom" Icon="{ui:SymbolIcon Symbol=ZoomIn24}" Margin="0,0,8,0"
                                       Padding="12,8" Appearance="Secondary" Focusable="False" Visibility="Collapsed" Click="BtnCamZoom_Click"/>
                            <ui:Button x:Name="BtnCamFire" Content="{DynamicResource UiFire}" Icon="{ui:SymbolIcon Symbol=TargetArrow24}" Margin="0,0,8,0"
                                       Padding="12,8" Appearance="Danger" Focusable="False" Visibility="Collapsed"/>
                            <ui:Button x:Name="BtnCamReload" Content="{DynamicResource UiReload}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                       Padding="12,8" Appearance="Secondary" Focusable="False" Visibility="Collapsed" Click="BtnCamReload_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
