<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.AchievementsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource AchievementsTitle}"
                 Width="520" Height="640"
                 MinWidth="420" MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource AchievementsTitle}" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="18,4,18,14">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White"
                       Text="{DynamicResource AchievementsHeading}" />
            <TextBlock x:Name="TxtProgress"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSubtle}" />
            <ProgressBar x:Name="BarProgress"
                         Margin="0,8,0,0"
                         Height="4"
                         Minimum="0"
                         Background="#22FFFFFF"
                         Foreground="{DynamicResource Accent}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="12,0,12,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListAchievements">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6,3" Padding="10,8" CornerRadius="8"
                                Background="{Binding RowBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Earned icons show in full; the rest stay as a dim
                                      silhouette so the shape is a hint but not a giveaway.  -->
                                <Border Grid.Column="0"
                                        Width="52" Height="52"
                                        CornerRadius="7"
                                        Background="#18FFFFFF">
                                    <Grid>
                                        <Image Source="{Binding Icon}"
                                               Width="40" Height="40"
                                               Opacity="{Binding IconOpacity}"
                                               RenderOptions.BitmapScalingMode="Linear" />
                                        <TextBlock Text="?"
                                                   Visibility="{Binding UnknownGlyphVisibility}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#55FFFFFF" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="{Binding NameWeight}"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding EarnedText}"
                                               Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSubtle}"
                                               Visibility="{Binding EarnedTextVisibility}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
