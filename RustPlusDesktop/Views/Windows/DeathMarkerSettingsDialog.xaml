<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.DeathMarkerSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        Title="{DynamicResource UiDeathMarkerSettings}"
        Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource UiDeathMarkerSettings}" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <!-- Self Limit -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static p:Resources.PlayerDeathSelf}" Foreground="#CCC" VerticalAlignment="Center" />
                <Slider x:Name="SldSelf" Grid.Column="1" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" ValueChanged="SldSelf_ValueChanged" />
                <TextBlock x:Name="TxtSelfValue" Grid.Column="2" Text="{Binding Value, ElementName=SldSelf}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Team Limit -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static p:Resources.PlayerDeathTeam}" Foreground="#CCC" VerticalAlignment="Center" />
                <Slider x:Name="SldTeam" Grid.Column="1" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" ValueChanged="SldTeam_ValueChanged" />
                <TextBlock x:Name="TxtTeamValue" Grid.Column="2" Text="{Binding Value, ElementName=SldTeam}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
        
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ui:Button Content="{DynamicResource WipeDeathMarkers}" Appearance="Danger" HorizontalAlignment="Left" Click="BtnWipe_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{x:Static p:Resources.Cancel}" Appearance="Secondary" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <ui:Button Content="{x:Static p:Resources.Save}" Appearance="Primary" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
