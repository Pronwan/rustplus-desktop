<Window x:Class="RustPlusDesk.CommandDockTilePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource CommandDockAddTile}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="320"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" FontSize="16"/>
                    <TextBlock Text="{DynamicResource CommandDockAddTile}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4"
                           Appearance="Transparent" Click="BtnClose_Click"
                           Icon="{ui:SymbolIcon Symbol=Dismiss24}"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource CommandDockPickerHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSubtle}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Catalogue"/>
            </ScrollViewer>

            <TextBlock Grid.Row="3"
                       Text="{DynamicResource CommandDockEditHint}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource TextSubtle}"/>
        </Grid>
    </Border>
</Window>
