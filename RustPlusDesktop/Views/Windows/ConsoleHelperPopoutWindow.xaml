<Window x:Class="RustPlusDesk.Views.Windows.ConsoleHelperPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RustPlusDesk.Views"
        Title="Console Helper"
        Width="500" Height="760"
        MinWidth="400" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF0B1015"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <!-- Frameless, but not layered: AllowsTransparency stays off. A layered window is the worse
         host for popups and buys nothing here, since the panel fills its own rounded shell. -->
    <Grid>
        <views:ConsoleHelperOverlay x:Name="Helper" />

        <!-- Drag handle over the header's title area. It stops short of the right edge so the
             copy, popout and close buttons underneath stay clickable. -->
        <Border x:Name="DragStrip" Height="46" VerticalAlignment="Top"
                Margin="0,0,160,0"
                Background="#01000000" Cursor="SizeAll"
                MouseLeftButtonDown="DragStrip_MouseLeftButtonDown" />
    </Grid>
</Window>
