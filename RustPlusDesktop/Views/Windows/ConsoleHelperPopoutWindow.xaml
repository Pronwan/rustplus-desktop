<Window x:Class="RustPlusDesk.Views.Windows.ConsoleHelperPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RustPlusDesk.Views"
        Title="Console Helper"
        Width="480" Height="720"
        MinWidth="380" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="Transparent" CornerRadius="10">
        <Grid>
            <views:ConsoleHelperOverlay x:Name="Helper" />

            <!-- Drag strip along the top edge. The panel's own header fills that row, so the
                 strip sits above it and only claims the few pixels not already occupied. -->
            <Border x:Name="DragStrip" Height="8" VerticalAlignment="Top"
                    Background="#01000000" Cursor="SizeAll"
                    MouseLeftButtonDown="DragStrip_MouseLeftButtonDown" />
        </Grid>
    </Border>
</Window>
