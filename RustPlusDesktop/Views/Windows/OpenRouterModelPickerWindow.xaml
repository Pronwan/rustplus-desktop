<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.OpenRouterModelPickerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="OpenRouter Model Browser"
                  Width="900" Height="680"
                  MinWidth="700" MinHeight="500"
                  WindowStartupLocation="CenterOwner"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Background="{DynamicResource ApplicationBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="OpenRouter Model Browser" ShowMaximize="True" />

        <!-- Search and Refresh Row -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="TxtSearch"
                        PlaceholderText="Search models by name, creator, or keyword (e.g. claude, gpt-4o, deepseek, llama, free)..."
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        MinHeight="36"
                        VerticalContentAlignment="Center"
                        TextChanged="TxtSearch_TextChanged" />

            <ui:Button Grid.Column="1"
                       x:Name="BtnRefresh"
                       Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                       Content="Refresh"
                       ToolTip="Refresh live catalog from OpenRouter"
                       Appearance="Secondary"
                       Height="36"
                       Margin="8,0,0,0"
                       Padding="12,0"
                       Click="BtnRefresh_Click" />
        </Grid>

        <!-- Filter Tags Row -->
        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="RadFilterAll" Content="All Models" GroupName="ModelFilter"
                             IsChecked="False" Margin="0,0,10,0" Checked="OnFilterChanged" />
                <RadioButton x:Name="RadFilterFree" Content="🎁 Free Only" GroupName="ModelFilter"
                             IsChecked="True" Margin="0,0,10,0" Checked="OnFilterChanged" />
                <RadioButton x:Name="RadFilterPaid" Content="Paid Only" GroupName="ModelFilter"
                             IsChecked="False" Margin="0,0,14,0" Checked="OnFilterChanged" />
                <CheckBox x:Name="ChkFilterVision" Content="👁️ Vision / Image Support"
                          Margin="0,0,10,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Provider:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource TextSubtle}" />
                <ComboBox x:Name="CmbProviderFilter" MinWidth="120" Height="28" SelectionChanged="CmbProviderFilter_SelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Split List (Left) and Details Inspector (Right) -->
        <Grid Grid.Row="3" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: Model List -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <!-- Loading indicator -->
                    <StackPanel x:Name="PanelLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" Margin="0,0,0,8" />
                        <TextBlock Text="Fetching models from OpenRouter..." Foreground="{DynamicResource TextSubtle}" FontSize="12" />
                    </StackPanel>

                    <!-- Empty search state -->
                    <TextBlock x:Name="TxtEmpty" Text="No models match your search."
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSubtle}" FontSize="12" Visibility="Collapsed" />

                    <ListBox x:Name="LstModels"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="LstModels_SelectionChanged"
                             MouseDoubleClick="LstModels_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="6" Padding="2" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                
                                                <!-- Free Badge -->
                                                <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#2622C55E"
                                                        Visibility="{Binding IsFree, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="FREE" FontWeight="Bold" FontSize="9" Foreground="#22C55E" />
                                                </Border>

                                                <!-- Vision Badge -->
                                                <Border Margin="4,0,0,0" Padding="4,1" CornerRadius="4" Background="#263B82F6"
                                                        Visibility="{Binding SupportsVision, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="VISION" FontWeight="SemiBold" FontSize="9" Foreground="#60A5FA" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas, monospace" FontSize="10"
                                                       Foreground="{DynamicResource Accent}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding ContextSummary}" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PricingSummary}" FontSize="10" Foreground="{DynamicResource TextSubtle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <ui:Button Grid.Column="1" Content="Select" Appearance="Secondary" VerticalAlignment="Center"
                                                   Padding="8,4" FontSize="11" Tag="{Binding Id}" Click="BtnSelectModel_Click" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: Details Inspector Card -->
            <Border Grid.Column="2" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <!-- No Selection Placeholder -->
                    <StackPanel x:Name="PanelNoSelection" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="32" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,8" />
                        <TextBlock Text="Select a model to view its full details, context size, and pricing"
                                   Foreground="{DynamicResource TextSubtle}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                    </StackPanel>

                    <!-- Active Model Details View -->
                    <ScrollViewer x:Name="PanelModelDetails" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header: Name & Provider -->
                            <TextBlock x:Name="TxtDetailName" Text="Model Name" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />

                            <TextBlock x:Name="TxtDetailProvider" Text="Provider: OpenAI" FontSize="11"
                                       Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,8" />

                            <!-- Model ID with Copy -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtDetailId" Text="model/id" FontFamily="Consolas, monospace" FontSize="11"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:Button Grid.Column="1" x:Name="BtnCopyId" Icon="{ui:SymbolIcon Symbol=Copy24}"
                                               ToolTip="Copy model ID" Appearance="Transparent" Padding="4,2" Click="BtnCopyId_Click" />
                                </Grid>
                            </Border>

                            <!-- Status & Capability Badges -->
                            <WrapPanel Margin="0,0,0,12">
                                <Border x:Name="BadgeFree" Margin="0,0,6,6" Padding="8,3" CornerRadius="4" Background="#2622C55E">
                                    <TextBlock Text="🎁 100% FREE" FontWeight="Bold" FontSize="10" Foreground="#22C55E" />
                                </Border>
                                <Border x:Name="BadgePaid" Margin="0,0,6,6" Padding="8,3" CornerRadius="4" Background="#26EAB308">
                                    <TextBlock Text="💳 PAID MODEL" FontWeight="Bold" FontSize="10" Foreground="#EAB308" />
                                </Border>
                                <Border x:Name="BadgeVision" Margin="0,0,6,6" Padding="8,3" CornerRadius="4" Background="#263B82F6">
                                    <TextBlock Text="👁️ Vision / Screenshots" FontWeight="SemiBold" FontSize="10" Foreground="#60A5FA" />
                                </Border>
                                <Border x:Name="BadgeTextOnly" Margin="0,0,6,6" Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="💬 Text Only" FontSize="10" Foreground="{DynamicResource TextSubtle}" />
                                </Border>
                            </WrapPanel>

                            <!-- Specifications Card -->
                            <ui:Card Margin="0,0,0,10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="SPECIFICATIONS" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,6" />
                                    
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Context Window:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailContext" Text="128,000 tokens" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Max Output Tokens:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailMaxOutput" Text="8,192 tokens" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Modality:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailModality" Text="text->text" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2" x:Name="RowTokenizer">
                                        <TextBlock Text="Tokenizer:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailTokenizer" Text="Llama3" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Moderated:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailModerated" Text="No" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Pricing Card -->
                            <ui:Card Margin="0,0,0,10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="PRICING (PER 1M TOKENS)" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,6" />

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Prompt (Input):" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailPromptPrice" Text="$0.15" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2">
                                        <TextBlock Text="Completion (Output):" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailCompletionPrice" Text="$0.60" FontWeight="SemiBold" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <Grid Margin="0,2" x:Name="RowImagePrice">
                                        <TextBlock Text="Image Input:" FontSize="11" Foreground="{DynamicResource TextSubtle}" />
                                        <TextBlock x:Name="TxtDetailImagePrice" Text="$0.00" FontSize="11"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>

                            <!-- Description -->
                            <TextBlock Text="DESCRIPTION" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSubtle}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtDetailDescription" Text="Model description text here..." FontSize="11"
                                       Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Primary Action Button -->
                            <ui:Button x:Name="BtnUseSelectedModel" Content="Use This Model" Appearance="Primary"
                                       Height="36" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="BtnUseSelectedModel_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="16,10,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextSubtle}"
                       Text="Loaded models" />

            <ui:Button Grid.Column="1"
                       Content="Close"
                       Appearance="Secondary"
                       Height="30"
                       Padding="16,0"
                       Click="BtnClose_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
