<Window x:Class="RustPlusDesk.CommandDockTemplates"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource CommandDockTemplates}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="350"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner">
    <Border Background="Transparent" Padding="12">
        <Border Background="#141820"
                BorderBrush="#252F3D"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14,16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#1C2738" BorderBrush="#263A54" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save24" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15"/>
                        </Border>
                        <TextBlock Text="{DynamicResource CommandDockTemplates}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Padding="0"
                               Appearance="Transparent" Click="BtnClose_Click"
                               Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                               ToolTip="Close"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{DynamicResource CommandDockTemplatesHint}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSubtle}"/>

                <!-- Saving Arrangement Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtName"
                                PlaceholderText="{DynamicResource CommandDockTemplateNamePlaceholder}"
                                Height="34"
                                Padding="10,6"
                                KeyDown="TxtName_KeyDown"/>
                    <ui:Button Grid.Column="1"
                               Margin="6,0,0,0"
                               Height="34"
                               Appearance="Primary"
                               Content="{DynamicResource CommandDockTemplateSave}"
                               Click="BtnSave_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel x:Name="PresetList"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>
