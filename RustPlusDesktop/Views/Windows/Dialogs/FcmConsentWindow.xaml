<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.Dialogs.FcmConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource UiOfflineAlertsSetup}" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextPrimary}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource UiOfflineAlertsSetup}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CloudArrowUp24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,12">
                <!-- Header -->
                <TextBlock Text="{DynamicResource UiSyncYourRustConnection}"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock TextWrapping="Wrap" Foreground="#DDDDDD" FontSize="14" LineHeight="20" Margin="0,0,0,24">
                    By enabling Offline Alerts, you allow the Rust+ Desktop cloud worker to securely store your FCM credentials. This enables features like Discord Raid Alerts, Alexa Integration, and Telegram Calls to work even when your PC is completely turned off.
                </TextBlock>

                <!-- Info Box -->
                <Border Background="#1E1E1E" CornerRadius="6" Padding="16" BorderBrush="#333333" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiWhatHappensNext}" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource SuccessBrush}" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource UiYourFCMConnectionTokenIsUploadedSecurely}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Checkmark24" Foreground="{DynamicResource SuccessBrush}" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource UiTheCloudWorkerListensForIncomingAlarms}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource SuccessBrush}" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource UiYouCanRevokeThisAccessAtAnyTime}" Foreground="#DDDDDD" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <ui:Button Grid.Column="1" Content="{DynamicResource Cancel}" Margin="0,0,8,0" Click="BtnClose_Click" />
                <ui:Button Grid.Column="2" Content="{DynamicResource UiAcceptSync}" Appearance="Primary" Click="BtnAccept_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
