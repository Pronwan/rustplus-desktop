<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.Dialogs.Cloud247ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Enable Cloud 24/7 — Data &amp; Privacy Consent"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Foreground="{DynamicResource TextPrimary}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Enable Cloud 24/7 — Data &amp; Privacy Consent" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CloudSync24" Foreground="#38BDF8"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel Margin="24,12,24,16">

                <!-- Header Icon & Title Banner -->
                <Border Background="#141820" BorderBrush="#252F3D" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.65" ShadowDepth="2" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CloudCheckmark24" FontSize="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enable Cloud 24/7 Monitoring" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                            <TextBlock Text="Allows RustPlus Desktop Cloud daemons to monitor your active Rust server(s) 24/7 when this desktop app is closed."
                                       TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Agreement Card -->
                <Border Background="#141820" BorderBrush="#252F3D" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="By giving consent, you agree that:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>

                        <!-- Item 1: FCM -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" FontSize="16" Foreground="#10B981" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#CBD5E1">
                                <Run FontWeight="SemiBold" Foreground="#FFFFFF">FCM Push Credentials:</Run> Your notification settings, pairing tokens, and keys will be securely uploaded to <Run Foreground="#38BDF8">rustplusdesktop.cloud</Run> to capture raid alarms and notifications.
                            </TextBlock>
                        </Grid>

                        <!-- Item 2: Server Details -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" FontSize="16" Foreground="#10B981" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="#CBD5E1">
                                <Run FontWeight="SemiBold" Foreground="#FFFFFF">Server Connection Details:</Run> Server IP, Port, Player ID, Player Token, and paired smart devices will be synchronized to keep background monitoring sessions active.
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Security & Privacy Guarantee Card -->
                <Border Background="#10141D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Security &amp; Privacy Guarantees" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Guarantee 1: Database Encryption -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" FontSize="14" Foreground="#38BDF8" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="All credentials and pairing tokens are encrypted at rest at the database level." TextWrapping="Wrap" FontSize="11.5" LineHeight="16" Foreground="#94A3B8"/>
                        </Grid>

                        <!-- Guarantee 2: Account Isolation -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="PersonLock24" FontSize="14" Foreground="#38BDF8" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Credentials and telemetry are strictly bound exclusively to your user account and never shared with anyone else." TextWrapping="Wrap" FontSize="11.5" LineHeight="16" Foreground="#94A3B8"/>
                        </Grid>

                        <!-- Guarantee 3: Revocation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DismissCircle24" FontSize="14" Foreground="#F43F5E" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="You can revoke consent at any time from this window to instantly terminate all cloud workers." TextWrapping="Wrap" FontSize="11.5" LineHeight="16" Foreground="#94A3B8"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="#0B0E14" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Do you want to enable Cloud 24/7 and sync your credentials?" 
                           FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>

                <ui:Button Grid.Column="1" Content="Decline" Appearance="Secondary" Padding="20,8" Margin="0,0,10,0" Click="BtnDecline_Click" Cursor="Hand"/>
                <ui:Button Grid.Column="2" Content="Accept &amp; Enable" Appearance="Primary" Padding="24,8" Click="BtnAccept_Click" Cursor="Hand">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Checkmark24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
