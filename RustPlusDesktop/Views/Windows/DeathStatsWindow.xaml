<Window x:Class="RustPlusDesk.Views.Windows.DeathStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Death Stats"
        Width="700" Height="620"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Shared cell/section styling. -->
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>
            <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />

            <!-- By player -->
            <TextBlock Text="By player" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Victim" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="1" Text="Deaths" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="2" Text="Avg survival" Style="{StaticResource ColHeader}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ByVictim}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Victim}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Deaths}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="2" Text="{Binding AvgSurvival}" Style="{StaticResource Cell}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- By location -->
            <TextBlock Text="By location" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Location" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="1" Text="Deaths" Style="{StaticResource ColHeader}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ByLocation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Location}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Deaths}" Style="{StaticResource Cell}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent -->
            <TextBlock Text="Recent" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Victim" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="1" Text="Location" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="2" Text="Grid" Style="{StaticResource ColHeader}" />
                        <TextBlock Grid.Column="3" Text="Died" Style="{StaticResource ColHeader}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Victim}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Grid}" Style="{StaticResource Cell}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Died}" Style="{StaticResource Cell}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <ui:Button x:Name="BtnClear" Content="Clear log" Appearance="Danger"
                       HorizontalAlignment="Right" Click="BtnClear_Click" />
        </Border>
    </Grid>
</Window>
