<Window x:Class="RustPlusDesk.Views.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RustPlusDesk.Views"
        Title="Rust+ Desktop" Width="688" Height="408"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Margin="24">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <views:BusyOverlay x:Name="LoadingView" />
    </Border>
</Window>
