<Window x:Class="RustPlusDesk.Views.Windows.DockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Widget Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{x:Null}">

    <!--  Background is null rather than Transparent on purpose. A layered window hit-tests per
          pixel: nothing drawn means the click reaches the game underneath. Transparent would
          paint every pixel and swallow the whole screen.  -->
    <Grid>

        <!--  Everything the drag draws: the cell grid across the screen, a veil over the tiles
              already placed, the ghost of the one in flight, and the cell it would land in.
              Never hit-testable - it is a picture of what a release would do, not a target.  -->
        <Canvas x:Name="PaintLayer" IsHitTestVisible="False"/>

        <!--  An outline of a saved arrangement, faded in while its name is hovered in the
              templates window. On this window rather than on the dock because it shows where
              the arrangement will land, which is a place on the screen and not an offset from
              whatever the dock currently happens to be.  -->
        <Canvas x:Name="PreviewLayer" IsHitTestVisible="False" Opacity="0"/>

        <!--  The bar's handle while it is away: a small tab at the top of the screen, shown only
              while the pointer is near the top edge or over the dock. Resting on the very edge
              is the quick way in, but nobody guesses it - and with a monitor stacked above this
              one the pointer never stops on that edge at all. A tab is something to aim at.

              Hit-testable only while shown, so it takes no clicks from the game the rest of
              the time.  -->
        <Border x:Name="PullTab"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Width="64"
                Height="14"
                Opacity="0"
                IsHitTestVisible="False"
                CornerRadius="0,0,8,8"
                Background="#E0101518"
                BorderBrush="#663FD7FF"
                BorderThickness="1,0,1,1"
                Cursor="Hand">
            <TextBlock Text="&#xE70D;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="9"
                       Foreground="#DD3FD7FF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!--  The bar lives here rather than in the dock window because it has to reach the top
              of the screen and span it. Inside the dock it was clipped to the dock's own
              rectangle, which is what made it travel whenever the dock resized.  -->
        <Border x:Name="TitleBar"
                VerticalAlignment="Top"
                Height="34"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#D8101518"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,0,0,1"
                Cursor="SizeAll">
            <!--  Slides in from above the screen as well as fading, so every reveal shows where
                  the bar comes from - and every exit where it went.  -->
            <Border.RenderTransform>
                <TranslateTransform x:Name="BarSlide" Y="-34"/>
            </Border.RenderTransform>
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE700;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="#99FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource CommandDockTitle}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center"/>
                    <!--  Replaces the title while unlocked. Arranging is a mode, and a mode
                          nobody can see is one people get stuck in.  -->
                    <TextBlock x:Name="EditText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FF3FD7FF"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!--  Zoom sits in the middle, where there is room for it at any screen width.
                      It writes through to the dock, which owns the value.  -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Arrow">
                    <TextBlock Text="&#xE71E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="#99FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="SliZoom"
                            Width="160"
                            Minimum="0.75"
                            Maximum="2.5"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="SliZoom_ValueChanged"/>
                    <TextBlock x:Name="LblZoom"
                               FontSize="11"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="38"/>
                </StackPanel>

                <!--  The bar carries a move cursor, because dragging it nudges the grid. Its
                      controls override that: over a button or the zoom slider the pointer says
                      what that thing does instead.  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand">
                    <!--  The way out of arranging, in words. It stands in for the open padlock,
                          which says "unlocked" but not "press here when you are finished".  -->
                    <ui:Button x:Name="BtnDone"
                               Padding="12,3"
                               Margin="0,0,6,0"
                               FontSize="11"
                               Appearance="Primary"
                               Visibility="Collapsed"
                               Click="BtnLock_Click"/>
                    <ui:Button x:Name="BtnLock"
                               Padding="4"
                               Margin="0,0,2,0"
                               Appearance="Transparent"
                               Foreground="White"
                               Click="BtnLock_Click">
                        <TextBlock x:Name="LockGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE72E;"/>
                    </ui:Button>
                    <ui:Button x:Name="BtnTemplates"
                               Padding="4"
                               Margin="0,0,2,0"
                               Appearance="Transparent"
                               Foreground="White"
                               Click="BtnTemplates_Click"
                               ToolTip="{DynamicResource CommandDockTemplates}"
                               Icon="{ui:SymbolIcon Symbol=Save24}"/>
                    <ui:Button x:Name="BtnAddTile"
                               Padding="4"
                               Margin="0,0,2,0"
                               Appearance="Transparent"
                               Foreground="White"
                               Click="BtnAddTile_Click"
                               ToolTip="{DynamicResource CommandDockAddTile}"
                               Icon="{ui:SymbolIcon Symbol=Add24}"/>
                    <ui:Button x:Name="BtnSettings"
                               Padding="4"
                               Appearance="Transparent"
                               Foreground="White"
                               Click="BtnSettings_Click"
                               Icon="{ui:SymbolIcon Symbol=Settings24}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  One-off explanations: the first-run tour of the bar, and the nudge shown when a
              locked widget is dragged. Never hit-testable - a hint that took the click it was
              explaining would be its own problem.  -->
        <Canvas x:Name="HintLayer" IsHitTestVisible="False">
            <Border x:Name="HintBubble"
                    Opacity="0"
                    MaxWidth="360"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="#F2101518"
                    BorderBrush="#993FD7FF"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#FF3FD7FF"
                               VerticalAlignment="Top"
                               Margin="0,1,10,0"/>
                    <TextBlock x:Name="HintText"
                               Grid.Column="1"
                               FontSize="12"
                               Foreground="#E6FFFFFF"
                               TextWrapping="Wrap"
                               LineHeight="17"/>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
