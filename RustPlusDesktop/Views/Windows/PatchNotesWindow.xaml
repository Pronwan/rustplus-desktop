        <Grid x:Name="TranslationConsentOverlay" Visibility="Collapsed" Background="#C0000000">
            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <StackPanel>
                    <TextBlock Text="{DynamicResource TranslationConsentTitle}" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource TranslationConsentText}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                    <TextBlock Margin="0,0,0,16">
                        <Hyperlink NavigateUri="https://codelabs.developers.google.com/codelabs/cloud-translation-csharp" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource TranslationApiLinkText}"/>
                        </Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Decline}" Margin="0,0,8,0" Padding="16,6" Click="BtnDeclineConsent_Click" Background="#404040" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <ui:Button Content="{DynamicResource Accept}" Appearance="Primary" Padding="24,6" Click="BtnAcceptConsent_Click" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
