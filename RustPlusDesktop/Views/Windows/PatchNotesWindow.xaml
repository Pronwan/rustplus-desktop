<ui:FluentWindow x:Class="RustPlusDesk.Views.PatchNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:RustPlusDesk.Views"
        Title="{DynamicResource PatchNotes}"
        Width="1060" Height="760"
        MinWidth="840" MinHeight="580"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Window TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource PatchNotes}" ShowMaximize="True" ShowMinimize="True"/>

        <!-- Top Header & Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="12,4,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Version Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Sparkle24" Foreground="{DynamicResource Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource PatchNotesHeader}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Background="{DynamicResource BrandOrangeBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding CurrentVersionFormatted, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Changelog &amp; Release Archive" FontSize="11" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center/Right Search & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <ui:TextBox x:Name="TxtSearch"
                                Width="300"
                                Height="36"
                                PlaceholderText="Search patch notes... (e.g. AI, Heatmaps, Alarms, Discord)"
                                Icon="{ui:SymbolIcon Symbol=Search24}"
                                ClearButtonEnabled="True"
                                VerticalContentAlignment="Center"
                                TextChanged="TxtSearch_TextChanged"
                                Margin="0,0,10,0"/>

                    <!-- Google Translate Button -->
                    <ui:Button x:Name="BtnTranslate"
                               Height="36"
                               Padding="12,0"
                               Margin="0,0,6,0"
                               Appearance="Secondary"
                               Cursor="Hand"
                               Click="BtnTranslate_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Translate24" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource TranslateViaGoogle}" VerticalAlignment="Center" x:Name="TxtTranslate"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Scroll Top Button -->
                    <ui:Button x:Name="BtnScrollTop"
                               Height="36"
                               Width="36"
                               Padding="0"
                               Appearance="Transparent"
                               ToolTip="Scroll to Latest Release"
                               Cursor="Hand"
                               Click="BtnScrollTop_Click">
                        <ui:SymbolIcon Symbol="ArrowUp24"/>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Content Body -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Version Navigation List -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="4,2,4,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="History24" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                            <TextBlock Text="Release History" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="TxtVersionCountBadge" Text="47 Releases" FontSize="10" Foreground="{DynamicResource TextSubtle}"/>
                        </Border>
                    </Grid>

                    <!-- Filter Category Select Component -->
                    <ComboBox x:Name="CmbCategoryFilter"
                              Grid.Row="1"
                              Height="34"
                              Margin="2,0,2,8"
                              Padding="8,4"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbCategoryFilter_SelectionChanged">
                        <ComboBoxItem Tag="All" IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Layer24" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="All Releases" VerticalAlignment="Center" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Major">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                <TextBlock Text="Major Updates" VerticalAlignment="Center" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Hotfix">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="Hotfixes Only" VerticalAlignment="Center" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <!-- Version Navigation Items -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SidebarVersionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,5"
                                            Background="{DynamicResource SurfaceAlt}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Cursor="Hand"
                                            Tag="{Binding TargetCardName}"
                                            MouseLeftButtonUp="VersionItem_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Version Badge & Status Pill -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                                    <!-- LATEST Pill if true -->
                                                    <Border Visibility="{Binding IsLatest, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="{DynamicResource BrandOrangeBrush}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                                        <TextBlock Text="LATEST" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Category Badge -->
                                                <Border HorizontalAlignment="Right" Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{DynamicResource TextSubtle}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Version Headline -->
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource TextSubtle}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter/Spacer -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- Right Main Area: Detailed Patch Notes -->
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12,6,12">
                <Grid>
                    <ScrollViewer x:Name="NotesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel x:Name="PatchNotesContent">

                            <!-- ============================================== -->
                            <!-- v10.0.3 HOTFIX -->
                            <!-- ============================================== -->
                            <Border x:Name="Card_v10_0_3"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrandOrangeBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="LATEST RELEASE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="v10.0.3 | Cloud 24/7 &amp; Lease Dominance Hotfix"
                                                       FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Cloud 24/7 Desktop Lease Heartbeat:</Run>
                                        Fixed an issue where the desktop lease would lapse after 90 seconds, causing the cloud worker to prematurely take over active sessions while the desktop app was still running. A recurring heartbeat now keeps the desktop client dominant while connected.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Live Web Map Data Stream:</Run>
                                        The live dashboard web map now continuously pulls real-time snapshots (markers, player coordinates, game time) from the cloud worker even when the desktop client is active.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Offline Alerts &amp; Consent Dialog Hardening:</Run>
                                        Offline alert webhook setup now checks existing global consent properly and avoids redundant modal prompts.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ============================================== -->
                            <!-- v10.0.2 HOTFIX -->
                            <!-- ============================================== -->
                            <Border x:Name="Card_v10_0_2"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="v10.0.2 | Patch Notes Fixes"
                                                       FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; The Overlay Screenshot:</Run>
                                        The picture in the v10.0.1 notes below was missing from the build and showed as an empty frame. It is in the installer now.
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                        <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; v10.0.1 in the Release History:</Run>
                                        The sidebar skipped straight from v10.0.0 to v9.2.2, so the release you were reading about could not be selected from it.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ============================================== -->
                            <!-- v10.0.1 HOTFIX -->
                            <!-- ============================================== -->
                            <Border x:Name="Card_v10_0_1"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="v10.0.1 | Widget Overlay Rework"
                                                       FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimary}">
                                            The grid you arrange widgets on now covers the whole screen instead of being cut off at the edge of the dock, and the bar that arranges it sits at the top of your monitor. That fixes a handful of things at once: the overlay no longer walks down the screen a little further with every widget you place, widgets no longer take focus away from the game when you press them, and a saved arrangement lands where its preview said it would. Along the way the widgets learned to be bigger — there is a zoom for the whole grid now, which is the thing 4K screens were missing.
                                        </TextBlock>
                                    </Border>

                                    <!--  The one change that needs saying out loud: the gesture for entering edit
                                          mode is different, and nobody will find it by accident.  -->
                                    <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowUp24" Foreground="{DynamicResource Accent}" FontSize="17"
                                                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="How to edit the overlay now"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,3"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextPrimary}">
                                                    Move your mouse to the very top edge of the screen and hold it there for half a second — the overlay bar fades in, and its padlock unlocks the grid. Hovering a widget no longer brings the bar out. That was the whole problem with it: resting on a timer or holding over a switch while playing armed the delete buttons, which is the last thing you want mid-raid. The top edge is somewhere the mouse only goes on purpose.
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Overlay -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Grid24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="The Overlay" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; A Grid Across the Screen:</Run>
                                            Dragging a widget now shows every cell it could land in, all the way to the edges of your monitor — including the ones left of and above the dock, which is how you build a bar along a screen edge. Widgets already placed are veiled in blue, so you can see what is taken at a glance, and the cell you are about to drop into stays blue when it fits and turns red when it does not.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; The Overlay Stays Put:</Run>
                                            It used to drift down the screen by one cell every time you placed a widget, so the bar had to be dragged back up after each one. The grid needed room, the window grew to make it, and at the top of the screen the correction it made for that got clamped away. With the grid on its own window, none of that is needed.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Widget Zoom:</Run>
                                            A slider in the overlay bar scales the whole grid from 75% to 250%. The cells grow and everything inside them grows with them — the text, the icons, the buttons. Font size alone only ever grew the writing inside a box that stayed the same, which is why one-cell widgets were so small on a 4K screen. Saved with each template.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; No More Stolen Focus:</Run>
                                            Pressing a widget used to pull Rust out of focus, because clicking a window activates it. It does not any more. The two text boxes that do need the keyboard — the Discord line and the translate box — still take it while you are typing in them, and unlocking the overlay to arrange it hands focus over properly so editing stays responsive with the game running.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; A Grid That Does Not Move:</Run>
                                            The map used to push every column and row behind it sideways, by however many pixels its free size overshot a whole cell — so the snap points shifted as you dragged the map's size slider. The map now sits over the grid rather than displacing it. It still reserves its cells, so nothing lands underneath it.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Templates Land Where They Look:</Run>
                                            The outline you see when hovering a template is now drawn where the arrangement will actually sit, on the screen, at the size it was saved at. Loading a wide arrangement also pulls the whole overlay back onto the screen instead of letting the right-hand widgets fall off it. And the map's shape — round, square or 16:9 — is saved with the template now, instead of snapping back to round every time you switched.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Widgets -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Widgets &amp; Map" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; New: Wipe Death Markers:</Run>
                                            One cell with the death marker on it and the number currently on your map in the corner. One press clears them — all of them, or all but the newest for you and each teammate, whichever you set. It keeps out of the way until there is something to clear. Clearing them meant a button under the team list until now, four levels away from the map it was about.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; No-Build Zones on the Mini-Map:</Run>
                                            The building blocked zones are a mini-map layer now, switchable on their own like the grid and the death markers — see them on the small map while the big one stays clean, or the other way round. Available once the map has been parsed.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Death Marker Limits in Map Settings:</Run>
                                            How many markers each player keeps is now also under Settings &#x2192; Map, where you would look for it, and not only behind the small button next to the markers under the team list.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Tidier Widget Picker:</Run>
                                            Collapse and Wipe Death Markers have moved out of the AI Companion section, where neither of them belonged, into a General heading at the top.
                                        </TextBlock>
                                    </StackPanel>

                                    <views:ImageGallery Margin="0,4,0,4">
                                        <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/10.0/new-overlay.jpg" Description="The reworked Widget Overlay: the grid spans the screen, widgets already placed are veiled in blue, and the bar sits at the top of the monitor with the new zoom slider"/>
                                    </views:ImageGallery>
                                </StackPanel>
                            </Border>

                            <!-- ============================================== -->
                            <!-- v10.0.0 HERO PATCH NOTES -->
                            <!-- ============================================== -->
                            <Border x:Name="Card_v10_0_0"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Header Banner -->
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="v10.0.0 | Widget Overlay, AI Companion, Map Layers &amp; Global Chat"
                                                       FontWeight="Bold" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Summary Lead Box -->
                                    <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimary}">
                                            The mini-map has grown into a command centre you can build yourself: the map is now one widget among many, and clocks, smart switches, chat, translation, session stats, server population and Discord can sit around it in any arrangement you like. Alongside it comes the AI Companion — hold a key, ask a question out loud, and get an answer without leaving the game. The map learned to read the server's own files, so heatmaps and keycard layers no longer need the 3D world built first. Global chat now comes to you instead of waiting four levels down. The death screen can be read for the name of whoever killed you. And there are 31 achievements to find along the way.
                                        </TextBlock>
                                    </Border>

                                    <!-- Backers: quiet, but visible enough to read as a thank-you -->
                                    <Border Background="#14FFC14D" BorderBrush="#4DFFC14D" BorderThickness="1" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,14" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Heart24" Foreground="#FFC14D" FontSize="15"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Big shoutout to our September backers"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFC14D"
                                                           Opacity="0.9"/>
                                                <TextBlock Text="Søster Frank Den Koselige Sauen  ·  Donald Farrar"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Widget Overlay -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Grid24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Widget Overlay" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Widgets Around the Map:</Run>
                                            Open the mini-map and press + to add a widget. Digital, analogue and Rust-styled clocks, any paired smart switch or alarm, team and clan chat, the event timers, Logic Engine rules, session stats, server population and a Discord line — each one lands in the first free cell next to the map and can be dragged anywhere from there.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; The Map Is a Widget Too:</Run>
                                            It can be moved, or removed entirely for a bar of switches along the edge of your screen. Its five layers — texture, grid, drawings, icons, players — switch on and off separately, and death markers have their own.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Styled Globally or One at a Time:</Run>
                                            Text colour, text size and transparency are set once for the whole dock, and any widget can override all three from its own gear. A dock turned nearly invisible still reads over snow and water, because the text keeps a shadow while the background fades.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Lock It, and Save Arrangements:</Run>
                                            A lock in the title bar puts the layout beyond accidental dragging. Arrangements save the whole dock under a name — hover one to see it outlined in place before you load it, and a default template is always there to start from.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; A Translate Tile, With a Microphone On It:</Run>
                                            Paste a line out of game chat and read it back in your own language, or type your own and read it back in theirs. The answer sits behind the flag of the language it came back in; click the flag for a grid of every language the app ships. The microphone writes down what it hears and translates that — Windows' own recogniser by default, or the AI model if you have a key, which works the language out for itself. Google or the model is a choice in the tile's settings, and a key removed later falls back to Google rather than failing.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; One Button to Clear the Dock:</Run>
                                            A collapse tile hides every other tile where it stands, and brings the arrangement back unchanged on the second press — nothing is moved or removed, so there is nothing to re-flow. A setting decides whether the mini-map goes with them; off by default, since the usual reason to clear the dock is to see the game with the map still on it. The collapsed state survives a restart.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- AI Companion -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Bot24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="AI Companion" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Ask Out Loud, Keep Playing:</Run>
                                            Press the widget or hold your push-to-talk key, ask, and the answer appears in a panel under the tile or is read to you. You can attach a screenshot — it counts three down first, so you are back in the game before the shutter, and the app takes itself out of the picture.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Your Key, Your Account, Your Model:</Run>
                                            Choose GPT, Gemini, Claude or OpenRouter and paste your own API key. GPT and Gemini take the recording itself; Claude and OpenRouter do not accept audio, so it is transcribed on your PC first, which is slower and weaker on names. Gemini has a free allowance; the others need their own prepaid credit, separately from any chat subscription.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Stored Locally, Sent Nowhere Else:</Run>
                                            The key is kept on your PC, protected by your Windows account, and is never uploaded. Recordings go straight from your machine to the provider you chose and never pass through our servers. One key per provider, so switching between them no longer overwrites the other.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; It Knows the Current Patch:</Run>
                                            Crafting recipes and raid costs are sent from the app's own data with every question, so it answers with what a metal wall costs today rather than what it cost two updates ago.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; !ai in Team and Clan Chat:</Run>
                                            Ask from inside the game and the answer comes back in chat, kept to a line or two. Off for everyone but you until you allow it, with a per-teammate hourly limit when you do — every answer is billed to your key.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Hundreds of Models Through One Key:</Run>
                                            The OpenRouter picker fetches the free models on its own and lets you search every other one by name, provider or vision support, with its price and context length shown before you pick it. Reasoning effort, temperature, token ceiling, provider fallbacks and whether your prompts may be logged are all yours to set.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Tell It How to Answer:</Run>
                                            Your own prompt rules are carried with every question. Answers are kept short enough for a chat line, the model's own thinking is stripped out of the reply, and questions about raiding are understood as being about a video game rather than refused.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Heatmaps -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Map24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Heatmaps Without the 3D Map" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Just Press Heatmaps:</Run>
                                            Heatmaps used to require building the whole 3D map first. Now the button asks whether to read the server's map file, finds it the same way the 3D map does, and shows the layer — no 3D build, no waiting for a world to be rendered. The keycard layers ask the same question, and Layers has a "Parse all map data" button for doing it up front.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Extra Monuments Come Along:</Run>
                                            The same read also brings in the places the server never tells you about — icebergs, oases, caves, water wells, ice lakes, jungle ruins and swamps — plus the building blocked zones. They appear on the 2D map straight away.
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; HQM Nodes &amp; Player Spawns:</Run>
                                            High Quality Metal has its own layer now. Where a fresh spawn washes up: beach, tier 0 or 1, temperate or tundra, never on a cliff, monument, road or river.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Keycards -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Key24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Keycards" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Two Questions, Two Layers:</Run>
                                            Card Readers shows which cards the doors at a place want. Keycards shows which card you can walk away with. Most monuments do one and not the other — Launch Site has readers but holds nothing, a supermarket the reverse — so they switch on separately.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Global Chat -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Chat24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Global Chat" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; One Line on Every Tab:</Run>
                                            A strip along the bottom of the window shows whoever is talking, wherever you are in the app — chat is no longer somewhere you have to decide to go. Mentions notify you with toasts and highlighted counters.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Who Killed You -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="PersonWarning24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Who Killed You" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; Read Off Death Screen:</Run>
                                            A tile appears on the dock the moment the game reports a death and files the killer's name and weapon using native Windows OCR.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Achievements & Interface -->
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                                <ui:SymbolIcon Symbol="Trophy24" Foreground="{DynamicResource Accent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Achievements &amp; Fluent Interface" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" LineHeight="19">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">&#x2022; 31 Discoverable Achievements:</Run>
                                            Earned by discovering what the app can do — pairing devices, 3D map building, and widgets. The trophy icon keeps your list with unread notification badges.
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Gallery for v10.0 -->
                                    <views:ImageGallery Margin="0,4,0,4">
                                        <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/10.0/CommandDock.jpg" Description="The Widget Overlay: the mini-map as one widget among clocks, smart switches, chat, session stats and server population, each styled globally or on its own"/>
                                        <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/10.0/ai-chat-command.jpg" Description="The AI Companion answering !ai from in-game chat — your own key, your own model, and a per-teammate hourly limit when you let the team use it"/>
                                        <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/10.0/heatmaps.jpg" Description="HQM Nodes as a heatmap layer, with Player Spawns beside it — reachable straight from the 2D map, without building the 3D world first"/>
                                        <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/10.0/keycards.jpg" Description="Card Readers and Keycards as separate layers: what the doors here want, and what you can pick up — an underwater lab wanting two blue rooms, a ferry terminal holding a green and a blue card"/>
                                    </views:ImageGallery>
                                </StackPanel>
                            </Border>

