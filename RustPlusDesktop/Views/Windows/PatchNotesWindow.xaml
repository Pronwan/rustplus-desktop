<Window x:Class="RustPlusDesk.Views.PatchNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RustPlusDesk.Properties"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:RustPlusDesk.Views"
        Title="{DynamicResource PatchNotes}"
        Width="720" Height="620"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="14" Margin="8">
        <Grid>
            <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PatchNotesHeader}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <!-- UPDATE VERSION NUMBER HERE -->
                        <TextBlock Text="{Binding CurrentVersionFormatted, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,4"/>
                    </StackPanel>

                    <Button x:Name="BtnTranslate" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,4" Click="BtnTranslate_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Translate24" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource TranslateViaGoogle}" VerticalAlignment="Center" x:Name="TxtTranslate"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PatchNotesContent" Margin="0,0,0,12">
                    <!-- ============================================== -->
                    <!-- NEW v9.2.0 PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.2.0 | Tickets, Notifications &amp; a Friendlier Chat" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#D0D0D0">
                                You can now reach us from inside the app. A new Tickets tab lets you appeal a mute, report a bug with screenshots and logs attached for you, ask for help, or suggest a feature — and reply back and forth once we answer, without leaving Rust+. A bell in the title bar collects replies and announcements as they arrive, with a chime and a toast so you never miss one. And the community chat now keeps things civil for everyone.
                            </TextBlock>

                            <TextBlock Text="🎫 Tickets" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; A Tab for Anything You Want to Tell Us:</Run>
                                Open the Tickets tab from the sidebar to raise a mute appeal, a bug report, a help request, a feature idea, or anything else. It sits in the workspace like the Recycler, so it never covers your device panel.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Bug Reports Gather Their Own Evidence:</Run>
                                Pick the bug category and the app quietly attaches a recent-log snapshot and your latest crash report, so we can look into it without a back-and-forth first. You can add your own screenshots and files too.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Replies in Real Time:</Run>
                                When we answer, your ticket becomes a two-way conversation that updates live. Unread badges on the sidebar and on each ticket show exactly where there is something new to read.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Attachments You Can Actually See:</Run>
                                Images you attach show as thumbnails before you send and stay visible in the conversation afterwards, drawn from your own upload so there is nothing to re-download. Coloured status pills tell an open ticket from a resolved or closed one at a glance.
                            </TextBlock>

                            <TextBlock Text="🔔 Notifications" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; A Bell in the Title Bar:</Run>
                                Ticket replies and announcements from the team collect under a bell with an unread count. A distinct chime and a toast announce each one as it arrives, so you notice it even when you are deep in the map.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Announcements With a Button:</Run>
                                Some announcements carry a link — a patch page, a form, a giveaway — as a button you can click straight from the notification.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Clear Them Your Way:</Run>
                                Dismiss a single notification, or clear them all at once. Cleared ones stay out of the way and only genuinely new ones come back.
                            </TextBlock>

                            <TextBlock Text="💬 Community Chat" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; A Line Nobody Has to Cross:</Run>
                                Global and supporter chat now flag profanity with a friendly warning first. Repeated offences lead to a short, escalating timeout, and only persistent abuse leads to a mute — which you can appeal with a ticket. The goal is a chat that stays welcoming without anyone getting surprised.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- NEW v9.1.1 PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.1.1 | Responsiveness &amp; Smarter Updates" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#D0D0D0">
                                A maintenance release, mostly about the app feeling immediate again. Some players saw the window take seconds to react to a hover; that had a specific cause and it is fixed. Updates now download as small delta patches in the background and install on exit, so you are not made to wait for them.
                            </TextBlock>

                            <TextBlock Text="⚡ Responsiveness" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Sidebar Hover Delays Fixed:</Run>
                                The decorative item icon in the sidebar searched the icon cache from disk on every single hover, decoding full-size images until it found a small one. On a large cache that could cost seconds and hundreds of megabytes. It now prepares a small set once, in the background, and never touches the disk again.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Reduce UI Effects:</Run>
                                A new setting turns off the Mica window backdrop, which Windows composes rather than the app. Worth trying if the window still feels sluggish on your machine. Requires a restart.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Icon Downloads That Stop:</Run>
                                Icons that do not exist on the server were requested again on every launch and the failures were reported as successes. They are now remembered and the count tells the truth.
                            </TextBlock>

                            <TextBlock Text="🔄 Updates" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Background Delta Downloads:</Run>
                                Updates are fetched in the background only when a small delta patch is available, and applied quietly when you close the app instead of interrupting a session.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Automatic Updates Can Be Turned Off:</Run>
                                A toggle in Settings for anyone who would rather decide when to update.
                            </TextBlock>

                            <TextBlock Text="⚙ Settings" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Reorganised:</Run>
                                Settings are grouped into labelled rows with dividers, so related options sit together instead of forming one long list.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- NEW v9.1 PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.1 | Community Hub, Farm Routes &amp; Clan Chat Commands" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#D0D0D0">
                                Version 9.1 opens the app up to other players: a Community Hub with global and supporter chat, replies, translation, group finding with Steam profile previews, a friend list and reporting. On the map, farm routes now measure themselves in metres and sprint seconds. Chat commands reach clan chat, with per-role permissions. And the Player Wipe Tracker no longer saturates your upload while it backs up.
                            </TextBlock>

                            <!-- Community Hub -->
                            <TextBlock Text="🌐 Community Hub" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Global Chat &amp; Supporter Chat:</Run>
                                A shared room for everyone using RustPlus Desktop, and a second one reserved for supporters. Messages arrive live over the cloud connection, so a reply shows up while you are still on the map.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Looking for Group &amp; Looking for Mates:</Run>
                                Post what you are after &#x2014; a wipe partner, a full team, a language you actually speak &#x2014; or browse what others posted. Filter by language and by who is online right now.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Steam Profile Preview Before You Answer:</Run>
                                Every listing shows the poster's Steam profile before you reply, so you can see who you would be teaming up with rather than finding out afterwards.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Friend List:</Run>
                                Add people by Steam ID with a single message. They receive a message request and a friend request as two separate decisions, so nobody can be spammed into a conversation. The list shows who is online, which server they are on and how large their team is.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Inbox, Blocking &amp; Reporting:</Run>
                                Requests and conversations live in their own tab with unread badges. Anyone can be blocked, and messages can be reported with a reason. Misconduct is acted on against the Steam ID.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Replies:</Run>
                                Answer a specific message and it is quoted above yours. Click the quote to jump back to the original. If that message is later deleted, the reply keeps the quote and says so rather than losing the fact that it was an answer.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Translate a Message:</Run>
                                Right-click any message to translate it into the language the app is running in. You are asked once before anything is sent.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Supporter Name Colours:</Run>
                                Supporters can pick from eight colours for their name in chat, chosen to stay readable on both the dark and the light theme. The swatch sits next to the emoji button.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; A Tidier Right-Click Menu:</Run>
                                Copying a message&#x2019;s text is new, and works on your own lines too. Reporting, blocking and befriending yourself are gone &#x2014; the menu on your own messages is just the entries that mean something. Right-clicking now works across the whole line rather than only over the name.
                            </TextBlock>

                            <!-- Player Wipe Tracker -->
                            <TextBlock Text="📊 Player Wipe Tracker" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Cloud Backup No Longer Floods Your Connection:</Run>
                                Every new observation re-sent the player&#x2019;s entire day, once per team poll, with a body that grew until midnight &#x2014; enough to saturate a home upload and put the game&#x2019;s own traffic behind it. Only new observations are sent now, once a minute and capped in size. If you saw your ping climb while RustPlus Desktop was open, this was why.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Long Days Are Backed Up Again:</Run>
                                Past a certain size the server refused the day outright and the client treated that as final, so an active wipe stopped being backed up partway through the day &#x2014; while still using all that bandwidth. Both ends were fixed.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; A New Wipe No Longer Hits a Wall:</Run>
                                Reaching your plan&#x2019;s wipe limit used to stop the backup at the worst moment. The oldest archive is now removed to make room, and the app tells you which one went. At one slot left it warns you first, so you can delete a different one under Wipe Tracker &#x203A; Cloud restore instead.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Refusals Are Explained:</Run>
                                When the cloud declines a backup, the reason now appears in the console instead of the tracker quietly saving nothing.
                            </TextBlock>

                            <!-- Farm Routes -->
                            <TextBlock Text="🗺️ Farm Routes with Distance &amp; Sprint Time" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Draw Routes on the Map:</Run>
                                A Routes mode next to the map layers, with its own legend: name each route, give it a colour, show or hide it. Draw on from the end to extend a route; come back to the start and it closes into a lap.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Length and How Long It Takes:</Run>
                                Every route reports its length in metres or kilometres (yards and miles on imperial) and how long it takes at sprint speed, so you can tell a farm run apart from a hike before you walk it.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Shared With Your Team:</Run>
                                Routes sync with the rest of your map overlay. A teammate's route is imported under their name in brackets and can be deleted like your own.
                            </TextBlock>

                            <!-- Clan Chat Commands -->
                            <TextBlock Text="🏰 Clan Chat Commands &amp; Alerts" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Commands in Clan Chat, Granted per Role:</Run>
                                Team chat answers commands as before; clan chat can be switched on alongside it. The clan's own roles are read from the server and you decide which of them may use commands. Answers go back to the chat the command came from.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Base Codes and Switches Stay Out by Default:</Run>
                                A door code posted in clan chat cannot be taken back, and most clan members have no tool cupboard rights on your base anyway. Both are excluded until you deliberately include them.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Chat Alerts to Team or Clan:</Run>
                                Alerts go to one in-game chat or the other, chosen in the Chat Alerts settings. Timers keep reporting to the chat they were started from, whatever that choice is.
                            </TextBlock>

                            <!-- Smart Home -->
                            <TextBlock Text="🏠 Smart Home" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Home Assistant via REST API:</Run>
                                Smart switches can now be driven from Home Assistant over a REST endpoint, for anyone who would rather run their own automation than depend on a voice assistant.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Improved Alexa Endpoints:</Run>
                                Additional regional endpoints are in review with Amazon, so device discovery works reliably outside Europe as well.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Google Home &#x2014; Where It Stands:</Run>
                                The integration is built and passes Google's full test suite. Launching it requires certification, and Google's programme is aimed at commercially available hardware, so an integration for virtual in-game devices may well not be certified. We will keep you posted either way.
                            </TextBlock>

                            <views:ImageGallery>
                                <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/9.1/CommunityHub.jpg" Description="The Community Hub: global chat, supporter chat, group finding and your inbox, with unread badges down to the individual conversation"/>
                                <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/9.1/FarmRoutes.jpg" Description="Farm routes drawn on the map, each with its own colour and visibility, reporting length in metres and how long the run takes at sprint speed"/>
                                <views:GalleryItem ImagePath="pack://application:,,,/Assets/Screenshots/9.1/Clan-Chat-Commands-AndAlerts.jpg" Description="Clan chat commands with per-role permissions, base codes and switches excluded by default, and the choice of whether alerts go to team or clan chat"/>
                            </views:ImageGallery>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- NEW v9.0.3 HOTFIX PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.0.3 | Pairing Reliability, Wipe Tracker &amp; Splash Refresh" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; "I Can't Pair Servers" Should Now Fix Itself:</Run>
                                A push token can stop working while everything still looks healthy &#x2014; the connection is up and the stored expiry date is still days away, but pairings and alarms quietly never arrive. The only cure was Reset + Re-pair. The app now checks shortly after start whether notifications actually reach it, by sending itself one, and renews the registration on its own when they do not. No browser, no Steam login, nothing to click. If the renewal is not possible, a notification appears with a button that re-pairs for you.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Fewer Dropped Push Connections:</Run>
                                The connection to Google's push servers sat silent for five minutes at a time, long enough for many home routers to quietly discard it. It is now kept alive every minute, which removes most of these drops &#x2014; along with the connection error that used to appear in the console after a router cleaned up the idle connection.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Player Wipe Tracker Now Records When Enabled Mid-Session:</Run>
                                Fixed an issue where enabling the Player Wipe Tracker in Settings while already connected would not start recording. The tracker session now re-syncs the moment the setting is toggled on.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Wipe Tracker No Longer Turns Itself Off:</Run>
                                The tracker and its cloud backup are now controlled only by their own toggles, so changing another setting or reloading the settings panel can no longer switch them off behind your back.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Steam Identity Race Fix:</Run>
                                The tracker now self-heals when your Steam ID resolves a moment after connecting, so observations are no longer silently dropped for the local player.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Dashboard Portal Button:</Run>
                                The Cloud Portal button in the top bar now opens your account dashboard directly at rustplusdesktop.cloud/dashboard.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Refreshed Splash Screen:</Run>
                                A new startup splash with fresh artwork, a brighter progress sweep, and clearer status messages that tell you what the app is actually doing while it loads.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- v9.0.2 HOTFIX PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.0.2 | Alexa, Discord Map &amp; Push Notification Hotfix" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Push Notifications Stopped After a Dropped Connection:</Run>
                                When the connection to Google's push servers was reset, the listener kept believing it was still connected and quietly stopped delivering pairings and alarms until the app was restarted. It now notices the drop and reconnects on its own within seconds. Two related faults were fixed alongside: the previous connection was never released, and a single drop could leave two listeners running and deliver every notification twice.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Alexa PIN Rejected as Invalid:</Run>
                                A PIN generated in the app was always refused when linking the Alexa skill, because the upload lost its contents on the way to the cloud. Linking works again.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; /map and /mapfull in Discord:</Run>
                                Both commands failed with a missing-channel error after the cloud migration. The map is posted again, in the channel the command was used in where the platform provides it, and in your configured chat channel otherwise.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- v9.0.1 HOTFIX PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.0.1 | Discord Channels Configuration Hotfix" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Discord Channel Notifications Config Fix:</Run>
                                Fixed an issue where saving Discord channel configurations in Settings threw a type mismatch error when querying cloud guild settings. Channel notifications configurations are now properly loaded, saved, and synced.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- v9.0.0 PATCH NOTES -->
                    <!-- ============================================== -->
                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="v9.0.0 | Cloud Sync, Clan 2.0, Wipe Tracker &amp; Genetics 2.0" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#D0D0D0">
                                Version 9.0.0 is a massive milestone release featuring an overhauled Clan System with accurate in-game banner rendering and large banner showcase, native in-process FCM notifications, an overhauled native Player Wipe Tracker with Cloud wipe map syncing, a revolutionary Genetics Lab 2.0 solver architecture with live camera OCR scanning, fully rebuilt native CCTV camera controls with an analog joystick, built-in Rust Console Helper &amp; Overlays, Team Base Codes sharing, and end-to-end performance and stability improvements.
                            </TextBlock>

                            <!-- Clan System & Banner Overhaul -->
                            <TextBlock Text="🏰 Clan System &amp; In-Game Banner Overhaul" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Accurate In-Game Banner Colors:</Run>
                                Re-engineered clan banner color unpacking to match Facepunch's 0xRRGGBBAA wire format. Accurately renders all 8 in-game cloth banner colors (Red, Orange, Yellow, Light Blue, Olive Green, Purple, White, and Black) with zero tint distortion.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Large Clan Banner Showcase Tooltip:</Run>
                                Hovering over clan details now presents a high-resolution 270&#xD7;170px clan banner showcase with the true banner background color, drawn clan insignia, MOTD announcement card, and full clan statistics.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Pure Native WPF Context Menus:</Run>
                                Replaced all context menus across the app (Clan tab, Team tab, Player Tracker, and Server Manager) with pure WPF vector SVG icons for opening Steam profiles, copying Steam IDs, and player tracking.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Clan Chat History &amp; Duplicate Filter:</Run>
                                Fixed clan chat message timestamp parsing and hardened history polling against phantom duplicate messages.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Native In-Process FCM Listener:</Run>
                                Introduced a high-performance in-process FCM listener enabled by default, reducing memory usage and delivering instant pairing notifications without requiring external Node processes.
                            </TextBlock>

                            <!-- Genetics Lab 2.0 -->
                            <TextBlock Text="🧬 Genetics Lab 2.0 &amp; Ultra-Fast Solver" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Pre-Allocation Admission Solver Engine:</Run>
                                Ground-up rewrite of the crossbreeding solver using 18-bit bit-packed genotypes, integer weights, and zero-allocation candidate pruning. Delivers 24&#xD7; to 40&#xD7; faster calculation speeds (dropping complex 100+ plant searches from minutes down to seconds) while reducing UI thread blocking by 99%.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Phone Camera Scanner &amp; Gene OCR (Beta):</Run>
                                Scan plant gene sequences directly from your screen or mobile camera. Features a dual-recognizer pipeline combining template classification with Otsu-thresholded OCR, handheld shake tolerance, and per-slot legibility confirmation.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Farm Operations Planner &amp; Route Inspector:</Run>
                                Complete redesign of the route inspector and farm planning workflow with step-by-step crossbreeding guides, plant inventory tracking, and crop cycle management.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Fluid Animations &amp; Accessibility:</Run>
                                Added smooth FLIP grid animations, staggered result entry, interpolated progress, and full WCAG accessibility support across the genetics suite.
                            </TextBlock>

                            <!-- Player Wipe Tracker & Death Stats -->
                            <TextBlock Text="👥 Player Wipe Tracker &amp; Death Analytics" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,6" Foreground="{DynamicResource Accent}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Native Fluent WPF Redesign:</Run>
                                Rebuilt Player Wipe Tracker and Death Stats into a responsive, high-performance pure WPF interface with smooth scrolling and modern typography.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Cloud Wipe Map &amp; Monument Sync:</Run>
                                Server wipe map uploading is now decoupled from tracking and automatically syncs high-resolution maps, monuments, and metadata directly upon connecting to a server.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Offline Wipe Explorer &amp; Server Switcher:</Run>
                                Easily switch between active and archived wipes, review historical player encounter counts, and inspect past maps completely offline.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run FontWeight="Bold">&#x2022; Steam Profile Linking &amp; Friendly Names:</Run>
                                Enriched player activity timelines with direct Steam profile integration, friendly server name resolution, and optimized grid columns.
                            </TextBlock>

                            <!-- Console Helper -->
