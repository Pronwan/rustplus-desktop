<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.Cloud24x7Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Cloud247Title}"
        Width="920" Height="740"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Cloud247Title}" ShowMaximize="False" ShowMinimize="False"/>

        <!-- Header -->
        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Cloud247Header}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{DynamicResource Cloud247SubHeader}" FontSize="13"
                               Foreground="{DynamicResource TextSubtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ui:Button Grid.Column="1" x:Name="BtnUpgrade" Content="{DynamicResource Cloud247Upgrade}"
                           Appearance="Primary" Visibility="Collapsed" Click="BtnUpgrade_Click"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Global Consent Switch Card -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Enable Cloud 24/7 (Global Consent)" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="When enabled, the cloud actively runs 24/7 background sessions for your chosen live server(s) when this desktop app is closed."
                                   FontSize="12" Foreground="{DynamicResource TextSubtle}" Margin="26,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" x:Name="ToggleGlobalConsent"
                                     VerticalAlignment="Center"
                                     Click="ToggleGlobalConsent_Click"/>
                </Grid>

                <!-- Data & FCM Disclosure Card -->
                <Border Margin="0,12,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Security &amp; Data Disclosure for rustplusdesktop.cloud:"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="• FCM Push Notification settings (credentials &amp; tokens) are uploaded to receive live raid alarms and server notifications while your PC is off."
                                       FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="• Server pairing details (IP, Port, Player ID, Player Token) and smart devices are synced for chosen active server(s) to run 24/7 automations."
                                       FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="• All credentials and tokens are encrypted at the database level, strictly bound exclusively to your user account, and never shared with anyone else."
                                       FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="• You can revoke consent at any time. Disabling stops all cloud workers and purges active background sessions."
                                       FontSize="11" Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Active Server Selection Card -->
        <Border Grid.Row="3" x:Name="ActiveSelectionCard" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlanSummaryText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="PlanHintText" FontSize="12" Foreground="{DynamicResource TextSubtle}"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Single Server Dropdown (When LiveLimit == 1) -->
                <StackPanel Grid.Column="1" x:Name="SingleServerDropdownPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Active Server:" FontSize="13" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbActiveServer" MinWidth="220" Height="34"
                              DisplayMemberPath="Name" SelectedValuePath="ServerId"
                              SelectionChanged="CmbActiveServer_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Servers List -->
        <Grid Grid.Row="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                <ItemsControl x:Name="ServerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource Accent}" CornerRadius="4"
                                                    Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ActiveBadgeVisibility}">
                                                <TextBlock Text="ACTIVE 24/7" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding OwnerText}" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{Binding OwnerBrush}" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding DetailText}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSubtle}"
                                                   Visibility="{Binding DetailVisibility}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{DynamicResource Cloud247Repair}" Appearance="Caution"
                                                   Visibility="{Binding RepairVisibility}" Margin="0,0,8,0"
                                                   Click="BtnRepair_Click" Tag="{Binding}"/>

                                        <ui:Button Content="{Binding ActionText}"
                                                   MinWidth="150"
                                                   Appearance="{Binding ActionAppearance}"
                                                   IsEnabled="{Binding CanToggle}"
                                                   Click="ToggleCover_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="{DynamicResource Cloud247Empty}"
                       Foreground="{DynamicResource TextSubtle}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="5" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12"
                           Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="{DynamicResource Cloud247Refresh}" Appearance="Secondary"
                               Click="BtnRefresh_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="{DynamicResource Close}" Appearance="Secondary" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
