<UserControl x:Class="RustPlusDesk.Views.PlayerWipeTrackerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="View_Loaded">

    <UserControl.Resources>
        <!-- Standard App Theme Brushes -->
        <SolidColorBrush x:Key="AppBg" Color="#0F1115" />
        <SolidColorBrush x:Key="Surface" Color="#181B20" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#1F242C" />
        <SolidColorBrush x:Key="CardBorder" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#60CDFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FA" />
        <SolidColorBrush x:Key="TextSubtle" Color="#94A3B8" />

        <!-- Activity state colors (mirrored in code-behind StateColor) -->
        <SolidColorBrush x:Key="StateMoving" Color="#5BE7A9" />
        <SolidColorBrush x:Key="StateStationary" Color="#62D6FF" />
        <SolidColorBrush x:Key="StateAfk" Color="#C9A6FF" />
        <SolidColorBrush x:Key="StateDead" Color="#FF6B57" />
        <SolidColorBrush x:Key="StateOffline" Color="#5B6B78" />
        <SolidColorBrush x:Key="StateUnknown" Color="#33414D" />

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="TrackerListView" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                        <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackerColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14,12"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                 BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="8"
                            Background="#2260CDFF" BorderBrush="#4460CDFF" BorderThickness="1"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CompassNorthwest24" FontSize="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WIPE / FIELD NOTES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,1" />
                        <TextBlock Text="Player Wipe Tracker" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="A local-first route console for the hours that matter." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Click="Refresh_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Cloud restore" Icon="{ui:SymbolIcon Symbol=CloudArrowDown24}" Appearance="Secondary" Click="CloudRestoreTab_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Close" Icon="{ui:SymbolIcon Symbol=Dismiss24}" Appearance="Secondary" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Summary & Player Selector Card -->
        <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="14,12"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                 BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Plan / Capability Status Banner -->
                <Border Grid.Row="0" Background="#1460CDFF" BorderBrush="#3360CDFF" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PremiumBanner" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Metrics Strip -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" MinWidth="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="PLAYER" Style="{StaticResource MetricLabel}" />
                        <ComboBox x:Name="PlayerSelector" Margin="0,4,0,0" Height="34" VerticalContentAlignment="Center" SelectionChanged="PlayerSelector_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="COVERAGE" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="CoverageText" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="UNKNOWN" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="UnknownText" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="DISTANCE" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="DistanceText" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                        <TextBlock Text="DEATHS" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="DeathsText" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="8,0,0,0">
                        <TextBlock Text="POINTS" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="PointCountText" Style="{StaticResource MetricValue}" />
                    </StackPanel>

                    <StackPanel Grid.Column="6" Margin="8,0,0,0">
                        <TextBlock Text="LOCAL STORE" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="StorageText" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="2" x:Name="TrackerTabs">
            <!-- Overview Tab -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,6,0">
                    <StackPanel>
                        <!-- Activity Ribbon Card -->
                        <ui:Card Margin="0,0,0,10" Padding="14"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Activity over the wipe" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="RibbonSpanText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" x:Name="ToggleUnknownButton" Content="Show unknown" Appearance="Secondary" Click="ToggleUnknown_Click" Margin="0,0,10,0" VerticalAlignment="Center"
                                               ToolTip="Unknown = gaps where Rust+ could not see the player. Hidden by default so real activity stays readable." />
                                    <Border Grid.Column="2" x:Name="StatusChip" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusChipDot" Width="9" Height="9" Fill="{DynamicResource StateUnknown}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock x:Name="StatusChipText" Text="No data" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="StatusChipSubText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Background="#0C1015" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <Canvas x:Name="ActivityRibbonCanvas" Height="72" ClipToBounds="True" SizeChanged="ActivityCanvas_SizeChanged" />
                                </Border>
                                <WrapPanel x:Name="ActivityLegend" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" />
                            </Grid>
                        </ui:Card>

                        <!-- Time Budget Breakdown Card -->
                        <ui:Card Margin="0,0,0,10" Padding="14"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Time budget" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                                <Border CornerRadius="5" ClipToBounds="True" Background="#0C1015" Height="24" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid x:Name="BreakdownBar" />
                                </Border>
                                <WrapPanel x:Name="BreakdownLegend" Orientation="Horizontal" Margin="0,10,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Bottom Split: Observation Timeline & Wipe Intel / Monument Visits -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Observation Timeline -->
                            <ui:Card Grid.Column="0" Padding="12"
                                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="260" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Observation timeline" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ListView Grid.Row="1" x:Name="TimelineList" Style="{StaticResource TrackerListView}" MaxHeight="380">
                                        <ListView.View>
                                            <GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                                <GridViewColumn Header="Start" DisplayMemberBinding="{Binding Start}" Width="135" />
                                                <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="95" />
                                                <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="95" />
                                                <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="190" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </ui:Card>

                            <!-- Wipe Intel & Monument Visits -->
                            <StackPanel Grid.Column="2">
                                <ui:Card Padding="12" Margin="0,0,0,10"
                                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                                         BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                         BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Wipe intel" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel x:Name="InsightsPanel" />
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="12"
                                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                                         BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                         BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="160" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                            <ui:SymbolIcon Symbol="Building24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Monument visits" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ListView Grid.Row="1" x:Name="VisitsList" Style="{StaticResource TrackerListView}" MaxHeight="240">
                                            <ListView.View>
                                                <GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                                    <GridViewColumn Header="Monument" DisplayMemberBinding="{Binding Name}" Width="160" />
                                                    <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="110" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Grid>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Route Replay Tab -->
            <TabItem x:Name="ReplayTab" Header="Route replay · Premium">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="360" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="12"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="ReplayPlayButton" Content="Play" Icon="{ui:SymbolIcon Symbol=Play24}" Appearance="Primary" Click="ReplayPlay_Click" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" x:Name="ReplayProgress" Minimum="0" Maximum="0" ValueChanged="ReplayProgress_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="ReplayTimeText" MinWidth="150" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="14,0,12,0" />
                            <ComboBox Grid.Column="3" x:Name="ReplaySpeedSelector" Width="80" Height="34" SelectionChanged="ReplaySpeed_Changed" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2×" Tag="2" />
                                <ComboBoxItem Content="4×" Tag="4" />
                            </ComboBox>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Padding="6"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <Grid Background="#0C1015" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="ReplayMapSurface">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Image x:Name="ReplayMapImage" Stretch="Uniform" Opacity="0.80" IsHitTestVisible="False" />
                                <Canvas x:Name="ReplayCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#DD10151C" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="12">
                                <StackPanel>
                                    <TextBlock Text="ROUTE REPLAY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="ReplayStateText" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- Heatmap Tab -->
            <TabItem x:Name="HeatmapTab" Header="Heatmap · Premium">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="6"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <Grid Background="#0C1015" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="HeatmapMapSurface">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Image x:Name="HeatmapMapImage" Stretch="Uniform" Opacity="0.75" IsHitTestVisible="False" />
                                <Canvas x:Name="HeatmapCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Column="2" Padding="14"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Fire24" FontSize="18" Foreground="#FF7A38" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Movement density" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Every glow is a valid coordinate observation. Hotter cells mean more revisits, not more certainty." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,18" />
                            <TextBlock Text="LEGEND" Style="{StaticResource MetricLabel}" />
                            <Grid Margin="0,8,0,0" Height="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#163F6A" CornerRadius="3,0,0,3" />
                                <Border Grid.Column="1" Background="#0B86A4" />
                                <Border Grid.Column="2" Background="#27C8B2" />
                                <Border Grid.Column="3" Background="#FFB340" />
                                <Border Grid.Column="4" Background="#FF5A36" CornerRadius="0,3,3,0" />
                            </Grid>
                            <TextBlock x:Name="HeatmapText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" Margin="0,10,0,0" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- Compare Tab -->
            <TabItem x:Name="CompareTab" Header="Compare · Premium">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="360" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="12"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PLAYER A" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CompareASelector" Width="190" Height="34" SelectionChanged="CompareSelector_Changed" VerticalContentAlignment="Center" />
                            <TextBlock Text="PLAYER B" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="20,0,8,0" />
                            <ComboBox x:Name="CompareBSelector" Width="190" Height="34" SelectionChanged="CompareSelector_Changed" VerticalContentAlignment="Center" />
                            <TextBlock x:Name="CompareSummaryText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <Border Grid.Row="1" Background="#1260CDFF" BorderBrush="#2560CDFF" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <TextBlock Text="Cyan is Player A · Amber is Player B. Comparison overlays only recorded coordinates and leaves missing periods blank." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <ui:Card Grid.Row="2" Padding="6"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <Grid Background="#0C1015" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="CompareMapSurface">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Image x:Name="CompareMapImage" Stretch="Uniform" Opacity="0.78" IsHitTestVisible="False" />
                                <Canvas x:Name="CompareCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- Export Tab -->
            <TabItem x:Name="ExportTab" Header="Export · Premium">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,0">
                    <ui:Card Padding="20" MaxWidth="720" HorizontalAlignment="Left"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Take the wipe with you" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Export the selected player’s recorded observations, derived summary, route segments, and monument visits. JSON is lossless; CSV is ready for a spreadsheet or a quick handoff." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="ExportJsonButton" Content="Export JSON" Icon="{ui:SymbolIcon Symbol=DocumentBulletList24}" Appearance="Primary" Click="ExportJson_Click" Margin="0,0,10,0" />
                                <ui:Button x:Name="ExportCsvButton" Content="Export CSV" Icon="{ui:SymbolIcon Symbol=DocumentTableSearch24}" Appearance="Secondary" Click="ExportCsv_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ExportStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12" />
                        </StackPanel>
                    </ui:Card>
                </ScrollViewer>
            </TabItem>

            <!-- Cloud Restore Tab -->
            <TabItem x:Name="CloudTab" Header="Cloud restore · Premium">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="280" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="14"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="220" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                    <ui:SymbolIcon Symbol="Cloud24" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cloud archives" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ListView Grid.Row="1" x:Name="CloudArchiveSelector" Style="{StaticResource TrackerListView}" SelectionChanged="CloudArchive_Changed" MaxHeight="340" />
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="16"
                                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="CloudArrowDown24" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Restore importer" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Downloads the selected archive day by day and merges it into the same local JSONL store used by live tracking. Repeating a restore is safe." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                    <TextBlock x:Name="CloudArchiveDetailsText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                </Border>
                                <ui:Button x:Name="RestoreCloudButton" Content="Restore selected archive" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Appearance="Primary" Click="RestoreCloud_Click" Margin="0,0,0,8" HorizontalAlignment="Left" />
                                <ui:Button Content="Refresh cloud archives" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Appearance="Secondary" Click="RefreshCloud_Click" HorizontalAlignment="Left" />
                                <TextBlock x:Name="CloudStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12" />
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
