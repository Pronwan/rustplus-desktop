<UserControl x:Class="RustPlusDesk.Views.PlayerWipeTrackerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Loaded="View_Loaded">
    <UserControl.Resources>
        <!-- This workspace intentionally owns its palette and templates. It uses only native WPF controls. -->
        <SolidColorBrush x:Key="AppBg" Color="#151A20" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#202832" />
        <SolidColorBrush x:Key="CardBorder" Color="#3B4B59" />
        <SolidColorBrush x:Key="Accent" Color="#62D6FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FA" />
        <SolidColorBrush x:Key="TextSubtle" Color="#A7B3BE" />

        <!-- Shared activity-state palette (mirrored in code-behind StateColor). -->
        <SolidColorBrush x:Key="StateMoving" Color="#5BE7A9" />
        <SolidColorBrush x:Key="StateStationary" Color="#62D6FF" />
        <SolidColorBrush x:Key="StateAfk" Color="#C9A6FF" />
        <SolidColorBrush x:Key="StateDead" Color="#FF6B57" />
        <SolidColorBrush x:Key="StateOffline" Color="#5B6B78" />
        <SolidColorBrush x:Key="StateUnknown" Color="#33414D" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#263542" />
            <Setter Property="BorderBrush" Value="#4B6575" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#315064" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#1A2731" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#18232C" />
            <Setter Property="BorderBrush" Value="#4B6575" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MaxDropDownHeight" Value="280" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderBrush="#3C5260" BorderThickness="1,0,0,0">
                                        <Path Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSubtle}" StrokeThickness="1.5" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0" Background="#18232C" BorderBrush="#4B6575" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#18232C" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#29485A" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#315D72" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemChrome" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="#344552" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#18232C" />
            <Setter Property="Foreground" Value="#526D7D" />
            <Setter Property="Width" Value="10" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="#182129" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="12">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1B2730" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderBrush" Value="#304552" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#263C4A" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#2A495B" /><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabChrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TrackerListView" TargetType="ListView">
            <Setter Property="Background" Value="#151B23" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1C2A35" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#203B4A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackerColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1D2630" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="46" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="WIPE / FIELD NOTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Player Wipe Tracker" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="A local-first route console for the hours that matter." Foreground="{DynamicResource TextSubtle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Click="Refresh_Click" Padding="16,7" Margin="0,0,8,0" />
                <Button Content="Cloud restore" Click="CloudRestoreTab_Click" Padding="16,7" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" Padding="16,7" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PremiumBanner" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,0,0,12" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PLAYER" Style="{StaticResource MetricLabel}" />
                        <ComboBox x:Name="PlayerSelector" Margin="0,4,16,0" SelectionChanged="PlayerSelector_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="COVERAGE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="CoverageText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="UNKNOWN" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="UnknownText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="12,0,0,0"><TextBlock Text="DISTANCE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="DistanceText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="4" Margin="12,0,0,0"><TextBlock Text="DEATHS" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="DeathsText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="5" Margin="12,0,0,0"><TextBlock Text="POINTS" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="PointCountText" Style="{StaticResource MetricValue}" /></StackPanel>
                    <StackPanel Grid.Column="6" Margin="12,0,0,0"><TextBlock Text="LOCAL STORE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="StorageText" Style="{StaticResource MetricValue}" /></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="TrackerTabs">
            <TabItem Header="Overview">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Activity ribbon + live status hero -->
                    <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Activity over the wipe" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RibbonSpanText" Foreground="{DynamicResource TextSubtle}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ToggleUnknownButton" Content="Show unknown" Click="ToggleUnknown_Click" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center"
                                        ToolTip="Unknown = gaps where Rust+ could not see the player. Hidden by default so real activity stays readable." />
                                <Border Grid.Column="2" x:Name="StatusChip" Background="#1B2833" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusChipDot" Width="10" Height="10" Fill="{DynamicResource StateUnknown}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="StatusChipText" Text="No data" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusChipSubText" Foreground="{DynamicResource TextSubtle}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#101820" BorderBrush="#26333D" BorderThickness="1" CornerRadius="6">
                                <Canvas x:Name="ActivityRibbonCanvas" Height="72" ClipToBounds="True" SizeChanged="ActivityCanvas_SizeChanged" />
                            </Border>
                            <WrapPanel x:Name="ActivityLegend" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" />
                        </Grid>
                    </Border>

                    <!-- Time budget breakdown -->
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Time budget" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Border CornerRadius="5" ClipToBounds="True" Background="#101820" Height="26">
                                <Grid x:Name="BreakdownBar" />
                            </Border>
                            <WrapPanel x:Name="BreakdownLegend" Orientation="Horizontal" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom split: timeline · insights + monuments -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Observation timeline" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
                                <ListView Grid.Row="1" x:Name="TimelineList" Style="{StaticResource TrackerListView}">
                                    <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                        <GridViewColumn Header="Start" DisplayMemberBinding="{Binding Start}" Width="130" />
                                        <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="90" />
                                        <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="90" />
                                        <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="180" />
                                    </GridView></ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Wipe intel" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <StackPanel x:Name="InsightsPanel" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="Monument visits" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
                                    <ListView Grid.Row="1" x:Name="VisitsList" Style="{StaticResource TrackerListView}">
                                        <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource TrackerColumnHeader}">
                                            <GridViewColumn Header="Monument" DisplayMemberBinding="{Binding Name}" Width="150" />
                                            <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="110" />
                                        </GridView></ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="ReplayTab" Header="Route replay · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ReplayPlayButton" Content="Play" Click="ReplayPlay_Click" Padding="16,6" Margin="0,0,12,0" />
                            <Slider Grid.Column="1" x:Name="ReplayProgress" Minimum="0" Maximum="0" ValueChanged="ReplayProgress_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="ReplayTimeText" MinWidth="150" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0,12,0" />
                            <ComboBox Grid.Column="3" x:Name="ReplaySpeedSelector" Width="74" SelectionChanged="ReplaySpeed_Changed">
                                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2×" Tag="2" />
                                <ComboBoxItem Content="4×" Tag="4" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="10">
                        <Grid Background="#101820" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="ReplayMapSurface">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup></Grid.RenderTransform>
                                <Image x:Name="ReplayMapImage" Stretch="Uniform" Opacity="0.78" IsHitTestVisible="False" />
                                <Canvas x:Name="ReplayCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC101820" BorderBrush="#335A7482" BorderThickness="1" CornerRadius="5" Padding="8" Margin="12">
                                <StackPanel><TextBlock Text="ROUTE REPLAY" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="ReplayStateText" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="HeatmapTab" Header="Heatmap · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,10,0">
                        <Grid Background="#101820" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="HeatmapMapSurface">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup></Grid.RenderTransform>
                                <Image x:Name="HeatmapMapImage" Stretch="Uniform" Opacity="0.72" IsHitTestVisible="False" />
                                <Canvas x:Name="HeatmapCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Movement density" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Every glow is a valid coordinate observation. Hotter cells mean more revisits, not more certainty." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,18" />
                            <TextBlock Text="LEGEND" Style="{StaticResource MetricLabel}" />
                            <Grid Margin="0,8,0,0" Height="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#163F6A" /><Border Grid.Column="1" Background="#0B86A4" /><Border Grid.Column="2" Background="#27C8B2" /><Border Grid.Column="3" Background="#FFB340" /><Border Grid.Column="4" Background="#FF5A36" /></Grid>
                            <TextBlock x:Name="HeatmapText" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CompareTab" Header="Compare · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PLAYER A" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CompareASelector" Width="190" SelectionChanged="CompareSelector_Changed" />
                            <TextBlock Text="PLAYER B" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="22,0,8,0" />
                            <ComboBox x:Name="CompareBSelector" Width="190" SelectionChanged="CompareSelector_Changed" />
                            <TextBlock x:Name="CompareSummaryText" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="Cyan is Player A · amber is Player B. Comparison stays honest: it overlays only recorded coordinates and leaves missing periods blank." Foreground="{DynamicResource TextSubtle}" />
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="10">
                        <Grid Background="#101820" ClipToBounds="True" Cursor="SizeAll" ToolTip="Mouse wheel to zoom · drag to pan · double-click to reset" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove">
                            <Grid x:Name="CompareMapSurface">
                                <Grid.RenderTransform><TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup></Grid.RenderTransform>
                                <Image x:Name="CompareMapImage" Stretch="Uniform" Opacity="0.76" IsHitTestVisible="False" />
                                <Canvas x:Name="CompareCanvas" Background="Transparent" SizeChanged="Canvas_SizeChanged" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ExportTab" Header="Export · Premium">
                <Grid Margin="0,12,0,0">
                    <Border Style="{StaticResource Panel}" Padding="18" MaxWidth="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Take the wipe with you" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Export the selected player’s recorded observations, derived summary, route segments, and monument visits. JSON is lossless; CSV is ready for a spreadsheet or a quick handoff." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportJsonButton" Content="Export JSON" Click="ExportJson_Click" Padding="18,8" Margin="0,0,8,0" />
                                <Button x:Name="ExportCsvButton" Content="Export CSV" Click="ExportCsv_Click" Padding="18,8" />
                            </StackPanel>
                            <TextBlock x:Name="ExportStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CloudTab" Header="Cloud restore · Premium">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,10,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Cloud archives" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
                            <ListView Grid.Row="1" x:Name="CloudArchiveSelector" Style="{StaticResource TrackerListView}" SelectionChanged="CloudArchive_Changed" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Restore importer" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Downloads the selected archive day by day and merges it into the same local JSONL store used by live tracking. Repeating a restore is safe." TextWrapping="Wrap" Foreground="{DynamicResource TextSubtle}" Margin="0,8,0,18" />
                            <TextBlock x:Name="CloudArchiveDetailsText" TextWrapping="Wrap" />
                            <Button x:Name="RestoreCloudButton" Content="Restore selected archive" Click="RestoreCloud_Click" Padding="18,8" HorizontalAlignment="Left" Margin="0,20,0,0" />
                            <Button Content="Refresh cloud archives" Click="RefreshCloud_Click" Padding="18,8" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock x:Name="CloudStatusText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
