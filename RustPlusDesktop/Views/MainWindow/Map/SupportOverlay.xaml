<UserControl x:Class="RustPlusDesk.Views.SupportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="440"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Section label above a field -->
        <Style x:Key="SupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Ticket list item card style with smooth hover elevation -->
        <Style x:Key="TicketCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#141820" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D232E" />
                    <Setter Property="BorderBrush" Value="#4560CDFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AttachmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.70" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CategoryItemTemplate">
            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Overlay Container: modern Fluent card surface -->
    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="10"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#1E60CDFF" BorderBrush="#3360CDFF" BorderThickness="1" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="ChatHelp24" Foreground="{DynamicResource Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource SupportTitle}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" x:Name="BtnClose" Appearance="Transparent" Padding="7" Click="Close_Click" ToolTip="Close" Width="32" Height="32">
                    <ui:SymbolIcon Symbol="Dismiss24" Foreground="{DynamicResource TextSubtle}" FontSize="14" />
                </ui:Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">

                <!-- 1. Tickets: List View -->
                <Grid x:Name="TicketsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <ui:Button Grid.Row="0" x:Name="BtnNewTicket" Content="{DynamicResource SupportNewTicket}" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary" Height="38" Margin="0,0,0,14" HorizontalAlignment="Stretch" Click="NewTicket_Click" FontWeight="SemiBold" FontSize="13" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <ItemsControl x:Name="TicketsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TicketCardBorder}" MouseLeftButtonUp="TicketRow_Click" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Unread Dot + Subject + Time -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="{Binding UnreadVisibility}">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#60CDFF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{DynamicResource TextCaption}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>

                                            <!-- Row 1: Badges + Chevron -->
                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Category Pill -->
                                                    <Border Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource TextSubtle}" FontSize="10.5" FontWeight="Medium" />
                                                    </Border>
                                                    <!-- Status Pill -->
                                                    <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBackground}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="10.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="1" Symbol="ChevronRight24" Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <Grid x:Name="TicketsEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="260">
                            <Border Width="54" Height="54" CornerRadius="27" Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ChatHelp24" FontSize="24" Foreground="{DynamicResource TextSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource SupportNoTickets}" Foreground="{DynamicResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2. Tickets: Compose View -->
                <Grid x:Name="ComposeView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <StackPanel>
                            <!-- Category Field -->
                            <TextBlock Text="{DynamicResource SupportCategory}" Style="{StaticResource SupLabel}" />
                            <ComboBox x:Name="ComposeCategory" Foreground="{DynamicResource TextPrimary}"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}"
                                      SelectionChanged="ComposeCategory_SelectionChanged" Margin="0,0,0,14" Height="34" />

                            <!-- Subject Field -->
                            <TextBlock Text="{DynamicResource SupportSubject}" Style="{StaticResource SupLabel}" />
                            <ui:TextBox x:Name="ComposeSubject" MaxLength="160" FontSize="12.5" Padding="10,8" Margin="0,0,0,14" />

                            <!-- Details Field -->
                            <TextBlock Text="{DynamicResource SupportDetails}" Style="{StaticResource SupLabel}" />
                            <ui:TextBox x:Name="ComposeBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" FontSize="12.5" Padding="10,8" Margin="0,0,0,12" />

                            <!-- Attachments Preview List -->
                            <ItemsControl x:Name="ComposeAttachments" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,8,8">
                                            <!-- Image preview thumbnail -->
                                            <Border Visibility="{Binding ImageVisibility}" Width="64" Height="64" CornerRadius="6" ClipToBounds="True" BorderBrush="#2EFFFFFF" BorderThickness="1" Background="#14FFFFFF">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <!-- Non-image chip -->
                                            <Border Visibility="{Binding ChipVisibility}" Background="#161B24" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Attach24" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Delete button -->
                                            <ui:Button Tag="{Binding}" Click="RemoveComposeAttachment_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="0" Width="20" Height="20" Margin="0,-6,-6,0" ToolTip="{DynamicResource SupportRemove}">
                                                <Border Width="18" Height="18" CornerRadius="9" Background="#33EF5350" BorderBrush="#55EF5350" BorderThickness="1">
                                                    <ui:SymbolIcon Symbol="Dismiss24" Foreground="#FFFF8585" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Attach File Button & Count -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnComposeAttach" Content="{DynamicResource SupportAttachFiles}" Icon="{ui:SymbolIcon Attach24}" Appearance="Secondary" Height="32" Padding="12,4" Click="ComposeAttach_Click" />
                                <TextBlock x:Name="ComposeAttachCount" Text="" Foreground="{DynamicResource TextSubtle}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <!-- Appeal Checkbox -->
                            <CheckBox x:Name="ComposeAppeal" Content="{DynamicResource SupportAppeal}" Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed" Margin="0,0,0,14" />

                            <!-- Error Message Banner -->
                            <Border x:Name="ComposeErrorBorder" Background="#22EF5350" BorderBrush="#44EF5350" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14" Visibility="{Binding Visibility, ElementName=ComposeError}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Warning24" Foreground="#FFEF5350" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" x:Name="ComposeError" Foreground="#FFFCE8E8" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <ui:Button Content="{DynamicResource SupportCancel}" Appearance="Secondary" Padding="16,6" Click="ComposeCancel_Click" />
                                <ui:Button x:Name="BtnComposeSubmit" Content="{DynamicResource SupportSubmit}" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Padding="18,6" Margin="8,0,0,0" Click="ComposeSubmit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. Tickets: Thread View -->
                <Grid x:Name="ThreadView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thread Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <ui:Button Content="{DynamicResource SupportBackToTickets}" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" HorizontalAlignment="Left" Padding="6,4" Margin="0,0,0,8" Click="ThreadBack_Click" />
                        <TextBlock x:Name="ThreadSubject" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20" />
                        <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="ThreadStatus" Foreground="{DynamicResource TextSubtle}" FontSize="11" FontWeight="Medium" />
                        </Border>
                    </StackPanel>

                    <!-- Messages List -->
                    <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <ItemsControl x:Name="ThreadMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{Binding MessageBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Author Header -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="20" Height="20" CornerRadius="10" Background="{Binding BadgeBackground}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="{Binding BadgeSymbol}" FontSize="11" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Visibility="{Binding StaffTagVisibility}" Background="#2260CDFF" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="STAFF" Foreground="{DynamicResource Accent}" FontSize="9" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{DynamicResource TextCaption}" FontSize="10.5" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Message Text Body -->
                                            <TextBlock Text="{Binding Body}" Visibility="{Binding BodyVisibility}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0" />

                                            <!-- Attachments in Message -->
                                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource AttachmentButtonStyle}"
                                                                Tag="{Binding}"
                                                                Click="MessageAttachment_Click"
                                                                ToolTip="{Binding Name}">
                                                            <Grid>
                                                                <!-- Image Thumbnail -->
                                                                <Border Visibility="{Binding ImageVisibility}" MaxWidth="240" MaxHeight="180" MinWidth="70" MinHeight="50" CornerRadius="6" ClipToBounds="True" BorderBrush="#35FFFFFF" BorderThickness="1" Background="#22000000">
                                                                    <Grid>
                                                                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                                        <Border Background="#88000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,2">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <ui:SymbolIcon Symbol="Eye24" FontSize="11" Foreground="#EEFFFFFF" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                                <TextBlock Text="View" FontSize="9.5" FontWeight="SemiBold" Foreground="#EEFFFFFF" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- File Chip -->
                                                                <Border Visibility="{Binding ChipVisibility}" Background="#161B24" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="Attach24" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSubtle}" FontSize="10.5" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Reply Input Section -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <!-- Reply Attachments Preview -->
                        <ItemsControl x:Name="ReplyAttachments" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,8">
                                        <Border Visibility="{Binding ImageVisibility}" Width="52" Height="52" CornerRadius="6" ClipToBounds="True" BorderBrush="#25FFFFFF" BorderThickness="1" Background="#14FFFFFF">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border>
                                        <Border Visibility="{Binding ChipVisibility}" Background="#161B24" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Attach24" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="11" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ui:Button Tag="{Binding}" Click="RemoveReplyAttachment_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="0" Width="18" Height="18" Margin="0,-6,-6,0" ToolTip="{DynamicResource SupportRemove}">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#33EF5350" BorderBrush="#55EF5350" BorderThickness="1">
                                                <ui:SymbolIcon Symbol="Dismiss24" Foreground="#FFFF8585" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Reply Input Bar -->
                        <Grid x:Name="ReplyBar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" x:Name="BtnReplyAttach" Appearance="Secondary" Padding="8" Margin="0,0,6,0" Click="ReplyAttach_Click" ToolTip="{DynamicResource SupportAttachFiles}">
                                <ui:SymbolIcon Symbol="Attach24" Foreground="{DynamicResource TextSubtle}" FontSize="15" />
                            </ui:Button>
                            <ui:TextBox Grid.Column="1" x:Name="ReplyBox" PlaceholderText="{DynamicResource SupportReplyPlaceholder}" FontSize="12.5" Padding="10,7" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="2" x:Name="BtnReplySend" Content="{DynamicResource SupportSend}" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Padding="14,6" Click="ReplySend_Click" />
                        </Grid>

                        <!-- Closed Ticket Message -->
                        <Border x:Name="ThreadClosedBorder" Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,6,0,0" Visibility="{Binding Visibility, ElementName=ThreadClosed}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource TextSubtle}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ThreadClosed" Text="{DynamicResource SupportTicketClosed}" Foreground="{DynamicResource TextSubtle}" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
