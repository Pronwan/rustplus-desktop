<UserControl x:Class="RustPlusDesk.Views.SupportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="440"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SupText" Color="#FFF4F6FA" />
        <SolidColorBrush x:Key="SupMuted" Color="#FF94A0B3" />
        <SolidColorBrush x:Key="SupFaint" Color="#FF6B7686" />
        <SolidColorBrush x:Key="SupLine" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SupCard" Color="#FF161C24" />
        <SolidColorBrush x:Key="SupPanel" Color="#FF0E141A" />
        <SolidColorBrush x:Key="SupAccent" Color="#FFE8683C" />

        <!--  Section label above a field.  -->
        <Style x:Key="SupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SupMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  A small pill (category, status).  -->
        <Style x:Key="SupPill" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="CategoryItemTemplate">
            <TextBlock Text="{Binding}" Foreground="{StaticResource SupText}" />
        </DataTemplate>
    </UserControl.Resources>

    <!--  A card that fills the column, like the other overlays.  -->
    <Border Background="{StaticResource SupPanel}" CornerRadius="8"
            BorderBrush="{StaticResource SupLine}" BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ChatHelp24" Foreground="{StaticResource SupAccent}" FontSize="20" />
                    <TextBlock Text="Tickets" Foreground="{StaticResource SupText}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Grid.Column="1" x:Name="BtnClose" Appearance="Transparent" Padding="6" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" Foreground="{StaticResource SupMuted}" />
                </ui:Button>
            </Grid>

            <!--  Content  -->
            <Grid Grid.Row="1">

                <!--  Tickets: list  -->
                <Grid x:Name="TicketsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Button Grid.Row="0" x:Name="BtnNewTicket" Content="New ticket" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary" Height="38" Margin="0,0,0,14" HorizontalAlignment="Stretch" Click="NewTicket_Click" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <ItemsControl x:Name="TicketsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SupCard}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10" Cursor="Hand"
                                            MouseLeftButtonUp="TicketRow_Click" Tag="{Binding Id}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource SupAccent}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding UnreadVisibility}" />
                                                <TextBlock Text="{Binding Subject}" Foreground="{StaticResource SupText}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SupPill}">
                                                    <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource SupMuted}" FontSize="10" />
                                                </Border>
                                                <Border Style="{StaticResource SupPill}">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource SupMuted}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource SupFaint}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TicketsEmpty" Grid.Row="1" Text="No tickets yet." Foreground="{StaticResource SupMuted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" Visibility="Collapsed" />
                </Grid>

                <!--  Tickets: compose  -->
                <Grid x:Name="ComposeView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="CATEGORY" Style="{StaticResource SupLabel}" />
                            <ComboBox x:Name="ComposeCategory" Foreground="{StaticResource SupText}"
                                      ItemTemplate="{StaticResource CategoryItemTemplate}" Margin="0,0,0,16" />
                            <TextBlock Text="SUBJECT" Style="{StaticResource SupLabel}" />
                            <ui:TextBox x:Name="ComposeSubject" MaxLength="160" Margin="0,0,0,16" />
                            <TextBlock Text="DETAILS" Style="{StaticResource SupLabel}" />
                            <ui:TextBox x:Name="ComposeBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" Margin="0,0,0,12" />

                            <!--  Previews of what has been attached, before it is sent.  -->
                            <ItemsControl x:Name="ComposeAttachments" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,8,8">
                                            <Border Visibility="{Binding ImageVisibility}" Width="64" Height="64" CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource SupLine}" BorderThickness="1">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            </Border>
                                            <Border Visibility="{Binding ChipVisibility}" Background="{StaticResource SupCard}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource SupMuted}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource SupText}" FontSize="11" VerticalAlignment="Center" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <ui:Button Tag="{Binding}" Click="RemoveComposeAttachment_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="0" Width="18" Height="18" Margin="0,-6,-6,0" ToolTip="Remove">
                                                <ui:SymbolIcon Symbol="Dismiss24" Foreground="#FFE8695C" FontSize="12" />
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnComposeAttach" Content="Attach files" Icon="{ui:SymbolIcon Attach24}" Appearance="Secondary" Click="ComposeAttach_Click" />
                                <TextBlock x:Name="ComposeAttachCount" Text="" Foreground="{StaticResource SupMuted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ComposeAppeal" Content="This is an appeal of my current mute" Foreground="{StaticResource SupText}" Visibility="Collapsed" Margin="0,0,0,16" />
                            <TextBlock x:Name="ComposeError" Foreground="#FFE8695C" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Cancel" Appearance="Secondary" Click="ComposeCancel_Click" />
                                <ui:Button x:Name="BtnComposeSubmit" Content="Submit" Appearance="Primary" Margin="10,0,0,0" Click="ComposeSubmit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  Tickets: thread  -->
                <Grid x:Name="ThreadView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <ui:Button Content="Back to tickets" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,4" Margin="-4,0,0,0" Click="ThreadBack_Click" />
                        <TextBlock x:Name="ThreadSubject" Foreground="{StaticResource SupText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="ThreadStatus" Foreground="{StaticResource SupMuted}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <ItemsControl x:Name="ThreadMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Author}" Foreground="{StaticResource SupText}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource SupFaint}" FontSize="10" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding Body}" Visibility="{Binding BodyVisibility}" Foreground="{StaticResource SupText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0" />

                                            <!--  Attachments sent with the message: screenshots inline, files as chips.  -->
                                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,8,8" Cursor="Hand" Background="Transparent" Tag="{Binding}" MouseLeftButtonUp="MessageAttachment_Click" ToolTip="{Binding Name}">
                                                            <Border Visibility="{Binding ImageVisibility}" MaxWidth="200" MaxHeight="150" MinWidth="60" MinHeight="44" CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource SupLine}" BorderThickness="1" Background="#22000000">
                                                                <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                            </Border>
                                                            <Border Visibility="{Binding ChipVisibility}" Background="#22FFFFFF" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource SupMuted}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource SupText}" FontSize="11" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource SupMuted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <!--  What is about to be sent with the reply.  -->
                        <ItemsControl x:Name="ReplyAttachments" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,8">
                                        <Border Visibility="{Binding ImageVisibility}" Width="52" Height="52" CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource SupLine}" BorderThickness="1">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border>
                                        <Border Visibility="{Binding ChipVisibility}" Background="{StaticResource SupCard}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource SupMuted}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource SupText}" FontSize="11" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <ui:Button Tag="{Binding}" Click="RemoveReplyAttachment_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="0" Width="18" Height="18" Margin="0,-6,-6,0" ToolTip="Remove">
                                            <ui:SymbolIcon Symbol="Dismiss24" Foreground="#FFE8695C" FontSize="12" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="ReplyBar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" x:Name="BtnReplyAttach" Appearance="Transparent" Padding="6" Click="ReplyAttach_Click">
                                <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource SupMuted}" />
                            </ui:Button>
                            <ui:TextBox Grid.Column="1" x:Name="ReplyBox" PlaceholderText="Write a reply…" Margin="6,0" />
                            <ui:Button Grid.Column="2" x:Name="BtnReplySend" Content="Send" Appearance="Primary" Click="ReplySend_Click" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="ThreadClosed" Text="This ticket is closed." Foreground="{StaticResource SupMuted}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
