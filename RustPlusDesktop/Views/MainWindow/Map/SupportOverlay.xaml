<UserControl x:Class="RustPlusDesk.Views.SupportOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="440"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SupText" Color="#FFF4F6FA" />
        <SolidColorBrush x:Key="SupMuted" Color="#FF94A0B3" />
        <SolidColorBrush x:Key="SupLine" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="SupCard" Color="#FF111820" />
        <SolidColorBrush x:Key="SupPanel" Color="#FF0C1116" />
        <SolidColorBrush x:Key="SupAccent" Color="#FFE8683C" />

        <Style x:Key="SupHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SupMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Border Width="440"
            Background="{StaticResource SupPanel}"
            BorderBrush="{StaticResource SupLine}"
            BorderThickness="1,0,0,0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="16,14,12,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ChatHelp24" Foreground="{StaticResource SupAccent}" FontSize="20" />
                    <TextBlock Text="Support" Foreground="{StaticResource SupText}" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button x:Name="BtnClose" HorizontalAlignment="Right" Appearance="Transparent" Padding="6" Click="Close_Click">
                    <ui:SymbolIcon Symbol="Dismiss24" Foreground="{StaticResource SupMuted}" />
                </ui:Button>
            </Grid>

            <!--  Tabs  -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                <ToggleButton x:Name="TabTickets" Content="Tickets" IsChecked="True" Click="TabTickets_Click"
                              Foreground="{StaticResource SupText}" Background="Transparent" BorderThickness="0" Padding="10,6" Cursor="Hand" />
                <ToggleButton x:Name="TabNotifications" Content="Notifications" Click="TabNotifications_Click"
                              Foreground="{StaticResource SupMuted}" Background="Transparent" BorderThickness="0" Padding="10,6" Cursor="Hand" Margin="4,0,0,0" />
                <Border x:Name="UnreadPill" Background="{StaticResource SupAccent}" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="UnreadCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" />
                </Border>
            </StackPanel>

            <!--  Content  -->
            <Grid Grid.Row="2" Margin="0,0,0,0">

                <!--  Tickets: list  -->
                <Grid x:Name="TicketsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Button Grid.Row="0" x:Name="BtnNewTicket" Content="New ticket" Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary" Margin="16,4,16,10" HorizontalAlignment="Stretch" Click="NewTicket_Click" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TicketsList" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SupCard}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                            MouseLeftButtonUp="TicketRow_Click" Tag="{Binding Id}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource SupAccent}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding UnreadVisibility}" />
                                                <TextBlock Text="{Binding Subject}" Foreground="{StaticResource SupText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#22FFFFFF" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource SupMuted}" FontSize="10" />
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource SupMuted}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource SupMuted}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TicketsEmpty" Grid.Row="1" Text="No tickets yet." Foreground="{StaticResource SupMuted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Visibility="Collapsed" />
                </Grid>

                <!--  Tickets: compose  -->
                <Grid x:Name="ComposeView" Visibility="Collapsed" Margin="16,4,16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CATEGORY" Style="{StaticResource SupHeading}" />
                            <ComboBox x:Name="ComposeCategory" Margin="0,4,0,10" />
                            <TextBlock Text="SUBJECT" Style="{StaticResource SupHeading}" />
                            <ui:TextBox x:Name="ComposeSubject" MaxLength="160" Margin="0,4,0,10" />
                            <TextBlock Text="DETAILS" Style="{StaticResource SupHeading}" />
                            <ui:TextBox x:Name="ComposeBody" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button x:Name="BtnComposeAttach" Content="Attach files" Icon="{ui:SymbolIcon Attach24}" Appearance="Secondary" Click="ComposeAttach_Click" />
                                <TextBlock x:Name="ComposeAttachCount" Text="" Foreground="{StaticResource SupMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ComposeAppeal" Content="This is an appeal of my current mute" Foreground="{StaticResource SupText}" Visibility="Collapsed" Margin="0,0,0,10" />
                            <TextBlock x:Name="ComposeError" Foreground="#FFE8695C" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Cancel" Appearance="Secondary" Click="ComposeCancel_Click" />
                                <ui:Button x:Name="BtnComposeSubmit" Content="Submit" Appearance="Primary" Margin="8,0,0,0" Click="ComposeSubmit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  Tickets: thread  -->
                <Grid x:Name="ThreadView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="16,4,16,8">
                        <ui:Button Content="Back to tickets" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,4" Click="ThreadBack_Click" />
                        <TextBlock x:Name="ThreadSubject" Foreground="{StaticResource SupText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ThreadStatus" Foreground="{StaticResource SupMuted}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Margin="12,0">
                        <ItemsControl x:Name="ThreadMessages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Author}" Foreground="{StaticResource SupText}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource SupMuted}" FontSize="10" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource SupText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="12,8,12,12" x:Name="ReplyBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" x:Name="BtnReplyAttach" Appearance="Transparent" Padding="6" Click="ReplyAttach_Click">
                            <ui:SymbolIcon Symbol="Attach24" Foreground="{StaticResource SupMuted}" />
                        </ui:Button>
                        <ui:TextBox Grid.Column="1" x:Name="ReplyBox" PlaceholderText="Write a reply…" Margin="4,0" />
                        <ui:Button Grid.Column="2" x:Name="BtnReplySend" Content="Send" Appearance="Primary" Click="ReplySend_Click" />
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="ThreadClosed" Text="This ticket is closed." Foreground="{StaticResource SupMuted}" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed" />
                </Grid>

                <!--  Notifications  -->
                <Grid x:Name="NotificationsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Button Grid.Row="0" x:Name="BtnMarkAll" Content="Mark all read" Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Secondary" Margin="16,4,16,10" HorizontalAlignment="Right" Click="MarkAll_Click" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotificationsList" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{StaticResource SupLine}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                            MouseLeftButtonUp="NotificationRow_Click" Tag="{Binding Id}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource SupText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource SupMuted}" FontSize="11" TextWrapping="Wrap" Margin="16,2,0,0" />
                                            <TextBlock Text="{Binding When}" Foreground="{StaticResource SupMuted}" FontSize="10" Margin="16,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NotificationsEmpty" Grid.Row="1" Text="Nothing here yet." Foreground="{StaticResource SupMuted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Visibility="Collapsed" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
