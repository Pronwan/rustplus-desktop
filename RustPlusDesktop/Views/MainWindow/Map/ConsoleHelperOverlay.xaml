<UserControl x:Class="RustPlusDesk.Views.ConsoleHelperOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RustPlusDesk.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="ConText" Color="#FFF4F6FA" />
        <SolidColorBrush x:Key="ConMuted" Color="#FF94A0B3" />
        <SolidColorBrush x:Key="ConLine" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ConCard" Color="#FF111820" />
        <SolidColorBrush x:Key="ConCode" Color="#FF0B1015" />
        <SolidColorBrush x:Key="ConAccent" Color="#FF3FD7FF" />

        <LinearGradientBrush x:Key="ConShell" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FD0B1015" Offset="0" />
            <GradientStop Color="#FA111821" Offset="0.48" />
            <GradientStop Color="#FC070A0E" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ConCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- The command line itself: monospaced, selectable, visually a console. -->
        <Style x:Key="ConCodeBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConCode}" />
            <Setter Property="BorderBrush" Value="{StaticResource ConLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="ConSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ConAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>

        <!-- One command. Used identically in the featured block and the grouped lists. -->
        <DataTemplate x:Key="CommandCardTemplate">
            <Border Style="{StaticResource ConCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource ConText}"
                                   FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Group}" Foreground="{StaticResource ConMuted}"
                                   FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource ConMuted}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />

                    <!-- Parameters, only rendered when the command has any -->
                    <ItemsControl ItemsSource="{Binding Params}" Margin="0,0,0,8"
                                  Visibility="{Binding HasParams, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource ConMuted}"
                                               FontSize="11" VerticalAlignment="Center" />

                                    <!-- Item picker. The result list is laid out inline rather than in a
                                         popup: a WPF popup opens with a valid handle and the right size
                                         from a second window, and still does not render. Inline behaves
                                         identically wherever the panel is hosted. -->
                                    <StackPanel Grid.Column="1" Visibility="{Binding IsItem, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding ItemQuery, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{DynamicResource ConsoleHelperSearchItem}"
                                                        VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ItemDisplay}"
                                                       Foreground="{StaticResource ConAccent}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ItemDisplay}" />
                                        </Grid>

                                        <Border Visibility="{Binding IsItemListOpen, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource ConCode}"
                                                BorderBrush="{StaticResource ConLine}" BorderThickness="1"
                                                CornerRadius="5" Margin="0,4,0,0" MaxHeight="180">
                                            <ListBox ItemsSource="{Binding ItemMatches}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource ConText}"
                                                     SelectionChanged="ItemMatch_SelectionChanged"
                                                     Tag="{Binding}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" Content="on"
                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"
                                              IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                              Foreground="{StaticResource ConText}" VerticalAlignment="Center" />

                                    <ui:TextBox Grid.Column="1"
                                                Visibility="{Binding IsPlainText, Converter={StaticResource BoolToVis}}"
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The resolved command plus its copy button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ConCodeBox}">
                            <TextBox Text="{Binding ResolvedCommand, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ConText}"
                                     FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                        </Border>
                        <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6"
                                   Click="BtnCopyCommand_Click" Tag="{Binding}"
                                   ToolTip="{DynamicResource ConsoleHelperCopy}"
                                   Icon="{ui:SymbolIcon Symbol=Copy24}" />
                    </Grid>

                    <!-- Bind row, only for commands that make sense on a key -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding Bindable, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource ConsoleHelperKey}" Foreground="{StaticResource ConMuted}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

                        <ui:Button Grid.Column="1" MinWidth="72" Padding="8,4"
                                   Click="BtnCaptureKey_Click" Tag="{Binding}"
                                   Content="{Binding BindKeyDisplay}"
                                   ToolTip="{DynamicResource ConsoleHelperKeyHint}" />

                        <Border Grid.Column="2" Style="{StaticResource ConCodeBox}" Margin="6,0,0,0">
                            <TextBox Text="{Binding BindLine, Mode=OneWay}" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ConText}"
                                     FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                        </Border>

                        <ui:Button Grid.Column="3" Margin="6,0,0,0" Padding="8,6"
                                   Click="BtnCopyBind_Click" Tag="{Binding}"
                                   ToolTip="{DynamicResource ConsoleHelperCopyBind}"
                                   Icon="{ui:SymbolIcon Symbol=Copy24}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource ConShell}" CornerRadius="10" BorderBrush="{StaticResource ConLine}" BorderThickness="1">
        <DockPanel>

            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource ConLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="WindowConsole20" FontSize="18" Foreground="{StaticResource ConAccent}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ConsoleHelperTitle}" Foreground="{StaticResource ConText}"
                                   FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{DynamicResource ConsoleHelperSubtitle}" Foreground="{StaticResource ConMuted}"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnCopyAllBinds" Margin="0,0,6,0" Padding="8,6"
                                   Click="BtnCopyAllBinds_Click"
                                   ToolTip="{DynamicResource ConsoleHelperCopyAllBinds}"
                                   Icon="{ui:SymbolIcon Symbol=ClipboardTextLtr24}" />
                        <ui:Button x:Name="BtnPopout" Margin="0,0,6,0" Padding="8,6"
                                   Click="BtnPopout_Click"
                                   ToolTip="{DynamicResource ConsoleHelperPopout}"
                                   Icon="{ui:SymbolIcon Symbol=WindowNew24}" />
                        <ui:Button x:Name="BtnClose" Padding="8,6"
                                   Click="BtnClose_Click"
                                   ToolTip="{DynamicResource Close}"
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search -->
            <Border DockPanel.Dock="Top" Padding="14,10,14,4">
                <ui:TextBox x:Name="TxtSearch" PlaceholderText="{DynamicResource ConsoleHelperSearch}"
                            TextChanged="TxtSearch_TextChanged"
                            Icon="{ui:SymbolIcon Symbol=Search24}" />
            </Border>

            <TabControl x:Name="Tabs" Margin="10,4,10,10" Background="Transparent" BorderThickness="0">
                <TabItem Header="{DynamicResource ConsoleHelperClientTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,8,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ConsoleHelperMostUseful}" Style="{StaticResource ConSectionTitle}"
                                       Visibility="{Binding ElementName=ClientFeatured, Path=HasItems, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl x:Name="ClientFeatured" ItemTemplate="{StaticResource CommandCardTemplate}" />

                            <ItemsControl x:Name="ClientGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource ConSectionTitle}" />
                                            <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource CommandCardTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="ClientEmpty" Text="{DynamicResource ConsoleHelperNoMatch}"
                                       Foreground="{StaticResource ConMuted}" FontStyle="Italic"
                                       Margin="4,20,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource ConsoleHelperAdminTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,8,4,0">
                        <StackPanel>
                            <Border Background="#22FF9C6C" BorderBrush="#55FF9C6C" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource ConsoleHelperAdminNote}"
                                           Foreground="{StaticResource ConText}" FontSize="11" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{DynamicResource ConsoleHelperMostUseful}" Style="{StaticResource ConSectionTitle}"
                                       Visibility="{Binding ElementName=AdminFeatured, Path=HasItems, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl x:Name="AdminFeatured" ItemTemplate="{StaticResource CommandCardTemplate}" />

                            <ItemsControl x:Name="AdminGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource ConSectionTitle}" />
                                            <ItemsControl ItemsSource="{Binding Commands}" ItemTemplate="{StaticResource CommandCardTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="AdminEmpty" Text="{DynamicResource ConsoleHelperNoMatch}"
                                       Foreground="{StaticResource ConMuted}" FontStyle="Italic"
                                       Margin="4,20,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
