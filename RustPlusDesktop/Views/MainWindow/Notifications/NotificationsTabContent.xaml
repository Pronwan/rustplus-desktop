<UserControl
    x:Class="RustPlusDesk.Views.NotificationsTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:RustPlusDesk.Converters"
    xmlns:tutorials="clr-namespace:RustPlusDesk.Features.Tutorials"
    xmlns:services="clr-namespace:RustPlusDesk.Services">

    <!-- ============================================================
         NOTIFICATION CENTER — Fluent (WPF-UI 3.0.5).

         Rebuilt per docs/UI-Review-Fluent-Audit.md §"NotificationsTabContent":
         filter radios off their hand-mixed #3D4B5C onto Fluent tokens, rows onto
         ui:CardControl. Every surface, stroke and text colour now comes from the
         WPF-UI theme brushes App.xaml already maps to the brand palette, so this
         tab follows an accent change or a future light theme instead of staying
         frozen at the thirteen hex literals it used to carry.

         It is laid out for a narrow side panel (~380px and up): search gets its
         own row, the bulk actions are an icon command bar, and each row stacks
         title / message / footer rather than competing for one line.
         ============================================================ -->

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}" tutorials:Tutorial.TargetId="Notifications.Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="Vis" />
            <conv:BoolToVisibilityConverter x:Key="VisInv" Invert="True" />
            <conv:NotNullToBoolConverter x:Key="NotNull" />

            <!-- Filter chip. WPF-UI 3.0.5 has no segmented or chip control, so this
                 is the one template here that has to be written by hand — but it is
                 built from Fluent tokens and follows WinUI's chip states: subtle
                 fill on hover, accent tint plus accent text when selected. Radios
                 rather than toggles because the filter is single-select, which is
                 what a screen reader should hear. -->
            <Style x:Key="FilterChip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTintBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Command-bar button: icon only, the label carried as tooltip and
                 automation name. A 380px panel cannot hold two labelled buttons and
                 a usable search box on one line. -->
            <Style x:Key="CommandBarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Per-row commands stay out of the way until the row is hovered or
                 tabbed into, the way WinUI list rows reveal theirs. Hidden rather
                 than transparent so they keep their space but take no clicks. -->
            <Style x:Key="RowCommandButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:CardControl}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ui:CardControl}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The timestamp and the row commands share one slot at the end of the
                 title line: the commands appear where the timestamp was instead of
                 claiming a band of their own under every row.

                 The trigger sits on a wrapper rather than on the ui:TextBlock: a
                 Style applied straight to ui:TextBlock arrives with its Triggers
                 collection empty (Appearance re-styles the element), so the
                 timestamp would never step aside. -->
            <Style x:Key="RowTimestampSlot" TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:CardControl}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ui:CardControl}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Mute only means anything once we know which server sent it. -->
            <Style x:Key="MuteServerButton" TargetType="ui:Button" BasedOn="{StaticResource RowCommandButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ServerIp, Converter={StaticResource NotNull}}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NotificationServerButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MaxWidth" Value="220" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ServerIp, Converter={StaticResource NotNull}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The type tile: a soft tint of the status colour with the glyph in
                 the full colour, rather than the old 6px bar. Unmatched types fall
                 through to the neutral setters instead of rendering an empty box. -->
            <Style x:Key="TypeTile" TargetType="Border">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{DynamicResource WhiteA14}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Alarm">
                        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Death">
                        <Setter Property="Background" Value="{DynamicResource WarnTintBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Chat">
                        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Pairing">
                        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TypeGlyph" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Symbol" Value="Info24" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="Alarm">
                        <Setter Property="Symbol" Value="Warning24" />
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Death">
                        <Setter Property="Symbol" Value="HeartPulse24" />
                        <Setter Property="Foreground" Value="{DynamicResource WarnOrangeBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Chat">
                        <Setter Property="Symbol" Value="Chat24" />
                        <Setter Property="Foreground" Value="{DynamicResource InfoBlueBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="Pairing">
                        <Setter Property="Symbol" Value="BluetoothConnected24" />
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- ── Command bar ──────────────────────────────────────────────── -->
        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Padding="10,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        tutorials:Tutorial.TargetId="Notifications.Filters">
                        <ui:TextBlock
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            FontTypography="Caption"
                            Text="{DynamicResource NotificationsFilter}" />
                        <RadioButton
                            x:Name="RadAll"
                            Checked="Filter_Changed"
                            Content="{DynamicResource NotificationsAll}"
                            IsChecked="True"
                            Style="{StaticResource FilterChip}" />
                        <RadioButton
                            x:Name="RadAlarms"
                            Checked="Filter_Changed"
                            Content="{DynamicResource NotificationsAlarms}"
                            Style="{StaticResource FilterChip}" />
                        <RadioButton
                            x:Name="RadDeaths"
                            Checked="Filter_Changed"
                            Content="{DynamicResource NotificationsDeaths}"
                            Style="{StaticResource FilterChip}" />
                    </WrapPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        tutorials:Tutorial.TargetId="Notifications.Actions">
                        <ui:Button
                            AutomationProperties.Name="{DynamicResource MarkAllAsRead}"
                            Click="BtnMarkAllRead_Click"
                            Icon="{ui:SymbolIcon Symbol=MailRead24}"
                            Style="{StaticResource CommandBarButton}"
                            ToolTip="{DynamicResource MarkAllAsRead}" />
                        <ui:Button
                            AutomationProperties.Name="{DynamicResource ClearNotifications}"
                            Click="BtnClearHistory_Click"
                            Icon="{ui:SymbolIcon Symbol=Delete24}"
                            Style="{StaticResource CommandBarButton}"
                            ToolTip="{DynamicResource ClearNotifications}" />
                    </StackPanel>
                </Grid>

                <ui:TextBox
                    x:Name="TxtSearch"
                    Height="32"
                    VerticalAlignment="Center"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    PlaceholderText="{DynamicResource SearchNotificationsPlaceholder}"
                    TextChanged="TxtSearch_TextChanged"
                    tutorials:Tutorial.TargetId="Notifications.Search" />
            </StackPanel>
        </Border>

        <!-- ── List / empty state ───────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="8,4,8,8">
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Border
                    Width="72"
                    Height="72"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource WhiteA14}"
                    CornerRadius="36">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Mail24" />
                </Border>
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    FontTypography="Subtitle"
                    Text="{DynamicResource NoNotificationsTitle}" />
                <ui:TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Secondary"
                    FontTypography="Body"
                    Text="{DynamicResource NoNotificationsSubtitle}" />
            </StackPanel>

            <ui:ListView
                x:Name="LstNotifications"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single">

                <!-- The row itself is the ui:CardControl below, so the container
                     contributes nothing but layout — otherwise the Fluent list
                     chrome and the card chrome would both draw a surface. -->
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ui:ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ui:ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:ListView.ItemContainerStyle>

                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- CardControl is a ButtonBase, so the whole row is the
                             click target that marks it read, and hover, pressed and
                             focus visuals come from Fluent instead of triggers. Its
                             Icon and Content slots are left empty: the row needs to
                             stack vertically at panel width, which the Header can
                             do on its own. -->
                        <ui:CardControl
                            Margin="0,0,0,6"
                            Padding="12,10"
                            Click="Notification_Click"
                            Tag="{Binding}">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Unread marker: the WinUI selection pill. -->
                                    <Border
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        Width="3"
                                        Margin="0,2,10,2"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource Accent}"
                                        CornerRadius="1.5"
                                        Visibility="{Binding IsRead, Converter={StaticResource VisInv}}" />

                                    <Border Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource TypeTile}">
                                        <ui:SymbolIcon Style="{StaticResource TypeGlyph}" />
                                    </Border>

                                    <!-- Title, then timestamp or row commands -->
                                    <Grid Grid.Row="0" Grid.Column="2" Margin="10,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="BodyStrong"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />

                                        <!-- MinWidth holds the slot steady so the title
                                             does not shift as the two swap. -->
                                        <Grid
                                            Grid.Column="1"
                                            MinWidth="76"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                            <Grid Style="{StaticResource RowTimestampSlot}">
                                                <ui:TextBlock
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Appearance="Secondary"
                                                    FontTypography="Caption"
                                                    Text="{Binding Timestamp, StringFormat='{}{0:MM/dd HH:mm}'}" />
                                            </Grid>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <ui:Button
                                                    AutomationProperties.Name="{DynamicResource UiMuteNotificationsFromThisServer}"
                                                    Click="BtnMuteServer_Click"
                                                    Style="{StaticResource MuteServerButton}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource UiMuteNotificationsFromThisServer}">
                                                    <ui:SymbolIcon
                                                        FontSize="14"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        Symbol="SpeakerMute24" />
                                                </ui:Button>
                                                <ui:Button
                                                    AutomationProperties.Name="{DynamicResource Delete}"
                                                    Click="BtnDelete_Click"
                                                    Style="{StaticResource RowCommandButton}"
                                                    Tag="{Binding Id}"
                                                    ToolTip="{DynamicResource Delete}">
                                                    <ui:SymbolIcon
                                                        FontSize="14"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Symbol="Delete24" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <ui:TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="10,3,0,0"
                                        Appearance="Secondary"
                                        FontTypography="Caption"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />

                                    <!-- Footer: the server tag, and nothing but — a row
                                         without one collapses instead of leaving a band. -->
                                    <Grid Grid.Row="2" Grid.Column="2">
                                        <ui:Button
                                            Margin="10,6,0,0"
                                            Click="BtnServerTag_Click"
                                            Style="{StaticResource NotificationServerButton}"
                                            Tag="{Binding}">
                                            <Grid>
                                                <ui:TextBlock
                                                    Appearance="Secondary"
                                                    FontTypography="Caption"
                                                    Foreground="{DynamicResource Accent}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding IsStreamerMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisInv}}">
                                                    <ui:TextBlock.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="ServerName" />
                                                            <Binding Path="ServerIp" />
                                                        </PriorityBinding>
                                                    </ui:TextBlock.Text>
                                                </ui:TextBlock>
                                                <ui:TextBlock
                                                    Appearance="Secondary"
                                                    FontTypography="Caption"
                                                    Text="{DynamicResource UiSERVERHIDDEN}"
                                                    Visibility="{Binding IsStreamerMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" />
                                            </Grid>
                                        </ui:Button>
                                    </Grid>
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </Grid>
    </Grid>
</UserControl>
