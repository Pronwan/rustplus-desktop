<UserControl
    x:Class="RustPlusDesk.Views.GeneticsLabTabContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    UseLayoutRounding="True"
    KeyboardNavigation.TabNavigation="Continue">

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Fullscreen Header Bar with Close Button -->
        <Grid Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LeafTwo24" FontSize="22" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Genetics Lab" VerticalAlignment="Center" />
                <TextBlock Margin="10,2,0,0" FontSize="11" Foreground="{DynamicResource TextSubtle}" Text="Rust Plant Genetics &amp; Crossbreeding Calculator" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Click="Reload_Click" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" ToolTip="Reload Genetics Lab" AutomationProperties.Name="Reload Genetics Lab" Margin="0,0,8,0" />
                <ui:Button Appearance="Secondary" Click="Close_Click" Icon="{ui:SymbolIcon Symbol=Dismiss24}" ToolTip="Close Genetics Lab" AutomationProperties.Name="Close Genetics Lab" />
            </StackPanel>
        </Grid>

        <!-- WebView2 Container with border card styling -->
        <Border Grid.Row="1" CornerRadius="10" Background="#121418" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="GeneticsWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Loading / Fallback Overlay -->
                <Border x:Name="LoadingOverlay" Background="#FF121418" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" />
                        <TextBlock Text="Loading Genetics Lab..." FontSize="14" FontWeight="SemiBold" Foreground="#8C96A8" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
