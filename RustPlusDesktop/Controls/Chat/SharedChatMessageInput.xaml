<UserControl x:Class="RustPlusDesk.Controls.Chat.SharedChatMessageInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:RustPlusDesk.Controls.Chat"
             mc:Ignorable="d" 
             d:DesignWidth="400" d:DesignHeight="40">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Message Text Box -->
        <ui:TextBox Grid.Column="0" x:Name="InputTextBox"
                    MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="InputTextBox_KeyDown"
                    VerticalContentAlignment="Center" />

        <!-- Emoji Picker Button -->
        <ui:Button Grid.Column="1" x:Name="BtnEmoji"
                   Appearance="Secondary"
                   Margin="4,0,0,0"
                   Padding="6,4"
                   ToolTip="Insert Emoji or Rust Item"
                   Click="BtnEmoji_Click">
            <TextBlock Text="😊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ui:Button>

        <!-- Send Button -->
        <ui:Button Grid.Column="2" x:Name="BtnSend"
                   Appearance="Primary"
                   Margin="6,0,0,0"
                   Content="{Binding SendButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   IsEnabled="{Binding IsSendEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding ShowSendButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                   Click="BtnSend_Click" />

        <!-- Inline Autocomplete Suggestion Popup (Screenshot 2) -->
        <Popup x:Name="AutocompletePopup"
               PlacementTarget="{Binding ElementName=InputTextBox}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               VerticalOffset="-4">
            <local:ChatEmojiAutocompletePopup x:Name="AutocompleteControl" />
        </Popup>

        <!-- Emoji & Rust Item Picker Popover (Screenshot 1) -->
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=BtnEmoji}"
               Placement="Top"
               HorizontalOffset="-210"
               VerticalOffset="-6"
               StaysOpen="False"
               AllowsTransparency="True">
            <local:ChatEmojiPickerPopup x:Name="PickerControl" />
        </Popup>
    </Grid>
</UserControl>
