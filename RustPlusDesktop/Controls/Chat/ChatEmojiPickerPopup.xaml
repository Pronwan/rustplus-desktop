<UserControl x:Class="RustPlusDesk.Controls.Chat.ChatEmojiPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:RustPlusDesk.Converters"
             xmlns:local="clr-namespace:RustPlusDesk.Controls.Chat"
             mc:Ignorable="d"
             d:DesignHeight="340" d:DesignWidth="260">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </UserControl.Resources>
    <Border Background="#1A1F29" BorderBrush="#2D384D" BorderThickness="1" CornerRadius="8" Padding="10"
            Width="260" MaxHeight="350">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="Black" Opacity="0.65"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search bar -->
                <RowDefinition Height="*"/>    <!-- Unified emoji + item list -->
            </Grid.RowDefinitions>

            <!-- Search Input (one list for everything, so this is the only control up here) -->
            <ui:TextBox x:Name="TxtSearch" Grid.Row="0" Margin="0,0,0,10"
                        PlaceholderText="Search emojis &amp; items..."
                        FontSize="12" Height="32" Padding="6,2"
                        Background="#121620" BorderBrush="#2A354A" Foreground="#FFFFFF"
                        TextChanged="TxtSearch_TextChanged">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="#7E8B9F"/>
                </ui:TextBox.Icon>
            </ui:TextBox>

            <!-- Content: a single searchable list of emojis and Rust items, no categories -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="290">
                <StackPanel>
                    <TextBlock x:Name="EmptyNotice" Visibility="Collapsed" Margin="4,10"
                               Text="No matches" Foreground="#7E8B9F" FontSize="11"
                               HorizontalAlignment="Center"/>

                    <ItemsControl x:Name="EmojiList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="1,2" Padding="6,4" CornerRadius="6" Background="#131722" BorderBrush="#252F42" BorderThickness="1"
                                        Cursor="Hand" MouseLeftButtonDown="ItemRow_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#243248"/>
                                                    <Setter Property="BorderBrush" Value="#3FD7FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon: animated custom emoji, or static Rust item icon -->
                                        <Grid Grid.Column="0" Width="30" Height="30"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:AnimatedEmojiImage EmojiName="{Binding Name}" AutoPlay="True" AnimateOnHover="False"
                                                                      Width="30" Height="30"
                                                                      Visibility="{Binding IsCustomEmoji, Converter={StaticResource BoolToVis}}"
                                                                      RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Image Source="{Binding Icon}" Width="30" Height="30"
                                                   Visibility="{Binding IsCustomEmoji, Converter={StaticResource InverseBoolToVis}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Tag}" Foreground="#E4E9F2" FontSize="11"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#7E8B9F" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
