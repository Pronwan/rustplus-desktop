<UserControl x:Class="RustPlusDesk.Controls.Chat.GlobalChatTicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:chat="clr-namespace:RustPlusDesk.Controls.Chat"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="30">

    <!--
        One line of the room, on every tab.

        The point is not that chat is one click away — it is that it is nought clicks away. You are
        not navigating to it, you are just seeing it, and a line of somebody actually talking
        persuades in a way a badge number cannot.

        Which is also why it must never be blank: a strip that usually shows nothing is a permanent
        advertisement that nobody is talking. When there is no line to show it carries the occupant
        count instead, and when there is no count either it says what the room is.
    -->
    <Border x:Name="Strip"
            Height="30"
            Background="#12161C"
            BorderBrush="#1F2430"
            BorderThickness="0,1,0,0"
            Cursor="Hand"
            MouseLeftButtonUp="Strip_MouseLeftButtonUp">
        <Grid Margin="10,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon Grid.Column="0"
                           Symbol="Comment24"
                           FontSize="13"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Accent}" />

            <!--  Occupant count. Free: the room was always a presence channel.  -->
            <Border x:Name="OnlinePill"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="#1A4CC38A"
                    BorderBrush="#334CC38A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#4CC38A" />
                    <TextBlock x:Name="OnlineText"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#7FDCB0" />
                </StackPanel>
            </Border>

            <!--
                The line itself, rolling.

                Two identical slots inside a clipped host. A new message does not replace the old
                text in place — the old line slides down and out while the new one arrives from
                above, which is what makes an arrival read as an arrival rather than as the strip
                having quietly changed while you were not looking at it.
            -->
            <Grid x:Name="LineHost" Grid.Column="2" ClipToBounds="True" Height="30">
                <chat:GlobalChatTickerLine x:Name="SlotA" />
                <chat:GlobalChatTickerLine x:Name="SlotB" Visibility="Hidden" />
            </Grid>

            <!--  Mentions and replies only. A raw count on a global room reads 247 forever.  -->
            <Border x:Name="UnseenPill"
                    Grid.Column="3"
                    Margin="10,0,2,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="#FF3FD7FF"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <TextBlock x:Name="UnseenText"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="#FF0A0D14" />
            </Border>

            <!--
                Hidden until the pointer is over the strip.

                It turns the strip off for good, which is a lot of finality for a control sitting
                permanently under the cursor's path. Revealing it on hover keeps it reachable
                without leaving it somewhere it can be hit on the way to something else.
            -->
            <ui:Button x:Name="BtnHide"
                       Grid.Column="4"
                       Width="24"
                       Height="24"
                       Padding="0"
                       Opacity="0"
                       IsHitTestVisible="False"
                       Appearance="Transparent"
                       BorderThickness="0"
                       Click="BtnHide_Click"
                       Icon="{ui:SymbolIcon Symbol=ChevronDown24}"
                       ToolTip="{DynamicResource GlobalChatTickerHide}">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Strip}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </Grid>
    </Border>
</UserControl>
